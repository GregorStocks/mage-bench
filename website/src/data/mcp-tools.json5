[
  {
    "name": "get_game_log",
    "description": "Get game log text. Use since_turn for turn-based recap, cursor for incremental updates, or max_chars for recent text.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "max_chars": {
          "type": "integer",
          "description": "Max chars to return (0 or omit for all)",
        },
        "cursor": {
          "type": "integer",
          "description": "Cursor from previous call for incremental updates. Mutually exclusive with since_turn.",
        },
        "since_turn": {
          "type": "integer",
          "description": "Get log from this turn number onward. Mutually exclusive with cursor.",
        },
        "since_player": {
          "type": "string",
          "description": "Player for since_turn filter (defaults to you)",
        }
      },
      "additionalProperties": false,
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "log": {
          "type": "string",
          "description": "Game log text",
        },
        "total_length": {
          "type": "integer",
          "description": "Full log length in chars",
        },
        "truncated": {
          "type": "boolean",
          "description": "Older content was omitted",
        },
        "cursor": {
          "type": "integer",
          "description": "Game log cursor for next call",
        },
        "cursor_reset": {
          "type": "boolean",
          "description": "Cursor was too old and was reset",
          "conditional": "when cursor parameter was used",
        },
        "since_turn": {
          "type": "integer",
          "description": "Turn number the log starts from",
          "conditional": "when since_turn parameter was used",
        },
        "since_player": {
          "type": "string",
          "description": "Player whose turn the log starts from",
          "conditional": "when since_turn parameter was used",
        }
      },
    },
    "examples": [
      {
        "label": "Truncated log",
        "value": "{\n\
  \"log\": \"Alice turn 3:\\nAlice cast Lightning Bolt targeting Bob\",\n\
  \"total_length\": 523,\n\
  \"truncated\": true,\n\
  \"cursor\": 42\n\
}",
      },
      {
        "label": "Cursor delta",
        "value": "{\n\
  \"log\": \"Bob cast Swords to Plowshares targeting Goblin Guide\",\n\
  \"total_length\": 530,\n\
  \"truncated\": false,\n\
  \"cursor\": 45\n\
}",
      },
      {
        "label": "Since turn recap",
        "value": "{\n\
  \"log\": \"Bob turn 2:\\nBob cast Sol Ring\\nAlice turn 3:\\nAlice played Forest\",\n\
  \"total_length\": 540,\n\
  \"truncated\": false,\n\
  \"cursor\": 50,\n\
  \"since_turn\": 2,\n\
  \"since_player\": \"Bob\"\n\
}",
      }
    ],
  },
  {
    "name": "get_game_history",
    "description": "Get structured game history (casts, attacks, life changes) grouped by turn/phase. Use cursor for incremental updates.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "since_turn": {
          "type": "integer",
          "description": "Events from this turn onward",
        },
        "cursor": {
          "type": "integer",
          "description": "Cursor for incremental updates. Mutually exclusive with since_turn.",
        }
      },
      "additionalProperties": false,
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "history": {
          "type": "string",
          "description": "History text grouped by turn/phase",
        },
        "cursor": {
          "type": "integer",
          "description": "Cursor for next call",
        },
        "event_count": {
          "type": "integer",
          "description": "Events in this response",
        }
      },
    },
    "examples": [
      {
        "label": "Full history",
        "value": "{\n\
  \"history\": \"Turn 1 (Alice):\\n  Precombat Main:\\n    - Alice played Mountain\\n    - Alice cast Goblin Guide\\n\\nTurn 1 (Bob):\\n  Precombat Main:\\n    - Bob played Island\\n\",\n\
  \"cursor\": 8,\n\
  \"event_count\": 4\n\
}",
      },
      {
        "label": "Incremental update",
        "value": "{\n\
  \"history\": \"Turn 3 (Alice):\\n  Precombat Main:\\n    - Alice cast Lightning Bolt targeting Bob's Grizzly Bears\\n  Declare Attackers:\\n    - Alice attacked with Goblin Guide\\n\",\n\
  \"cursor\": 24,\n\
  \"event_count\": 2\n\
}",
      },
      {
        "label": "No new events",
        "value": "{\n\
  \"history\": \"No game events recorded yet.\",\n\
  \"cursor\": 24,\n\
  \"event_count\": 0\n\
}",
      }
    ],
  },
  {
    "name": "send_chat_message",
    "description": "Send a chat message to the game",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Message to send",
        }
      },
      "required": [
        "message",
      ],
      "additionalProperties": false,
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether the message was sent",
        },
        "error": {
          "type": "string",
          "description": "Error message when success is false",
        }
      },
    },
    "examples": [
      {
        "label": "Success",
        "value": "{\n\
  \"success\": true\n\
}",
      },
      {
        "label": "Error",
        "value": "{\n\
  \"success\": false,\n\
  \"error\": \"no active game\"\n\
}",
      }
    ],
  },
  {
    "name": "pass_priority",
    "description": "Pass priority. Blocks until you have a pending action (playable cards, combat, or non-priority action like mulligan/targeting). With until: skip to a target step/phase; always stops for combat and non-priority actions. When action_pending=true, includes choices so you can call choose_action immediately.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "until": {
          "type": "string",
          "description": "Skip to a target step/phase. Omit to block until next action.",
          "enum": [
            "upkeep",
            "draw",
            "precombat_main",
            "begin_combat",
            "declare_attackers",
            "declare_blockers",
            "end_combat",
            "postcombat_main",
            "end_of_turn",
            "my_turn",
            "stack_resolved",
          ]
        },
        "board_cursor": {
          "type": "integer",
          "description": "Board cursor from previous result. Omits board when unchanged.",
        }
      },
      "additionalProperties": false,
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "action_pending": {
          "type": "boolean",
          "description": "Whether an action is pending",
        },
        "action_type": {
          "type": "string",
          "description": "XMage callback method name",
        },
        "message": {
          "type": "string",
          "description": "Prompt from XMage",
        },
        "response_type": {
          "type": "string",
          "description": "select, boolean, index, amount, pile, or multi_amount",
          "conditional": "action_pending",
        },
        "respond_with": {
          "type": "string",
          "description": "choose_action parameter(s) to use",
          "conditional": "action_pending",
        },
        "context": {
          "type": "string",
          "description": "Turn/phase context, e.g. T3 PRECOMBAT_MAIN (Player1) YOUR_MAIN",
          "conditional": "action_pending",
        },
        "board": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Board state (players array). Omitted when board_unchanged=true.",
          "conditional": "action_pending",
        },
        "board_cursor": {
          "type": "integer",
          "description": "Pass back to skip unchanged board.",
          "conditional": "action_pending",
        },
        "board_unchanged": {
          "type": "boolean",
          "description": "Board omitted (cursor matched).",
          "conditional": "action_pending",
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Available choices with index and name",
          "conditional": "action_pending",
        },
        "your_hand": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Hand cards (during mulligan)",
          "conditional": "action_pending",
        },
        "combat_phase": {
          "type": "string",
          "description": "declare_attackers or declare_blockers",
        },
        "combat": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Combat groups",
          "conditional": "action_pending",
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Stack (when non-empty)",
          "conditional": "action_pending",
        },
        "untapped_lands": {
          "type": "integer",
          "description": "Untapped land count",
          "conditional": "action_pending",
        },
        "game_seq": {
          "type": "integer",
          "description": "Sequence number",
        },
        "land_drops_used": {
          "type": "integer",
          "description": "Lands played this turn",
          "conditional": "action_pending",
        },
        "already_attacking": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Pre-declared attackers",
          "conditional": "action_pending",
        },
        "incoming_attackers": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Attackers (during declare_blockers)",
          "conditional": "action_pending",
        },
        "required": {
          "type": "boolean",
          "description": "Targeting is required",
          "conditional": "action_pending",
        },
        "can_cancel": {
          "type": "boolean",
          "description": "Targeting can be cancelled",
          "conditional": "action_pending",
        },
        "note": {
          "type": "string",
          "description": "Informational note",
          "conditional": "action_pending",
        },
        "pile1": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Pile 1 contents",
          "conditional": "action_pending",
        },
        "pile2": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Pile 2 contents",
          "conditional": "action_pending",
        },
        "min": {
          "type": "integer",
          "description": "Min allowed value",
          "conditional": "action_pending",
        },
        "max": {
          "type": "integer",
          "description": "Max allowed value",
          "conditional": "action_pending",
        },
        "total_min": {
          "type": "integer",
          "description": "Total min (multi_amount)",
          "conditional": "action_pending",
        },
        "total_max": {
          "type": "integer",
          "description": "Total max (multi_amount)",
          "conditional": "action_pending",
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Per-item details for multi_amount",
          "conditional": "action_pending",
        },
        "error": {
          "type": "string",
          "description": "Error message",
        },
        "player_dead": {
          "type": "boolean",
          "description": "Whether you died",
        },
        "game_over": {
          "type": "boolean",
          "description": "Whether the game ended",
        },
        "recent_chat": {
          "type": "array",
          "items": {
            "type": "string",
          },
          "description": "New chat messages",
        },
        "stop_reason": {
          "type": "string",
          "description": "Why returned: playable_cards, combat, non_priority_action, game_over, reached_step, step_not_reached, stack_resolved, end_of_turn, turn_advanced, cancelled",
        },
        "current_step": {
          "type": "string",
          "description": "Current step (for reached_step/step_not_reached)",
        },
        "action_taken": {
          "type": "string",
          "description": "What was done when an action was auto-resolved",
        },
        "has_playable_cards": {
          "type": "boolean",
          "description": "Whether you have playable cards",
        },
        "warning": {
          "type": "string",
          "description": "Warning message",
        }
      },
    },
    "examples": [
      {
        "label": "Playable cards found",
        "value": "{\n\
  \"action_pending\": true,\n\
  \"action_type\": \"GAME_SELECT\",\n\
  \"has_playable_cards\": true,\n\
  \"stop_reason\": \"playable_cards\",\n\
  \"response_type\": \"select\",\n\
  \"context\": \"T3 PRECOMBAT_MAIN (Player1) YOUR_MAIN\",\n\
  \"board\": [\n\
    {\n\
      \"name\": \"You\",\n\
      \"life\": 20,\n\
      \"is_you\": true\n\
    },\n\
    {\n\
      \"name\": \"Opp\",\n\
      \"life\": 18,\n\
      \"is_you\": false\n\
    }\n\
  ],\n\
  \"board_cursor\": 3,\n\
  \"choices\": [\n\
    {\n\
      \"index\": 0,\n\
      \"name\": \"Lightning Bolt\",\n\
      \"action\": \"cast\",\n\
      \"mana_cost\": \"{R}\"\n\
    },\n\
    {\n\
      \"index\": 1,\n\
      \"name\": \"Mountain\",\n\
      \"action\": \"land\"\n\
    }\n\
  ],\n\
  \"untapped_lands\": 2\n\
}",
      },
      {
        "label": "Board unchanged (cursor matched)",
        "value": "{\n\
  \"action_pending\": true,\n\
  \"action_type\": \"GAME_SELECT\",\n\
  \"has_playable_cards\": true,\n\
  \"stop_reason\": \"playable_cards\",\n\
  \"response_type\": \"select\",\n\
  \"context\": \"T3 PRECOMBAT_MAIN (Player1) YOUR_MAIN\",\n\
  \"board_unchanged\": true,\n\
  \"board_cursor\": 3,\n\
  \"choices\": [\n\
    {\n\
      \"index\": 0,\n\
      \"name\": \"Lightning Bolt\",\n\
      \"action\": \"cast\",\n\
      \"mana_cost\": \"{R}\"\n\
    },\n\
    {\n\
      \"index\": 1,\n\
      \"name\": \"Mountain\",\n\
      \"action\": \"land\"\n\
    }\n\
  ],\n\
  \"untapped_lands\": 2\n\
}",
      },
      {
        "label": "Non-priority action (mulligan)",
        "value": "{\n\
  \"action_pending\": true,\n\
  \"action_type\": \"GAME_ASK\",\n\
  \"stop_reason\": \"non_priority_action\",\n\
  \"response_type\": \"boolean\",\n\
  \"message\": \"Mulligan hand?\",\n\
  \"context\": \"T0 PREGAME\",\n\
  \"board\": [\n\
    {\n\
      \"name\": \"You\",\n\
      \"life\": 20,\n\
      \"is_you\": true\n\
    },\n\
    {\n\
      \"name\": \"Opp\",\n\
      \"life\": 20,\n\
      \"is_you\": false\n\
    }\n\
  ],\n\
  \"board_cursor\": 1,\n\
  \"your_hand\": [\n\
    {\n\
      \"name\": \"Mountain\",\n\
      \"is_land\": true\n\
    },\n\
    {\n\
      \"name\": \"Lightning Bolt\",\n\
      \"mana_cost\": \"{R}\"\n\
    }\n\
  ]\n\
}",
      }
    ],
  },
  {
    "name": "get_game_state",
    "description": "Get full game state: turn, phase, players (life, hand, battlefield, graveyard, exile), stack, combat.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "description": "Cursor from previous call. Returns compact payload if unchanged.",
        }
      },
      "additionalProperties": false,
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "Whether state is available",
        },
        "error": {
          "type": "string",
          "description": "Error message",
        },
        "cursor": {
          "type": "integer",
          "description": "State cursor",
        },
        "unchanged": {
          "type": "boolean",
          "description": "Cursor matched (no changes)",
        },
        "turn": {
          "type": "integer",
          "description": "Turn number",
        },
        "phase": {
          "type": "string",
          "description": "Current phase",
        },
        "step": {
          "type": "string",
          "description": "Current step",
        },
        "active_player": {
          "type": "string",
          "description": "Whose turn it is",
        },
        "priority_player": {
          "type": "string",
          "description": "Who has priority",
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Player objects with life, hand, battlefield, graveyard, exile, mana_pool",
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Stack: name, rules, targets",
        },
        "combat": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Combat groups",
        },
        "game_seq": {
          "type": "integer",
          "description": "Sequence number",
        }
      },
    },
    "examples": [
      {
        "label": "Mid-game state",
        "value": "{\n\
  \"available\": true,\n\
  \"turn\": 4,\n\
  \"phase\": \"PRECOMBAT_MAIN\",\n\
  \"step\": \"PRECOMBAT_MAIN\",\n\
  \"active_player\": \"Player1\",\n\
  \"priority_player\": \"Player1\",\n\
  \"players\": [\n\
    {\n\
      \"name\": \"Player1\",\n\
      \"life\": 18,\n\
      \"library_size\": 49,\n\
      \"hand_size\": 5,\n\
      \"is_active\": true,\n\
      \"is_you\": true,\n\
      \"hand\": [\n\
        {\n\
          \"name\": \"Lightning Bolt\",\n\
          \"mana_cost\": \"{R}\",\n\
          \"playable\": true\n\
        },\n\
        {\n\
          \"name\": \"Mountain\",\n\
          \"is_land\": true,\n\
          \"playable\": true\n\
        }\n\
      ],\n\
      \"battlefield\": [\n\
        {\n\
          \"name\": \"Mountain\",\n\
          \"tapped\": false\n\
        },\n\
        {\n\
          \"name\": \"Goblin Guide\",\n\
          \"tapped\": false,\n\
          \"power\": 2,\n\
          \"toughness\": 2\n\
        }\n\
      ],\n\
      \"mana_pool\": {\n\
        \"R\": 0\n\
      }\n\
    },\n\
    {\n\
      \"name\": \"Player2\",\n\
      \"life\": 20,\n\
      \"library_size\": 52,\n\
      \"hand_size\": 7,\n\
      \"is_active\": false,\n\
      \"is_you\": false,\n\
      \"battlefield\": [\n\
        {\n\
          \"name\": \"Island\",\n\
          \"tapped\": false\n\
        }\n\
      ]\n\
    }\n\
  ],\n\
  \"stack\": []\n\
}",
      }
    ],
  },
  {
    "name": "get_oracle_text",
    "description": "Get oracle text for cards. Use card_name/card_names for lookup by name, or object_id/object_ids for in-game objects.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "card_name": {
          "type": "string",
          "description": "Card name",
        },
        "card_names": {
          "type": "array",
          "items": {
            "type": "string",
          },
          "description": "Card names (batch)",
        },
        "object_id": {
          "type": "string",
          "description": "In-game object ID (e.g. \"p3\")",
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
          },
          "description": "In-game object IDs (batch)",
        }
      },
      "additionalProperties": false,
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether lookup succeeded",
        },
        "name": {
          "type": "string",
          "description": "Card name",
        },
        "mana_cost": {
          "type": "string",
          "description": "Mana cost",
        },
        "type": {
          "type": "string",
          "description": "Type line",
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
          },
          "description": "Oracle text lines",
        },
        "power": {
          "type": "string",
          "description": "Power",
        },
        "toughness": {
          "type": "string",
          "description": "Toughness",
        },
        "starting_loyalty": {
          "type": "string",
          "description": "Starting loyalty",
        },
        "starting_defense": {
          "type": "string",
          "description": "Starting defense",
        },
        "second_face": {
          "type": "object",
          "description": "Back face (transform/MDFC)",
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
          },
          "description": "Card objects (batch mode)",
        },
        "error": {
          "type": "string",
          "description": "Error message",
        }
      },
    },
    "examples": [
      {
        "label": "Single creature",
        "value": "{\n\
  \"success\": true,\n\
  \"name\": \"Snapcaster Mage\",\n\
  \"mana_cost\": \"{1}{U}\",\n\
  \"type\": \"Creature — Human Wizard\",\n\
  \"rules\": [\n\
    \"Flash\",\n\
    \"When Snapcaster Mage enters the battlefield, target instant or sorcery card in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost.\"\n\
  ],\n\
  \"power\": \"2\",\n\
  \"toughness\": \"1\"\n\
}",
      },
      {
        "label": "Transform card with second face",
        "value": "{\n\
  \"success\": true,\n\
  \"name\": \"Delver of Secrets\",\n\
  \"mana_cost\": \"{U}\",\n\
  \"type\": \"Creature — Human Wizard\",\n\
  \"rules\": [\n\
    \"At the beginning of your upkeep, look at the top card of your library. You may reveal that card. If an instant or sorcery card is revealed this way, transform Delver of Secrets.\"\n\
  ],\n\
  \"power\": \"1\",\n\
  \"toughness\": \"1\",\n\
  \"second_face\": {\n\
    \"name\": \"Insectile Aberration\",\n\
    \"type\": \"Creature — Human Insect\",\n\
    \"rules\": [\n\
      \"Flying\"\n\
    ],\n\
    \"power\": \"3\",\n\
    \"toughness\": \"2\"\n\
  }\n\
}",
      },
      {
        "label": "Batch lookup",
        "value": "{\n\
  \"success\": true,\n\
  \"cards\": [\n\
    {\n\
      \"name\": \"Lightning Bolt\",\n\
      \"mana_cost\": \"{R}\",\n\
      \"type\": \"Instant\",\n\
      \"rules\": [\n\
        \"Lightning Bolt deals 3 damage to any target.\"\n\
      ]\n\
    },\n\
    {\n\
      \"name\": \"Counterspell\",\n\
      \"mana_cost\": \"{U}{U}\",\n\
      \"type\": \"Instant\",\n\
      \"rules\": [\n\
        \"Counter target spell.\"\n\
      ]\n\
    }\n\
  ]\n\
}",
      },
      {
        "label": "Not found",
        "value": "{\n\
  \"success\": false,\n\
  \"error\": \"not found\"\n\
}",
      }
    ],
  },
  {
    "name": "get_action_choices",
    "description": "Get choices for the current pending action. With until: blocks like pass_priority until a decision is needed. Without until: returns immediately (action_pending=false if nothing to do).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "until": {
          "type": "string",
          "description": "Skip to a target step/phase, then return choices. Omit to return immediately.",
          "enum": [
            "upkeep",
            "draw",
            "precombat_main",
            "begin_combat",
            "declare_attackers",
            "declare_blockers",
            "end_combat",
            "postcombat_main",
            "end_of_turn",
            "my_turn",
            "stack_resolved",
          ]
        },
        "board_cursor": {
          "type": "integer",
