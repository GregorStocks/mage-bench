      "player": "MiMo Coach",
      "decision_index": 26,
    },
    {
      "severity": "minor",
      "description": "Failed to attack with Benalish Honor Guard (3/2) when the opponent had no untapped creatures to block (Wavebreak Hippocamp is summoning sick). This was 3 free damage with zero risk.",
      "action_taken": "Timed out and did not declare any attackers.",
      "better_line": "Attack with Benalish Honor Guard for 3 unblockable damage, bringing opponent from 16 to 13 life.",
      "type": "blunder",
