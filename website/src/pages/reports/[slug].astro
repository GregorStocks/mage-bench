---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map(report => ({
    params: { slug: report.id },
    props: { report },
  }));
}

const { report } = Astro.props;
const { Content } = await render(report);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function shortModel(model: string): string {
  const slash = model.indexOf('/');
  return slash !== -1 ? model.substring(slash + 1) : model;
}
---

<Base title={report.data.title}>
  <article class="report">
    <header>
      <a href="/reports" class="back-link">&larr; All reports</a>
      <h1>{report.data.title}</h1>
      <div class="meta">
        <time datetime={report.data.pubDate.toISOString()}>
          {formatDate(report.data.pubDate)}
        </time>
        <span class="format-badge">{report.data.format}</span>
        <span class="turns">{report.data.totalTurns} turns</span>
        <a href={`/games/${report.data.gameId}`} class="replay-link">
          Watch replay &rarr;
        </a>
      </div>
      <div class="matchup">
        {report.data.players.map(p => (
          <div class:list={['player-card', { winner: p.name === report.data.winner }]}>
            <span class="player-name">{p.name}</span>
            <span class="player-model">{shortModel(p.model)}</span>
            {p.deck && <span class="player-deck">{p.deck}</span>}
            {p.name === report.data.winner && <span class="winner-badge">WINNER</span>}
          </div>
        ))}
      </div>
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
</Base>

<style>
  .report {
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    color: #a0a0b8;
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #e94560;
  }

  h1 {
    color: #e94560;
    font-size: 1.8rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    color: #a0a0b8;
    margin-bottom: 1rem;
  }

  .format-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.03em;
    background: rgba(233, 69, 96, 0.15);
    color: #e94560;
  }

  .turns {
    color: #a0a0b8;
  }

  .replay-link {
    color: #e94560;
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid #e94560;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .replay-link:hover {
    background: #e94560;
    color: #fff;
  }

  .matchup {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .player-card {
    flex: 1;
    min-width: 10rem;
    padding: 0.75rem 1rem;
    background: #16213e;
    border: 1px solid #0f3460;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .player-card.winner {
    border-color: #a8d9a5;
    box-shadow: inset 3px 0 0 #a8d9a5;
  }

  .player-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #e0e0e0;
  }

  .player-model {
    font-size: 0.8rem;
    color: #a0a0b8;
  }

  .player-deck {
    font-size: 0.8rem;
    color: #a0a0b8;
    font-style: italic;
  }

  .winner-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #0a0a23;
    background: #a8d9a5;
    padding: 0.05rem 0.35rem;
    border-radius: 2px;
    margin-top: 0.2rem;
  }

  .content {
    line-height: 1.8;
    color: #e0e0e0;
  }

  .content :global(h2) {
    color: #e0e0e0;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #0f3460;
    padding-bottom: 0.3rem;
  }

  .content :global(h3) {
    color: #a0a0b8;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
    color: #a0a0b8;
  }

  .content :global(a) {
    color: #e94560;
  }

  .content :global(code) {
    background: #16213e;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.85em;
    color: #e0e0e0;
  }

  .content :global(pre) {
    background: #16213e;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  .content :global(blockquote) {
    border-left: 3px solid #e94560;
    padding-left: 1rem;
    margin: 1rem 0;
    color: #a0a0b8;
    font-style: italic;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    color: #a0a0b8;
  }

  .content :global(li) {
    margin-bottom: 0.3rem;
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 6px;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid #0f3460;
    margin: 2rem 0;
  }
</style>
