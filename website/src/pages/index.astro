---
import Base from '../layouts/Base.astro';
import { loadAllGames } from '../utils/load-games';
import { loadBenchmarkResults, loadLatestCompletedTournament, loadSeasonState } from '../utils/season-data';
import type { TournamentEntrant } from '../utils/season-data';

function assert(condition: unknown, message: string): asserts condition {
  if (!condition) {
    throw new Error(message);
  }
}

type FormatKey = 'standard' | 'modern' | 'legacy' | 'commander' | 'jumpstart';

interface RecentGamePlayer {
  name: string;
  model: string;
}

interface RecentGameCard {
  id: string;
  format: FormatKey;
  formatLabel: string;
  winner: string | null;
  totalTurns: number;
  players: RecentGamePlayer[];
}

const { currentSeason, phase: seasonPhase } = loadSeasonState();
const PHASE_LABELS: Record<string, string> = {
  'regular-season': 'Regular Season',
  tournament: 'Tournament',
  'between-seasons': 'Champion Crowned',
};
const phaseLabel = PHASE_LABELS[seasonPhase] ?? seasonPhase;

const DECK_TYPE_FORMATS: Record<string, FormatKey> = {
  'Constructed - Standard': 'standard',
  'Constructed - Modern': 'modern',
  'Constructed - Legacy': 'legacy',
  'Variant Magic - Freeform Commander': 'commander',
  'Variant Magic - Commander': 'commander',
  Limited: 'jumpstart',
};

const FORMAT_DISPLAY: Record<FormatKey, string> = {
  standard: 'Standard',
  modern: 'Modern',
  legacy: 'Legacy',
  commander: 'Commander (Exhibition)',
  jumpstart: 'Jumpstart',
};

function formatKeyForDeckType(deckType: string): FormatKey {
  const formatKey = DECK_TYPE_FORMATS[deckType];
  assert(formatKey != null, `Unsupported deck type on homepage: ${deckType}`);
  return formatKey;
}

function stripProviderPrefix(model: string | undefined): string {
  if (model == null) {
    return '';
  }

  const slashIndex = model.lastIndexOf('/');
  return slashIndex === -1 ? model : model.slice(slashIndex + 1);
}

const latestCompletedTournament = loadLatestCompletedTournament();
const benchmarkResults = loadBenchmarkResults();

let championSeason: number | null = null;
let champion: TournamentEntrant | null = null;
let runnerUp: TournamentEntrant | null = null;
let champWins = 0;
let runnerUpWins = 0;

if (latestCompletedTournament != null) {
  championSeason = latestCompletedTournament.season;
  const entrantsBySeed = new Map<number, TournamentEntrant>(
    latestCompletedTournament.tournament.entrants.map((entrant) => [entrant.seed, entrant]),
  );

  const finalsRound =
    latestCompletedTournament.tournament.rounds[latestCompletedTournament.tournament.rounds.length - 1];
  assert(finalsRound != null, `Season ${championSeason} tournament is missing a finals round`);
  const finalsMatch = finalsRound.matches[0];
  assert(finalsMatch != null, `Season ${championSeason} tournament finals are missing the championship match`);
  assert(finalsMatch.winner_seed != null, `Season ${championSeason} finals are missing the winner seed`);
  champion = entrantsBySeed.get(finalsMatch.winner_seed) ?? null;
  assert(champion != null, `Season ${championSeason} tournament is missing the recorded champion entrant`);
  const runnerUpSeed =
    finalsMatch.seed_a === finalsMatch.winner_seed ? finalsMatch.seed_b : finalsMatch.seed_a;
  assert(runnerUpSeed != null, `Season ${championSeason} finals are missing the runner-up seed`);
  runnerUp = entrantsBySeed.get(runnerUpSeed) ?? null;
  assert(runnerUp != null, `Season ${championSeason} tournament is missing the finals runner-up entrant`);
  champWins = finalsMatch.games.filter((game) => game.winner_seed === finalsMatch.winner_seed).length;
  runnerUpWins = finalsMatch.games.filter((game) => game.winner_seed === runnerUpSeed).length;
}

const championBanner =
  championSeason != null && champion != null && runnerUp != null
    ? {
        season: championSeason,
        champion,
        runnerUp,
        champWins,
        runnerUpWins,
      }
    : null;

// Stats
const formats = benchmarkResults.formats;
const top5 = benchmarkResults.models.slice(0, 5);
const totalGames = benchmarkResults.totalGames;

const allModelIds = new Set<string>();
for (const format of Object.values(formats)) {
  for (const model of format.models) {
    allModelIds.add(model.modelId);
  }
}
const totalModels = allModelIds.size;
const formatCount = Object.entries(formats).filter(([format, data]) => format !== 'combined' && data.totalGames > 0).length;

// Recent games — 3 most recent 1v1 and 3 most recent commander
const recentDuels: RecentGameCard[] = [];
const recentCommander: RecentGameCard[] = [];
for (const game of loadAllGames()) {
  if (recentDuels.length >= 3 && recentCommander.length >= 3) {
    break;
  }

  const format = formatKeyForDeckType(game.deckType);
  const entry: RecentGameCard = {
    id: game.id,
    format,
    formatLabel: FORMAT_DISPLAY[format],
    winner: game.winner,
    totalTurns: game.totalTurns,
    players: game.players.map((player) => ({
      name: player.name,
      model: stripProviderPrefix(player.model),
    })),
  };

  if (format === 'commander') {
    if (recentCommander.length < 3) {
      recentCommander.push(entry);
    }
    continue;
  }

  if (recentDuels.length < 3) {
    recentDuels.push(entry);
  }
}
---

<Base title="Home">
  <section class="hero">
    <h1>mage-bench</h1>

  <section class="intro">
    <p>
    <a href="/docs/about">mage-bench</a> is a benchmark where LLMs play Magic: The Gathering against each other.
    </p>
  </section>

    {championBanner == null && (
      <a href={`/season/${currentSeason}`} class="season-status" data-phase={seasonPhase}>
        <span class="season-status-label">Season {currentSeason}</span>
        <span class="season-status-separator"></span>
        <span class="season-status-phase">{phaseLabel}</span>
      </a>
    )}
  </section>

  {championBanner != null && (
    <a href={`/season/${championBanner.season}/results`} class="champ-banner">
      <span class="champ-eyebrow">Season {championBanner.season} Champion</span>
      <span class="champ-name">{championBanner.champion.display_name}</span>
      <span class="champ-finals">
        Finals: def. {championBanner.runnerUp.display_name} ({championBanner.champWins}–{championBanner.runnerUpWins})
      </span>
      <span class="champ-cta">View full bracket &rarr;</span>
    </a>
  )}

  <section class="stats-strip">
    <p class="stats-qualifier">Season {currentSeason}</p>
    <div class="stats-cards">
      <div class="stat-card">
        <span class="stat-number">{totalGames}</span>
        <span class="stat-label">Games Played</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{totalModels}</span>
        <span class="stat-label">Models Tested</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{formatCount}</span>
        <span class="stat-label">Formats</span>
      </div>
    </div>
  </section>

  {top5.length > 0 && (
    <section class="leaderboard-preview">
      <h2>Season {currentSeason} ELO <a href={`/season/${currentSeason}/rankings`} class="section-link">Full leaderboard &rarr;</a></h2>
      <div class="mini-leaderboard">
        {top5.map((model, i) => (
          <div class:list={['mini-row', { 'mini-gold': i === 0, 'mini-silver': i === 1, 'mini-bronze': i === 2 }]}>
            <span class="mini-rank">{i + 1}</span>
            <div class="mini-info">
              <span class="mini-name">{model.modelName}</span>
              <span class="mini-provider">{model.provider}</span>
            </div>
            <span class="mini-rating">{model.rating}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {recentDuels.length > 0 && (
    <section class="recent-games">
      <h2>Recent Duels <a href="/games" class="section-link">All duels &rarr;</a></h2>
      <div class="game-strip">
        {recentDuels.map((game) => (
          <a href={`/games/${game.id}`} class="mini-game-card" data-format={game.format}>
            <div class="mgc-header">
              <span class={`mgc-format mgc-format-${game.format}`}>{game.formatLabel}</span>
              <span class="mgc-turns">{game.totalTurns} turns</span>
            </div>
            <div class="mgc-players">
              {game.players.map((player) => (
                <div class:list={['mgc-player', { 'mgc-winner': player.name === game.winner }]}>
                  <span class="mgc-pname">{player.name}</span>
                  {player.name === game.winner && <span class="mgc-winner-label">WINNER</span>}
                </div>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {recentCommander.length > 0 && (
    <section class="recent-games">
      <h2>Recent Commander Games <a href="/games?format=commander" class="section-link">All Commander games &rarr;</a></h2>
      <div class="game-strip">
        {recentCommander.map((game) => (
          <a href={`/games/${game.id}`} class="mini-game-card" data-format={game.format}>
            <div class="mgc-header">
              <span class={`mgc-format mgc-format-${game.format}`}>{game.formatLabel}</span>
              <span class="mgc-turns">{game.totalTurns} turns</span>
            </div>
            <div class="mgc-players">
              {game.players.map((player) => (
                <div class:list={['mgc-player', { 'mgc-winner': player.name === game.winner }]}>
                  <span class="mgc-pname">{player.name}</span>
                  {player.name === game.winner && <span class="mgc-winner-label">WINNER</span>}
                </div>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0 1.5rem;
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .tagline {
    font-size: 1.35rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    font-weight: 500;
  }

  .season-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(var(--accent-primary-rgb), 0.08);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.25);
    border-radius: 100px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .season-status:hover {
    border-color: var(--accent-primary);
  }

  .season-status[data-phase="tournament"] {
    background: rgba(233, 69, 96, 0.08);
    border-color: rgba(233, 69, 96, 0.25);
  }

  .season-status[data-phase="between-seasons"] {
    background: rgba(255, 215, 0, 0.08);
    border-color: rgba(255, 215, 0, 0.3);
  }

  .season-status-label {
    color: var(--accent-primary);
  }

  .season-status[data-phase="tournament"] .season-status-label {
    color: var(--accent-primary);
  }

  .season-status-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-secondary);
    opacity: 0.5;
  }

  .season-status-phase {
    color: var(--text-secondary);
  }

  .season-status[data-phase="tournament"] .season-status-phase {
    color: var(--accent-primary);
  }

  .season-status[data-phase="between-seasons"] .season-status-phase {
    color: #f6c453;
  }

  /* Championship banner */
  .champ-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    position: relative;
    max-width: 32rem;
    margin: 2rem auto 2.5rem;
    padding: 2rem 2rem 1.6rem;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 215, 0, 0.06) 0%, transparent 70%),
      var(--bg-surface);
    border: 1px solid rgba(255, 215, 0, 0.18);
    border-radius: 12px;
    text-decoration: none;
    text-align: center;
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
  }

  .champ-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      #ffd700 30%,
      #fff8dc 50%,
      #ffd700 70%,
      transparent
    );
    border-radius: 2px;
  }

  .champ-banner:hover {
    border-color: rgba(255, 215, 0, 0.45);
    transform: translateY(-2px);
  }

  .champ-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #ffd700;
  }

  .champ-name {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0.15rem 0;
  }

  .champ-finals {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .champ-cta {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .champ-banner:hover .champ-cta {
    color: #ffd700;
  }

  @media (max-width: 600px) {
    .champ-banner {
      margin: 1.5rem 0 2rem;
      padding: 1.5rem 1.2rem 1.2rem;
    }

    .champ-name {
      font-size: 1.25rem;
    }
  }

  .intro {
    font-size: 1.05rem;
    line-height: 1.75;
    text-align: center;
    max-width: 48rem;
    margin: 0 auto;
    color: var(--text-primary);
  }

  .intro p {
    margin-bottom: 1rem;
  }

  .intro a {
    color: var(--accent-primary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 0;
  }

  .links a {
    padding: 0.7rem 1.5rem;
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    transition: border-color 0.15s, background 0.15s;
  }

  .links a:hover {
    border-color: var(--accent-primary);
    background: rgba(var(--accent-primary-rgb), 0.1);
  }

  /* Stats strip */
  .stats-strip {
    padding: 1.5rem 0 2.5rem;
    text-align: center;
  }

  .stats-qualifier {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .stats-cards {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .stat-card {
    text-align: center;
    padding: 1.2rem 2rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    min-width: 140px;
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Leaderboard preview */
  .leaderboard-preview {
    padding: 0 0 2.5rem;
  }

  .leaderboard-preview h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    letter-spacing: -0.01em;
  }

  .section-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    margin-left: auto;
  }

  .section-link:hover {
    color: var(--text-primary);
  }

  .mini-leaderboard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mini-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 6px;
    transition: border-color 0.2s;
  }

  .mini-row:hover {
    border-color: var(--accent-primary);
  }

  .mini-gold {
    border-left: 3px solid #ffd700;
    background: linear-gradient(to right, rgba(255, 215, 0, 0.06), var(--bg-surface) 40%);
  }

  .mini-silver {
    border-left: 3px solid #c0c0c0;
    background: linear-gradient(to right, rgba(192, 192, 192, 0.04), var(--bg-surface) 40%);
  }

  .mini-bronze {
    border-left: 3px solid #cd7f32;
    background: linear-gradient(to right, rgba(205, 127, 50, 0.04), var(--bg-surface) 40%);
  }

  .mini-rank {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-muted);
    min-width: 1.5rem;
    text-align: center;
  }

  .mini-gold .mini-rank { color: #ffd700; }
  .mini-silver .mini-rank { color: #c0c0c0; }
  .mini-bronze .mini-rank { color: #cd7f32; }

  .mini-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .mini-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .mini-provider {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .mini-rating {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  /* Recent games */
  .recent-games {
    padding: 0 0 2rem;
  }

  .recent-games h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    letter-spacing: -0.01em;
  }

  .game-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .mini-game-card {
    display: block;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .mini-game-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .mini-game-card[data-format="standard"] { border-left: 3px solid var(--format-standard); }
  .mini-game-card[data-format="modern"] { border-left: 3px solid var(--format-modern); }
  .mini-game-card[data-format="legacy"] { border-left: 3px solid var(--format-legacy); }
  .mini-game-card[data-format="commander"] { border-left: 3px solid var(--format-commander); }
  .mini-game-card[data-format="jumpstart"] { border-left: 3px solid var(--format-jumpstart); }

  .mgc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.85rem;
  }

  .mgc-format {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .mgc-format-standard { background: rgba(76, 175, 80, 0.15); color: var(--format-standard); }
  .mgc-format-modern { background: rgba(33, 150, 243, 0.15); color: var(--format-modern); }
  .mgc-format-legacy { background: rgba(156, 39, 176, 0.15); color: var(--format-legacy); }
  .mgc-format-commander { background: rgba(255, 152, 0, 0.15); color: var(--format-commander); }
  .mgc-format-jumpstart { background: rgba(233, 69, 96, 0.15); color: var(--format-jumpstart); }

  .mgc-turns {
    color: var(--text-secondary);
  }

  .mgc-players {
    padding: 0.5rem 0.75rem;
  }

  .mgc-player {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0;
    font-size: 0.9rem;
  }

  .mgc-winner {
    font-weight: 700;
  }

  .mgc-pname {
    color: var(--text-primary);
  }

  .mgc-winner .mgc-pname {
    color: var(--color-success);
  }

  .mgc-winner-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--bg-base);
    background: var(--color-success);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    margin-left: auto;
  }

  @media (max-width: 600px) {
    .stats-cards {
      gap: 0.75rem;
    }

    .stat-card {
      min-width: auto;
      flex: 1;
      padding: 0.8rem 0.5rem;
    }

    .stat-number {
      font-size: 1.6rem;
    }

    .game-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
