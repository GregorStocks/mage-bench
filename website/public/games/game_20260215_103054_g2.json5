    },
    {
      "severity": "major",
      "description": "Missed lethal by not playing Fire Nation Palace before combat. Fire Nation Palace enters untapped (controls basic Mountains), providing {R} to cast Full Bore on Slickshot Show-Off during combat. Slickshot would get +2/+0 from noncreature trigger and +3/+2 from Full Bore, becoming 6/4 flying. Combined with 2 Stadium Headliners (2 damage) and 2 Mobilize tokens (2 damage), that's 10 total damage against opponent's 8 life — lethal.",
      "action_taken": "Attacked with all creatures without playing Fire Nation Palace first, dealing only 5 damage.",
      "better_line": "Play Fire Nation Palace (enters untapped), then attack with all creatures, then cast Full Bore targeting Slickshot Show-Off for lethal damage (6 + 2 + 2 = 10 vs 8 life).",
      "type": "blunder",
      "snapshot_index": 62,
      "player": "GLM47 Stoic",
      "decision_index": 44,
    }
  ],
