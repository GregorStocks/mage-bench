  "annotations": [
    {
      "severity": "minor",
      "description": "Passed the turn with 2 untapped mana and Jousting Lance castable for {2}. No creatures on board yet, but deploying the equipment now costs nothing in tempo since the mana would go unused, and gets it ready for when Skyhunter Prowler arrives next turn.",
      "action_taken": "Passed priority, wasting 2 mana and ending the turn.",
      "better_line": "Cast Jousting Lance for {2} to deploy it to the battlefield, so it's ready to equip once creatures are played in subsequent turns.",
      "type": "blunder",
      "snapshot_index": 25,
      "player": "Grk41F Heckler",
      "decision_index": 10,
    },
    {
      "severity": "questionable",
      "description": "Fanatical Firebrand could attack for 1 unblocked damage against an empty board. Not attacking preserves the tap-sacrifice ping ability as a deterrent, but opponent only has 1 untapped Plains and limited options to play a relevant 1-toughness creature.",
      "action_taken": "Did not attack with Fanatical Firebrand (timed out/no response)",
      "better_line": "Attack with Fanatical Firebrand for 1 free damage. The chance opponent plays a 1-toughness creature needing an immediate ping before your next untap is low with only 1 available Plains.",
      "type": "blunder",
      "snapshot_index": 35,
      "player": "Opus Sport",
      "decision_index": 13,
    },
    {
      "severity": "minor",
      "description": "Fanatical Firebrand could attack for 1 unblocked damage since the opponent's only creature (Skyhunter Prowler) is summoning sick and can't block. There are no untapped creatures on the opponent's side at all. This is free damage with no downside - the Firebrand can still be sacrificed on the opponent's turn if needed.",
      "action_taken": "Timed out and did not attack with Fanatical Firebrand.",
      "better_line": "Attack with Fanatical Firebrand for 1 unblocked damage.",
      "type": "blunder",
      "snapshot_index": 67,
      "player": "Opus Sport",
      "decision_index": 22,
    },
    {
      "severity": "minor",
      "description": "Failed to block Fanatical Firebrand 1/1 with Skyhunter Prowler 1/3 (due to timeout). The Prowler would have killed the Firebrand for free while surviving, removing both a 1/1 attacker and its sacrifice-ping ability. Not blocking takes 1 unnecessary damage and leaves the Firebrand alive.",
