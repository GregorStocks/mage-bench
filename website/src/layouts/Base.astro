---
import seasonData from '../data/season.json';
import benchmarkData from '../data/benchmark-results.json';

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide } = Astro.props;
const currentPath = Astro.url.pathname;
const currentSeason = (seasonData as any).current_season;
const availableSeasons: number[] = (benchmarkData as any).availableSeasons ?? [currentSeason];

const docsLinks = [
  { href: '/scoring', label: 'Scoring' },
  { href: '/internals', label: 'Internals' },
];

const navLinks = [
  { href: '/', label: 'Home' },
  ...[...availableSeasons].reverse().map(s => ({
    href: `/season/${s}`,
    label: `Season ${s}`,
  })),
  { href: '/blog', label: 'Blog' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title} | mage-bench</title>
  </head>
  <body>
    <nav>
      <a class="site-title" href="/">mage-bench</a>
      <ul>
        {navLinks.map((link, i) => (
          <Fragment>
            <li>
              <a href={link.href} class:list={[{ active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}>
                {link.label}
              </a>
            </li>
            {i === navLinks.length - 2 && (
              <li class="nav-dropdown">
                <span class:list={['nav-dropdown-trigger', { active: docsLinks.some(l => currentPath === l.href || currentPath.startsWith(l.href)) }]}>Docs</span>
                <ul class="nav-dropdown-menu">
                  {docsLinks.map(link => (
                    <li>
                      <a href={link.href} class:list={[{ active: currentPath === link.href || currentPath.startsWith(link.href) }]}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            )}
          </Fragment>
        ))}
      </ul>
    </nav>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer>
      <div class="footer-links">
        <a href="https://github.com/GregorStocks/mage-bench">GitHub</a>
        <a href="/contact">Contact</a>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --bg-base: #0c0c0f;
    --bg-surface: #17171c;
    --bg-elevated: #232329;
    --bg-deep: #060608;
    --border-default: #2e2e38;
    --border-subtle: rgba(46, 46, 56, 0.6);
    --text-primary: #f0f0f2;
    --text-secondary: #9e9eab;
    --text-muted: #6b6b78;
    --accent-primary: #e94560;
    --accent-primary-rgb: 233, 69, 96;
    --accent-secondary: #e94560;
    --accent-secondary-rgb: 233, 69, 96;
    --color-success: #5ddb6a;
    --color-warning: #fbbf24;
    --color-danger: #ef4444;
    --format-standard: #5ddb6a;
    --format-modern: #42a5f5;
    --format-legacy: #c57bdb;
    --format-commander: #ffa726;
    --format-jumpstart: #e94560;
    --font-heading: 'Plus Jakarta Sans', system-ui, sans-serif;
    --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    --font-prose: 'Crimson Pro', 'Georgia', serif;
  }

  :global(*, *::before, *::after) {
    box-sizing: border-box;
    margin: 0;
  }

  :global(body) {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-primary);
    background: var(--bg-base);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }


  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding: 0.85rem 2rem;
    background: rgba(12, 12, 15, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-default);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  nav > ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: 0.5rem 1.5rem;
    padding: 0;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
    position: relative;
    font-weight: 600;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text-primary);
  }

  nav a.active {
    color: var(--text-primary);
  }

  nav a.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-primary);
    border-radius: 1px;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    color: var(--text-secondary);
    cursor: default;
    font-weight: 600;
    font-size: 0.95rem;
    position: relative;
    transition: color 0.15s;
  }

  .nav-dropdown:hover .nav-dropdown-trigger,
  .nav-dropdown-trigger.active {
    color: var(--text-primary);
  }

  .nav-dropdown-trigger.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-primary);
    border-radius: 1px;
  }

  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: -0.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 0.4rem 0;
    margin-top: 0;
    padding-top: calc(0.4rem + 8px);
    min-width: 140px;
    z-index: 200;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    flex-direction: column;
    gap: 0;
  }

  .nav-dropdown:hover .nav-dropdown-menu {
    display: flex;
  }

  .nav-dropdown-menu li {
    list-style: none;
  }

  .nav-dropdown-menu a {
    display: block;
    padding: 0.45rem 1rem;
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .nav-dropdown-menu a:hover {
    background: rgba(var(--accent-primary-rgb), 0.1);
  }

  main {
    flex: 1;
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem;
    width: 100%;
  }

  main.wide {
    max-width: none;
  }

  footer {
    text-align: center;
    padding: 3rem 2rem 2rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-default);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  footer a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s;
  }

  footer a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 600px) {
    nav {
      position: relative;
    }
  }
</style>
