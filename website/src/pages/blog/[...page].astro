---
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import { getSortedPosts, slugifyTag } from '../../utils/blog';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = getSortedPosts(await getCollection('blog'));
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title="Blog">
  <h1>Blog</h1>
  <p class="subtitle">Project updates and technical deep-dives.</p>

  <div class="post-list">
    {page.data.map((post: any) => (
      <a href={`/blog/${post.id}`} class="post-card">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="post-author">{post.data.author}</span>
        </div>
        <h2 class="post-title">{post.data.title}</h2>
        <p class="post-desc">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </a>
    ))}
  </div>

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
  />
</Base>

<style>
  h1 {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 0.35rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-family: var(--font-prose);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-default);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: block;
    padding: 1.75rem 0;
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.15s;
  }

  .post-card:hover {
    background: rgba(255, 255, 255, 0.02);
    margin: 0 -1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    border-radius: 6px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-family: var(--font-body);
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-author::before {
    content: '\00b7';
    margin-right: 0.5rem;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .post-desc {
    font-family: var(--font-prose);
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.7rem;
    font-family: var(--font-body);
    padding: 0.15rem 0.5rem;
    background: rgba(233, 69, 96, 0.08);
    border: 1px solid rgba(233, 69, 96, 0.2);
    border-radius: 3px;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
