      "result": "{\"hand_size\":7,\"action_type\":\"GAME_ASK\",\"players\":\"DSV3 Tactic(40hp), GPT5n ESPN(40hp), Gem25F Teach(you,40hp), KimiK2 Detect(40hp)\",\"land_count\":3,\"context\":\"T1 ()\",\"response_type\":\"boolean\",\"respond_with\":\"answer\\u003dtrue or answer\\u003dfalse\",\"message\":\"Mulligan for free, draw another 7 cards?\",\"your_hand\":[{\"name\":\"Island\",\"is_land\":true},{\"name\":\"Spinerock Knoll\",\"is_land\":true},{\"name\":\"Swiftwater Cliffs\",\"is_land\":true},{\"mana_cost\":\"{3}{R}\",\"name\":\"Awaken the Sky Tyrant\"},{\"mana_cost\":\"{3}{U}\",\"name\":\"Mystic Retrieval\"},{\"mana_cost\":\"{5}{R}{R}\",\"name\":\"Dragon Mage\",\"power\":\"5\",\"toughness\":\"5\"},{\"mana_cost\":\"{5}\",\"name\":\"Psychosis Crawler\",\"power\":\"0\",\"toughness\":\"0\"}],\"action_pending\":true}",
