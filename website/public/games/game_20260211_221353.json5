      "result": "{\"cards\":[{\"name\":\"Momo, Friendly Flier\",\"rules\":[\"Flying\",\"The first non-Lemur creature spell with flying you cast during each of your turns costs {1} less to cast.\",\"Whenever another creature you control with flying enters, {this} gets +1/+1 until end of turn.\"]},{\"name\":\"Sarkhan, Dragon Ascendant\",\"rules\":[\"When {this} enters, you may pay behold a Dragon. If you do, create a Treasure token.\",\"Whenever a Dragon you control enters, put a +1/+1 counter on {this}. Until end of turn, {this} becomes a Dragon in addition to its other types and gains flying.\"]},{\"name\":\"Slickshot Show-Off\",\"rules\":[\"Flying\",\"Haste\",\"Whenever you cast a noncreature spell, {this} gets +2/+0 until end of turn.\",\"Plot {1}{R}\"]}],\"success\":true}",
