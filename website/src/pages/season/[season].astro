  }

  .pick-options {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* --- Bracket --- */
  .bracket-section {
    margin-bottom: 2rem;
  }

  .bracket-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 1rem;
  }

  .bracket-two-sided {
    display: flex;
    align-items: stretch;
    min-height: var(--bracket-half-height, 220px);
  }

  .bracket-half {
    display: flex;
    align-items: stretch;
    flex: 1;
  }

  .bracket-half-left {
    justify-content: flex-end;
  }

  .bracket-half-right {
    justify-content: flex-start;
  }

  .bracket-center {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  .bracket-round {
    flex-shrink: 0;
    min-width: 170px;
  }

  .bracket-finals {
    min-width: 190px;
  }

  .round-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 0 0.5rem 0.5rem;
    text-align: center;
  }

  .round-matches {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    height: calc(100% - 1.5rem);
  }

  .bracket-match-wrap {
    padding: 0 0.5rem;
  }

  .bracket-match {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
