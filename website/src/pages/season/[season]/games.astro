---
import Base from '../../../layouts/Base.astro';
import GameListView from '../../../components/GameListView.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import { loadAllGames } from '../../../utils/load-games';
import {
  hasDraft as seasonHasDraft,
  hasTournament as seasonHasTournament,
  loadAvailableSeasons,
  loadBenchmarkResults,
} from '../../../utils/season-data';

const minBlunderVersion = loadBenchmarkResults().minBlunderVersion;

export function getStaticPaths() {
  return loadAvailableSeasons().map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

// Regular-season games for this season
const games = loadAllGames().filter(g => g.season === seasonNum && !g.tournament);

// Check for tournament existence for SeasonNav props
const hasTournament = seasonHasTournament(seasonNum);
const hasDraft = seasonHasDraft(seasonNum);
---

<Base title={`Season ${seasonNum} - Regular Season Games`} wide>
  <SeasonNav season={seasonNum} active="games" hasTournament={hasTournament} hasDraft={hasDraft} />
  <div class="games-content">
    <GameListView
      games={games}
      minBlunderVersion={minBlunderVersion}
      showSeasonFilter={false}
      showSeasonBadge={false}
    />
  </div>
</Base>

<style>
  .games-content {
    max-width: 52rem;
  }
</style>
