    "examples": [
      {
        "label": "Select (play cards)",
        "value": "{\n\
  \"action_pending\": true,\n\
  \"action_type\": \"GAME_SELECT\",\n\
  \"message\": \"Select card to play or pass priority\",\n\
  \"response_type\": \"select\",\n\
  \"context\": \"T3 PRECOMBAT_MAIN (Player1) YOUR_MAIN\",\n\
  \"board\": [\n\
    {\n\
      \"name\": \"Player1\",\n\
      \"life\": 20,\n\
      \"is_you\": true,\n\
      \"is_active\": true,\n\
      \"library_size\": 49,\n\
      \"hand_size\": 5,\n\
      \"hand\": [\n\
        {\n\
          \"name\": \"Lightning Bolt\",\n\
          \"mana_cost\": \"{R}\",\n\
          \"rules\": [\n\
            \"Lightning Bolt deals 3 damage to any target.\"\n\
          ],\n\
          \"playable\": true\n\
        },\n\
        {\n\
          \"name\": \"Mountain\",\n\
          \"is_land\": true,\n\
          \"rules\": [\n\
            \"{T}: Add {R}.\"\n\
          ],\n\
          \"playable\": true\n\
        }\n\
      ],\n\
      \"battlefield\": [\n\
        {\n\
          \"name\": \"Mountain\",\n\
          \"tapped\": false,\n\
          \"rules\": [\n\
            \"{T}: Add {R}.\"\n\
          ],\n\
          \"id\": \"p1\"\n\
        },\n\
        {\n\
          \"name\": \"Goblin Guide\",\n\
          \"tapped\": false,\n\
          \"power\": 2,\n\
          \"toughness\": 2,\n\
          \"rules\": [\n\
            \"Haste\",\n\
            \"Whenever Goblin Guide attacks, defending player reveals the top card of their library. If it's a land card, that player puts it into their hand.\"\n\
          ],\n\
          \"id\": \"p2\"\n\
        }\n\
      ]\n\
    },\n\
    {\n\
      \"name\": \"Player2\",\n\
      \"life\": 20,\n\
      \"is_you\": false,\n\
      \"is_active\": false,\n\
      \"library_size\": 52,\n\
      \"hand_size\": 7,\n\
      \"battlefield\": [\n\
        {\n\
          \"name\": \"Island\",\n\
          \"tapped\": false,\n\
          \"rules\": [\n\
            \"{T}: Add {U}.\"\n\
          ],\n\
          \"id\": \"p3\"\n\
        }\n\
      ]\n\
    }\n\
  ],\n\
  \"board_cursor\": 5,\n\
  \"choices\": [\n\
    {\n\
      \"index\": 0,\n\
      \"name\": \"Lightning Bolt\",\n\
      \"action\": \"cast\",\n\
      \"mana_cost\": \"{R}\"\n\
    },\n\
    {\n\
      \"index\": 1,\n\
      \"name\": \"Mountain\",\n\
      \"action\": \"land\"\n\
    }\n\
  ],\n\
  \"untapped_lands\": 2\n\
}",
      },
      {
