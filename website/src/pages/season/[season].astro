    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    font-size: 0.8rem;
  }

  .bracket-slot + .bracket-slot {
    border-top: 1px solid var(--border-default);
  }

  .bracket-slot.winner {
    background: rgba(168, 217, 165, 0.08);
  }

  .bracket-seed-num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-muted);
    min-width: 1.5rem;
