---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSortedPosts } from '../../utils/blog';
import '../../styles/prose.css';
import '../../styles/shared.css';

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection('blog'));
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={post.data.title}>
  <article class="page-shell page-shell--article">
    <header>
      <a href="/blog" class="back-link blog-back-link">&larr; All posts</a>
      <h1 class="page-title blog-post-title">{post.data.title}</h1>
      <div class="page-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span class="author">by {post.data.author}</span>
        {post.data.updatedDate && (
          <span class="updated">
            (updated {formatDate(post.data.updatedDate)})
          </span>
        )}
      </div>
    </header>
    <div class="content prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .blog-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    margin-bottom: 2.5rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .blog-post-title {
    font-size: 2.4rem;
    margin-bottom: 1rem;
  }

  .updated {
    font-style: italic;
    color: var(--text-muted);
  }

  /* Blog prose overrides (slightly larger than default) */
  .content {
    font-size: 1.2rem;
    line-height: 1.85;
  }

  .content :global(p) {
    margin-bottom: 1.35rem;
  }

  @media (max-width: 600px) {
    .blog-post-title {
      font-size: 1.75rem;
    }

    .content {
      font-size: 1.1rem;
    }
  }
</style>
