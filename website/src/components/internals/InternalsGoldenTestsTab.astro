---
import type { GoldenTestScenario } from '../../utils/internals-types';

interface Props {
  scenarios: GoldenTestScenario[];
}

const { scenarios } = Astro.props as Props;
---

<div class="tab-content" id="tab-golden">
  <p class="subtitle">Board states from golden prompt tests. Click a scenario to view the full game replay.</p>
  {scenarios.length === 0 && <p>No golden scenarios found. Run <code>make regen-golden</code> to generate fixtures.</p>}
  <div class="scenario-list">
    {scenarios.map((scenario) => (
      <a class="scenario-card" href={`/golden/${scenario.name}`}>
        <div class="scenario-name">{scenario.name.replace(/_/g, ' ')}</div>
        <div class="scenario-meta">
          {scenario.snapshots} snapshots &middot; {scenario.turns} turns
        </div>
      </a>
    ))}
  </div>
</div>
