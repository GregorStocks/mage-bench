      "result": "{\"land_drops_used\":0,\"action_type\":\"GAME_SELECT\",\"players\":\"GPT4om Analyst(19hp), Gem25P Vorthos(you,20hp)\",\"context\":\"T1 Precombat Main/Precombat Main (Gem25P Vorthos) YOUR_MAIN\",\"response_type\":\"select\",\"untapped_lands\":1,\"message\":\"Play spells and abilities\",\"choices\":[{\"mana_cost\":\"{1}\",\"name\":\"Shadowspear\",\"index\":0,\"action\":\"cast\",\"id\":\"p5\"},{\"name\":\"Urborg, Tomb of Yawgmoth\",\"index\":1,\"action\":\"land\",\"id\":\"p4\"},{\"mana_cost\":\"{B}\",\"name\":\"Nethergoyf\",\"index\":2,\"action\":\"cast\",\"id\":\"p7\",\"power\":\"0\",\"toughness\":\"1\"},{\"mana_cost\":\"{1}\",\"name\":\"Nihil Spellbomb\",\"index\":3,\"action\":\"cast\",\"id\":\"p8\"}],\"action_pending\":true}",
