---
import Base from '../../../layouts/Base.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import {
  hasTournament as seasonHasTournament,
  loadAvailableSeasons,
  loadSeasonBenchmark,
  loadTournament,
} from '../../../utils/season-data';
import '../../../styles/format-tabs.css';

export function getStaticPaths() {
  return loadAvailableSeasons().map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

// Load season-specific benchmark data
const seasonBenchmark = loadSeasonBenchmark(seasonNum);

const FORMAT_LABELS: Record<string, string> = {
  jumpstart: 'Jumpstart',
  standard: 'Standard',
  modern: 'Modern',
  legacy: 'Legacy',
  commander: 'Commander (Exhibition)',
  combined: 'Combined',
};

const FORMAT_ORDER = ['combined', 'jumpstart', 'standard', 'modern', 'legacy', 'commander'] as const;

const formats = seasonBenchmark.formats;

// Only show tabs for formats that have games (always show combined)
const activeFormats = FORMAT_ORDER.filter(
  (format) => format === 'combined' || formats[format].totalGames > 0
);

const hasData = seasonBenchmark.models.length > 0 || Object.keys(formats).length > 1;

// Check if this season has tournament data
const tournament = seasonHasTournament(seasonNum) ? loadTournament(seasonNum) : null;
const hasTournament = tournament != null;
const hasDraft = !!tournament?.draft;
const tournamentSize = tournament?.size ?? 0;
---

<Base title={`Season ${seasonNum} Regular Season Rankings`} wide>
  <SeasonNav season={seasonNum} active="rankings" hasTournament={hasTournament} hasDraft={hasDraft} />

  {hasData ? (
    <p class="subtitle" id="subtitle">
      Model ratings based on {seasonBenchmark.totalGames.toLocaleString()} rated games.
      Last updated: <time>{new Date(seasonBenchmark.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>.
    </p>

    <div class="format-tabs" id="format-tabs" style={activeFormats.length <= 1 ? 'display:none' : ''}>
      {activeFormats.map((format) => (
        <button class:list={['format-tab', { active: format === 'combined' }]} data-format={format}>
          {FORMAT_LABELS[format] || format}
          <span class="tab-count">({formats[format].totalGames})</span>
        </button>
      ))}
      <label class="inactive-toggle" title="Inactive models are no longer in the active evaluation pool. Reasons: retired (superseded or bottom-tier), buggy (tool-use issues), or expensive (too costly for regular rotation). Historical ratings are preserved.">
        <input type="checkbox" id="show-inactive" />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        Show inactive models
      </label>
    </div>

    <p class="scoring-link"><a href="/scoring">How scoring works</a></p>

    <div class="table-wrap">
      <table id="leaderboard-table" class="format-combined">
        <thead>
          <tr>
            <th class="rank-col">#</th>
            <th data-sort="modelName" data-type="string">Model Name</th>
            <th data-sort="provider" data-type="string">Provider</th>
            <th data-sort="rating" data-type="number" data-col="rating" class="sorted desc">Rating <span class="sort-arrow">&#9660;</span></th>
            <th data-sort="blunderScore" data-type="number">Blunder Index</th>
            <th data-sort="gamesPlayed" data-type="number">Games Played</th>
            <th data-sort="winRate" data-type="number" class="col-winrate">Win Rate</th>
            <th data-sort="avgApiCost" data-type="number">Avg Cost</th>
          </tr>
        </thead>
        {activeFormats.map((format) => {
          const isExhibition = !!formats[format].exhibition;
          return (
          <tbody data-format={format} data-exhibition={isExhibition ? 'true' : undefined} style={format !== 'combined' ? 'display: none;' : ''}>
            {formats[format].models.map((model, i) => (
              <tr
                data-model-id={model.modelId}
                data-reasoning-effort={model.reasoningEffort || ''}
                data-provider={model.provider}
                data-rating={model.rating ?? ''}
                data-games-played={model.gamesPlayed}
                data-win-rate={model.winRate}
                data-blunder-score={model.blunderScore}
                data-avg-api-cost={model.avgApiCost}
                data-inactive={model.inactive || ''}
                class:list={[{ inactive: model.inactive }]}
              >
                <td class="rank-cell">{i + 1}</td>
                <td class="model-name">{model.modelName}{model.inactive && <span class="inactive-label"> ({model.inactive})</span>}</td>
                <td>{model.provider}</td>
                <td class="num" data-col="rating">{model.rating != null ? model.rating : '\u2014'}</td>
                <td class="num"><span class={`blunder-val ${model.blunderScore < 0.3 ? 'blunder-good' : model.blunderScore < 0.8 ? 'blunder-ok' : 'blunder-bad'}`}>{model.blunderScore.toFixed(2)}</span></td>
                <td class="num"><a class="games-link" href={`/season/${seasonNum}/games?model=${encodeURIComponent(model.modelId)}${model.reasoningEffort ? '&effort=' + encodeURIComponent(model.reasoningEffort) : ''}`}>{model.gamesPlayed}</a></td>
                <td class="num col-winrate">{(model.winRate * 100).toFixed(1)}%</td>
                <td class="num">${model.avgApiCost.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
          );
        })}
      </table>
    </div>

    <p class="no-results" id="no-results" style="display: none;">
      No models match your filters.
    </p>
  ) : (
    <p class="empty-state">No games have been played yet. Check back soon!</p>
  )}
</Base>

<script define:vars={{ seasonNum, tournamentSize }}>
  window.__seasonNum = seasonNum;
  window.__tournamentSize = tournamentSize;
</script>

<script>
  import {
    parseRankingsSortState,
    syncRankingsSortStateToUrl,
  } from '../../../utils/rankings-sort-state';

  declare global {
    interface Window {
      __seasonNum: number;
      __tournamentSize: number;
    }
  }

  const seasonNum = window.__seasonNum;
  const tournamentSize = window.__tournamentSize;
  const table = document.getElementById('leaderboard-table');
  if (!(table instanceof HTMLTableElement)) {
    // No data yet, nothing to make interactive
  } else {
  const tableElement = table;
  const headers = tableElement.querySelectorAll('th[data-sort]');
  const sortTypes = Object.fromEntries(
    Array.from(headers, (th) => {
      const el = th as HTMLElement;
      return [el.dataset.sort!, el.dataset.type!];
    }),
  ) as Record<string, 'string' | 'number'>;
  const showInactiveCheckbox = document.getElementById('show-inactive');
  if (!(showInactiveCheckbox instanceof HTMLInputElement)) {
    throw new Error('Missing inactive toggle on rankings page');
  }
  const inactiveToggle = showInactiveCheckbox;
  const noResults = document.getElementById('no-results');
  if (!(noResults instanceof HTMLElement)) {
    throw new Error('Missing no-results element on rankings page');
  }
  const noResultsElement = noResults;
  const formatTabs = document.getElementById('format-tabs');

  let activeFormat = 'combined';
  let suppressUrlSync = false;

  function getActiveTbody(): HTMLTableSectionElement {
    const tbody = tableElement.querySelector(`tbody[data-format="${activeFormat}"]`);
    if (!(tbody instanceof HTMLTableSectionElement)) {
      throw new Error(`Missing leaderboard body for format ${activeFormat}`);
    }
    return tbody;
  }

  function getSortedHeader(): HTMLElement | null {
    const sortedHeader = tableElement.querySelector('th.sorted');
    return sortedHeader instanceof HTMLElement ? sortedHeader : null;
  }

  function setSortedHeaderState(th: HTMLElement, ascending: boolean) {
    headers.forEach(h => {
      h.classList.remove('sorted', 'asc', 'desc');
      const arrow = h.querySelector('.sort-arrow');
      if (arrow) arrow.textContent = '';
    });

    th.classList.add('sorted', ascending ? 'asc' : 'desc');
    let arrow = th.querySelector('.sort-arrow');
    if (!arrow) {
      arrow = document.createElement('span');
      arrow.className = 'sort-arrow';
      th.appendChild(arrow);
    }
    arrow.textContent = ascending ? '\u25B2' : '\u25BC';
  }

  function applyActiveSort(th: HTMLElement, ascending: boolean) {
    const column = th.dataset.sort!;
    const type = th.dataset.type!;
    setSortedHeaderState(th, ascending);
    sortTable(column, type, ascending);
  }

  function isCanonicalSortActive(): boolean {
    const sortedHeader = getSortedHeader();
    if (!sortedHeader) return false;
    const isExhibition = getActiveTbody().dataset.exhibition === 'true';
    const canonicalColumn = isExhibition ? 'winRate' : 'rating';
    return sortedHeader.dataset.sort === canonicalColumn && sortedHeader.classList.contains('desc');
  }

  function getCurrentSortState() {
    const sortedHeader = getSortedHeader();
    if (!sortedHeader) return null;
    return {
      column: sortedHeader.dataset.sort!,
      ascending: sortedHeader.classList.contains('asc'),
    };
  }

  function updateGamesLinks() {
    tableElement.querySelectorAll('tr[data-model-id]').forEach((row) => {
      const el = row as HTMLElement;
      const modelId = el.dataset.modelId!;
      const effort = el.dataset.reasoningEffort;
      const link = el.querySelector('a.games-link') as HTMLAnchorElement | null;
      if (!link) return;
      const params = new URLSearchParams({ model: modelId });
      if (effort) params.set('effort', effort);
      if (activeFormat !== 'combined') params.set('format', activeFormat);
      link.href = `/season/${seasonNum}/games?` + params.toString();
    });
  }

  function syncStateToUrl() {
    if (suppressUrlSync) return;
    const url = new URL(window.location.href);
    if (activeFormat !== 'combined') url.searchParams.set('format', activeFormat);
    else url.searchParams.delete('format');
    if (inactiveToggle.checked) url.searchParams.set('inactive', '1');
    else url.searchParams.delete('inactive');
    const currentSort = getCurrentSortState();
    if (currentSort) {
      syncRankingsSortStateToUrl(url, currentSort, getActiveTbody().dataset.exhibition === 'true');
    }
    history.replaceState(null, '', url.toString());
  }

  function switchFormat(fmt: string) {
    if (fmt === activeFormat) return;

    // Hide all tbodies, show selected
    tableElement.querySelectorAll('tbody[data-format]').forEach((tb) => {
      (tb as HTMLElement).style.display = 'none';
    });
    const newTbody = tableElement.querySelector(`tbody[data-format="${fmt}"]`);
    if (!(newTbody instanceof HTMLTableSectionElement)) {
      throw new Error(`Missing leaderboard body for format ${fmt}`);
    }
    newTbody.style.display = '';

    // Update active tab styling
    if (formatTabs) {
      formatTabs.querySelectorAll('.format-tab').forEach((t) => t.classList.remove('active'));
      const btn = formatTabs.querySelector(`.format-tab[data-format="${fmt}"]`);
      if (btn instanceof HTMLElement) btn.classList.add('active');
    }

    activeFormat = fmt;
    tableElement.classList.toggle('format-combined', fmt === 'combined');

    // Hide rating column for exhibition formats
    const isExhibition = newTbody.dataset.exhibition === 'true';
    tableElement.classList.toggle('hide-rating-col', isExhibition);

    const sortedHeader = getSortedHeader();
    if (isExhibition && sortedHeader?.dataset.sort === 'rating') {
      const winRateTh = tableElement.querySelector('th[data-sort="winRate"]');
      if (!(winRateTh instanceof HTMLElement)) {
        throw new Error('Missing win-rate header on rankings page');
      }
      applyActiveSort(winRateTh, false);
    } else if (sortedHeader) {
      applyActiveSort(sortedHeader, sortedHeader.classList.contains('asc'));
    }

    updateGamesLinks();
    applyFilters();
    syncStateToUrl();
  }

  // Format tab switching
  if (formatTabs) {
    formatTabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.format-tab') as HTMLElement | null;
      if (!btn) return;
      switchFormat(btn.dataset.format!);
    });
  }

  function sortTable(column: string, type: string, ascending: boolean) {
    const tbody = getActiveTbody();
    if (!tbody) return;
    const rows = Array.from(tbody.querySelectorAll('tr:not(.cutoff-row)'));

    rows.sort((a, b) => {
      const elA = a as HTMLElement;
      const elB = b as HTMLElement;
      let valA: string | number;
      let valB: string | number;

      if (type === 'number') {
        valA = parseFloat(elA.dataset[column] ?? '0');
        valB = parseFloat(elB.dataset[column] ?? '0');
      } else {
        valA = (elA.dataset[column] ?? '').toLowerCase();
        valB = (elB.dataset[column] ?? '').toLowerCase();
      }

      if (valA < valB) return ascending ? -1 : 1;
      if (valA > valB) return ascending ? 1 : -1;
      return 0;
    });

    rows.forEach(row => tbody.appendChild(row));
  }

  headers.forEach(th => {
    th.addEventListener('click', () => {
      const el = th as HTMLElement;
      const type = el.dataset.type!;

      const wasSorted = th.classList.contains('sorted');
      const wasAsc = th.classList.contains('asc');
      const ascending = wasSorted ? !wasAsc : (type === 'string');

      applyActiveSort(el, ascending);
      updateRanks();
      syncStateToUrl();
    });
  });

  function applyFilters() {
    const showInactive = inactiveToggle.checked;
    const tbody = getActiveTbody();
    if (!tbody) return;
    const rows = tbody.querySelectorAll('tr:not(.cutoff-row)');
    let visibleCount = 0;

    rows.forEach(row => {
      const el = row as HTMLElement;
      const visible = showInactive || !el.dataset.inactive;

      el.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    noResultsElement.style.display = visibleCount === 0 ? '' : 'none';
    updateRanks();
  }

  function updateRanks() {
    const tbody = getActiveTbody();
    if (!tbody) return;
    const showRankingDecorations = isCanonicalSortActive();
    tableElement.classList.toggle('canonical-sort', showRankingDecorations);
    let rank = 1;
    const showCutoff = showRankingDecorations && tournamentSize > 0 && activeFormat === 'combined';

    // Remove any existing cutoff row
    tbody.querySelector('.cutoff-row')?.remove();

    let cutoffAfter: HTMLElement | null = null;
    tbody.querySelectorAll('tr').forEach(row => {
      const el = row as HTMLElement;
      const rankCell = el.querySelector('.rank-cell');
      if (!rankCell) return;
      if (el.style.display === 'none') {
        rankCell.textContent = '';
        delete el.dataset.rank;
        el.classList.remove('stripe');
      } else {
        const r = rank++;
        rankCell.textContent = String(r);
        el.dataset.rank = String(r);
        el.classList.toggle('stripe', r % 2 === 0);
        if (showCutoff && r === tournamentSize) {
          cutoffAfter = el;
        }
      }
    });

    if (cutoffAfter) {
      const cutoffRow = document.createElement('tr');
      cutoffRow.className = 'cutoff-row';
      cutoffRow.innerHTML = '<td colspan="8"><div class="cutoff-inner"><span class="cutoff-line"></span><span class="cutoff-label">Top 16 — Championship Qualified</span><span class="cutoff-line"></span></div></td>';
      (cutoffAfter as HTMLElement).after(cutoffRow);
    }
  }

  inactiveToggle.addEventListener('change', () => {
    applyFilters();
    syncStateToUrl();
  });

  // On page load, apply format and inactive params
  {
    suppressUrlSync = true;
    try {
      const params = new URLSearchParams(window.location.search);
      const formatParam = params.get('format');
      if (formatParam && tableElement.querySelector(`tbody[data-format="${formatParam}"]`)) {
        switchFormat(formatParam);
      }
      if (params.get('inactive') === '1') {
        inactiveToggle.checked = true;
      }

      const sortState = parseRankingsSortState(
        params,
        getActiveTbody().dataset.exhibition === 'true',
        sortTypes,
      );
      const sortHeader = tableElement.querySelector(`th[data-sort="${sortState.column}"]`);
      if (!(sortHeader instanceof HTMLElement)) {
        throw new Error(`Missing sort header for ${sortState.column}`);
      }
      applyActiveSort(sortHeader, sortState.ascending);
      updateGamesLinks();
      applyFilters();
    } finally {
      suppressUrlSync = false;
    }
    syncStateToUrl();
  }

  }
</script>

<style is:global>
  .subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .subtitle time {
    color: var(--text-primary);
  }

  .format-tab.active[data-format="combined"] {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  .scoring-link {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .scoring-link a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .scoring-link a:hover {
    color: var(--accent-primary);
  }

  .inactive-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    margin-left: auto;
    border-bottom: 1px dotted var(--text-secondary);
    padding-bottom: 1px;
  }

  .inactive-toggle input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-track {
    position: relative;
    display: inline-block;
    width: 32px;
    height: 18px;
    background: var(--border-default);
    border-radius: 9px;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background: var(--text-secondary);
    border-radius: 50%;
    transition: transform 0.2s, background 0.2s;
  }

  .inactive-toggle input:checked + .toggle-track {
    background: var(--accent-primary);
  }

  .inactive-toggle input:checked + .toggle-track .toggle-thumb {
    transform: translateX(14px);
    background: #fff;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid var(--border-default);
    color: var(--text-secondary);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  th:hover {
    color: var(--accent-primary);
  }

  th.sorted {
    color: var(--accent-primary);
  }

  .sort-arrow {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.7rem;
    vertical-align: middle;
  }

  td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .rank-col {
    cursor: default;
    width: 2rem;
    text-align: center;
  }

  .rank-cell {
    text-align: center;
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .model-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .games-link {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .games-link:hover {
    text-decoration: underline;
  }

  .blunder-good {
    color: var(--color-success);
  }

  .blunder-ok {
    color: var(--color-warning);
  }

  .blunder-bad {
    color: var(--accent-primary);
  }

  th[data-sort="rating"],
  th[data-sort="gamesPlayed"],
  th[data-sort="winRate"],
  th[data-sort="blunderScore"],
  th[data-sort="avgApiCost"] {
    text-align: right;
  }

  table.hide-rating-col [data-col="rating"] {
    display: none;
  }

  /* Medal treatment for top 3 */
  table.canonical-sort tbody tr[data-rank="1"] {
    background: linear-gradient(to right, rgba(255, 215, 0, 0.08), transparent 50%);
    box-shadow: inset 3px 0 0 #ffd700;
  }

  table.canonical-sort tbody tr[data-rank="1"] .rank-cell { color: #ffd700; }

  table.canonical-sort tbody tr[data-rank="2"] {
    background: linear-gradient(to right, rgba(192, 192, 192, 0.06), transparent 50%);
    box-shadow: inset 3px 0 0 #c0c0c0;
  }

  table.canonical-sort tbody tr[data-rank="2"] .rank-cell { color: #c0c0c0; }

  table.canonical-sort tbody tr[data-rank="3"] {
    background: linear-gradient(to right, rgba(205, 127, 50, 0.06), transparent 50%);
    box-shadow: inset 3px 0 0 #cd7f32;
  }

  table.canonical-sort tbody tr[data-rank="3"] .rank-cell { color: #cd7f32; }

  /* Championship cutoff divider */
  .cutoff-row td {
    padding: 0 !important;
    border-bottom: none !important;
    background: none !important;
  }

  .cutoff-row:hover {
    background: none !important;
    box-shadow: none !important;
  }

  .cutoff-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  .cutoff-line {
    flex: 1;
    height: 1px;
    background: var(--accent-primary);
    opacity: 0.4;
  }

  .cutoff-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  tbody tr {
    transition: background 0.15s, box-shadow 0.15s;
  }

  table.canonical-sort tbody tr.stripe:not([data-rank="1"]):not([data-rank="2"]):not([data-rank="3"]) {
    background: rgba(22, 33, 62, 0.3);
  }

  table:not(.canonical-sort) tbody tr.stripe {
    background: rgba(22, 33, 62, 0.3);
  }

  tbody tr:hover {
    background: rgba(var(--accent-primary-rgb), 0.12);
    box-shadow: inset 3px 0 0 var(--accent-primary);
  }

  tbody tr.inactive {
    font-style: italic;
  }

  .inactive-label {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .no-results {
    color: var(--text-secondary);
    font-style: italic;
    text-align: center;
    padding: 2rem 0;
  }

  .empty-state {
    color: var(--text-secondary);
    text-align: center;
    padding: 4rem 0;
    font-size: 1.1rem;
  }

  @media (max-width: 600px) {
    th, td {
      padding: 0.5rem;
      font-size: 0.8rem;
    }

    .format-tabs {
      gap: 0.3rem;
    }

    .format-tab {
      font-size: 0.75rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>
