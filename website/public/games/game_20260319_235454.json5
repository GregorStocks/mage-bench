  "annotations": [
    {
      "decisionIndex": 1,
      "player": "G54n Contra",
      "type": "blunder",
      "severity": "minor",
      "description": "Keeping a 1-land hand (single Mountain) with no card filtering or 1-drops. All spells cost 2+ mana, meaning the player needs to draw a land immediately to function. Roughly a coin flip on whether this hand does anything at all in the first few turns.",
      "actionTaken": "Kept a 1-land, 7-card hand",
      "betterLine": "Mulligan to 6 cards for a more reliable hand with at least 2 lands. A 1-land keep with no filtering or 0-1 drops is too risky, even on the play.",
      "snapshotIndex": 3,
    },
    {
      "decisionIndex": 16,
      "player": "G31FL Vorthos",
      "type": "blunder",
      "severity": "minor",
      "description": "Enchanting the Forest with Wolfwillow Haven produces {G}{G} from one land, but enchanting a Mountain would produce {R}{G}, providing better color flexibility. With Dragonspeaker Shaman ({1}{R}{R}) and Draconic Roar ({1}{R}) in hand alongside green spells, putting the Haven on a Mountain maximizes mana flexibility by allowing one land to produce both colors.",
      "actionTaken": "Enchanted Forest with Wolfwillow Haven",
      "betterLine": "Enchant a Mountain with Wolfwillow Haven to get {R}{G} from one land, providing better color fixing for a hand with both red and green spells",
      "snapshotIndex": 28,
    },
    {
      "decisionIndex": 58,
      "player": "G31FL Vorthos",
      "type": "blunder",
      "severity": "major",
      "description": "Draconic Roar requires targeting a creature, but the opponent has no creatures on the battlefield. This means the spell must target one of Vorthos's own creatures, dealing 3 damage to it for no benefit - essentially wasting a premium removal spell to kill your own creature.",
      "actionTaken": "Cast Draconic Roar during combat with no enemy creatures available as targets, forcing it to target their own creature.",
      "betterLine": "Pass priority (decline to cast) or cast Thrill of Possibility if wanting to use mana during combat. Draconic Roar should be saved as removal for when the opponent plays a threat.",
      "snapshotIndex": 100,
    },
    {
      "decisionIndex": 69,
      "player": "G54n Contra",
      "type": "blunder",
      "severity": "moderate",
      "description": "Chose Ashmouth Hound (2/1 with no immediate impact) over Ardoz, Cobbler of War, which would enter as a 3/1 with haste (attacking immediately for 3) and provide ongoing +2/+0 triggers for future creatures like Bolt Hound and Irreverent Revelers already in hand. Being behind on board at 14 life makes the tempo and synergy from Ardoz significantly more valuable.",
      "actionTaken": "Cast Ashmouth Hound, a 2/1 with summoning sickness and a marginal combat trigger.",
      "betterLine": "Cast Ardoz, Cobbler of War. It enters as a 3/1 with haste, attacks immediately for 3, and sets up powerful synergies with Bolt Hound (enters as 4/2 haste next turn) and other creatures in hand.",
      "snapshotIndex": 113,
    },
    {
      "decisionIndex": 72,
      "player": "G31FL Vorthos",
      "type": "blunder",
      "severity": "questionable",
      "description": "Using Draconic Roar (3 damage removal) on a 2/1 Ashmouth Hound while the opponent is mana-screwed with only 2 Mountains. The removal spell could be saved for a bigger threat later. The opponent has 6 cards in hand that could include larger creatures once they find lands.",
      "actionTaken": "Cast Draconic Roar targeting Ashmouth Hound (2/1)",
      "betterLine": "Cast Thrill of Possibility, discarding Wolf's Quarry (expensive at 6 mana) to draw 2 cards and press card/tempo advantage while the opponent is mana-screwed. Save Draconic Roar for a more impactful target.",
      "snapshotIndex": 117,
    },
