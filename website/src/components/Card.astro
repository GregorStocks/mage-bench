---
/**
 * Inline Magic card reference. Renders as a Scryfall link with card image on hover.
 *
 * Usage: <Card>Questing Beast</Card>
 *    or: <Card name="Questing Beast" />
 *    or: <Card name="Chains of Mephistopheles">that awful card</Card>
 */
interface Props {
  name?: string;
}

const hasSlot = Astro.slots.has('default');
const slotContent = hasSlot ? (await Astro.slots.render('default')).trim() : null;
const name = Astro.props.name ?? slotContent;
assert(name, 'Card component requires a name prop or slot content');

function assert(condition: unknown, message: string): asserts condition {
  if (!condition) throw new Error(message);
}

const encoded = encodeURIComponent(name);
const scryfallUrl = `https://scryfall.com/search?q=!%22${encoded}%22`;
const scryfallImage = `https://api.scryfall.com/cards/named?exact=${encoded}&format=image&version=normal`;
// If name prop is set and there's slot content, use the slot as display text.
// Otherwise display the card name.
const displaySlot = Astro.props.name && slotContent;
---

<span class="card-ref">
  <a href={scryfallUrl} target="_blank" rel="noopener noreferrer">{displaySlot ? <Fragment set:html={slotContent} /> : name}</a>
  <span class="card-preview">
    <img src={scryfallImage} alt={name} loading="lazy" width="244" height="340" />
  </span>
</span>

<style>
  .card-ref {
    position: relative;
    display: inline;
  }

  .card-ref a {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: rgba(var(--accent-primary-rgb), 0.35);
    text-underline-offset: 0.15em;
    cursor: pointer;
  }

  .card-ref a:hover {
    text-decoration-color: var(--accent-primary);
  }

  .card-preview {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    pointer-events: none;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.6));
    border-radius: 10px;
    overflow: hidden;
  }

  .card-ref:hover .card-preview {
    display: block;
  }

  .card-preview img {
    display: block;
    border-radius: 10px;
  }
</style>
