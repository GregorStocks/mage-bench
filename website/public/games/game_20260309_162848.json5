  "annotations": [
    {
      "severity": "major",
      "description": "Bottomed the only land in the hand, leaving a hand with zero lands. The hand contained Speaker of the Heavens (1-drop), Scroll of Avacyn (1-drop), Guardian Idol (2-drop), and multiple 3-4+ mana spells but now has no way to cast any of them. The player would need to draw lands on consecutive turns just to start playing the game.",
      "action_taken": "Put Plains on the bottom of the library, keeping a zero-land hand",
      "better_line": "Bottom Bulwark Giant (the 6-mana card that is least impactful and hardest to cast) and keep the Plains to have a functional hand with Turn 1 Speaker of the Heavens or Scroll of Avacyn, Turn 2 Guardian Idol.",
      "type": "blunder",
      "snapshot_index": 2,
      "player": "Gem3P Coach",
      "decision_index": 1,
    },
    {
      "severity": "moderate",
      "description": "Bottoming Serra Angel during mulligan when it's the strongest card available and the hand has plenty of Plains to cast it. Serra Angel (4/4 flying vigilance) is the best win condition among these 7 cards, and with 5+ Plains already in hand, reaching 5 mana is trivial.",
      "action_taken": "Put Serra Angel on the bottom of the library",
      "better_line": "Bottom Scroll of Avacyn instead, keeping Serra Angel as a powerful finisher. The ideal 5 to keep would include Thriving Heath, Plains, Guardian Idol, Serra Angel, and Celestial Enforcer (or Faith's Fetters), bottoming Scroll of Avacyn and the weaker remaining card.",
      "type": "blunder",
      "snapshot_index": 4,
      "player": "Gem3P Coach",
      "decision_index": 4,
    },
    {
      "severity": "minor",
      "description": "Passed priority with 1 untapped Plains and two castable 1-mana spells in hand (Anointed Chorister and Scroll of Avacyn), wasting the mana for the turn.",
      "action_taken": "Passed without casting anything, leaving 1 mana unused.",
      "better_line": "Cast Anointed Chorister for {W} to develop a 1/1 lifelink body alongside the Celestial Enforcer, making efficient use of all available mana this turn.",
      "type": "blunder",
      "snapshot_index": 51,
      "player": "Gem3P Coach",
      "decision_index": 41,
    }
  ],
