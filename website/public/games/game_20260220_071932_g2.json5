      "decision_index": 429,
    },
    {
      "severity": "minor",
      "description": "Declined to equip Hero's Blade (+3/+2) to an attacking creature during combat despite having Leonin Shikari (allowing instant-speed equip), plenty of untapped mana, and the opponent at 9 life. This is a free power boost that could help push through lethal or at minimum deal more damage through potential blockers.",
      "action_taken": "Passed without activating Hero's Blade equip ability during combat.",
      "better_line": "Equip Hero's Blade to one of the attacking creatures (likely Sunspear Shikari for lifelink value or whichever is most likely to connect) for +3/+2, increasing damage output against the 9-life opponent.",
      "type": "blunder",
