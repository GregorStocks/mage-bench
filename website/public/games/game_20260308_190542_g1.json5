    {
      "severity": "minor",
      "description": "Opponent has no untapped creatures (Emancipation Angel is summoning sick) and no untapped mana for tricks. Nessian Hornbeetle could attack for 2 unblockable damage with zero risk.",
      "actionTaken": "Declined to attack with Nessian Hornbeetle.",
      "betterLine": "Attack with Nessian Hornbeetle for 2 free damage, since the opponent has no available blockers and no mana for combat tricks.",
      "type": "blunder",
