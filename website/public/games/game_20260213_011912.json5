      "oracle_text": "Choose one. If you control a Wizard as you cast this spell, you may choose two instead.\n• Target player draws two cards.\n• Destroy target artifact.\n• Flame of Anor deals 5 damage to target creature."
    },
    "Flooded Strand": {
      "mana_cost": "",
      "type_line": "Land",
      "oracle_text": "{T}, Pay 1 life, Sacrifice this land: Search your library for a Plains or Island card, put it onto the battlefield, then shuffle."
    },
    "Force of Will": {
      "mana_cost": "{3}{U}{U}",
      "type_line": "Instant",
      "oracle_text": "You may pay 1 life and exile a blue card from your hand rather than pay this spell's mana cost.\nCounter target spell."
    },
    "Guide of Souls": {
      "mana_cost": "{W}",
      "type_line": "Creature — Human Cleric",
      "oracle_text": "Whenever another creature you control enters, you gain 1 life and get {E} (an energy counter).\nWhenever you attack, you may pay {E}{E}{E}. When you do, put two +1/+1 counters and a flying counter on target attacking creature. It becomes an Angel in addition to its other types.",
      "power": "1",
      "toughness": "2"
    },
