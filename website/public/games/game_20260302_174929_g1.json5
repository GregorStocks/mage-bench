      "decision_index": 141,
    },
    {
      "severity": "minor",
      "description": "Opponent has no untapped creatures to block, so attacking with only Turntimber Basilisk (2 damage) instead of also attacking with Kami of Ancient Law leaves 2 free damage on the table. At 12 vs 12 life, this is meaningful.",
