    },
    {
      "severity": "moderate",
      "description": "Opponent has no creatures on the battlefield, so all attackers would deal damage unblocked. Timmy has at least 2 Badgermole Cubs and Spider Manifestation for 6 free damage against a 17-life opponent. Not attacking throws away significant free damage with no downside.",
      "action_taken": "Skipped the attack phase entirely despite opponent having no blockers.",
      "better_line": "Attack with all creatures (at minimum both Badgermole Cubs) for 4-6 free damage into an empty board.",
      "type": "blunder",
