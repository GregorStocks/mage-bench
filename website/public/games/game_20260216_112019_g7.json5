1\"}]},{\"blocked\":false,\"defending\":\"Qwen3 Undrdog\",\"attackers\":[{\"name\":\"Tersa Lightshatter\",\"id\":\"p7\",\"power\":\"3\",\"toughness\":\"3\"}]}],\"turn\":4}",
