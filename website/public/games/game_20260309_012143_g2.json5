      "decision_index": 204,
    },
    {
      "severity": "minor",
      "description": "Failed to activate Angelic Page to pump the attacking Baneslayer Angel for free. Angelic Page can tap (no mana cost) to give an attacking creature +1/+1, which would have dealt 1 extra damage and gained 1 extra life via lifelink. The opponent has no untapped blockers and almost no open mana for tricks.",
      "action_taken": "Passed priority without activating Angelic Page or casting Feat of Resistance.",
      "better_line": "Activate Angelic Page targeting Baneslayer Angel to get a free +1/+1 pump, dealing 6 damage instead of 5 and gaining 6 life instead of 5. Could also consider Feat of Resistance for a permanent +1/+1 counter.",
      "type": "blunder",
      "snapshot_index": 301,
      "player": "Gem3P Coach",
      "decision_index": 207,
    },
    {
      "severity": "moderate",
      "description": "Gem3P Coach declined to block a 4/4 flying Angel Token, taking 4 unnecessary damage. They had Feat of Resistance in hand with 3 untapped lands available, which could have given Emancipation Angel (3/3) a +1/+1 counter and protection from white. This would have made Emancipation Angel a 4/4 that takes no damage from the white Angel Token (protection prevents damage), killing the attacker for free while keeping their creature and gaining a permanent +1/+1 counter.",
      "action_taken": "Declined to block, taking 4 damage (26 → 22 life).",
      "better_line": "Block the 4/4 Angel Token with Emancipation Angel, then cast Feat of Resistance on Emancipation Angel choosing protection from white. This kills the Angel Token, saves Emancipation Angel (now a 4/4 with protection from white), and preserves 4 life.",
      "type": "blunder",
      "snapshot_index": 340,
      "player": "Gem3P Coach",
      "decision_index": 236,
    },
    {
      "severity": "minor",
      "description": "Declined to cast Feat of Resistance during combat when an opponent's 4/4 Angel Token is attacking. Using Feat on Emancipation Angel (making it 4/4 with protection from white) would let it block and kill the white Angel Token while surviving, gaining both a permanent +1/+1 counter and destroying the opponent's token for free.",
      "action_taken": "Passed on casting Feat of Resistance during combat",
      "better_line": "Cast Feat of Resistance targeting Emancipation Angel, choose protection from white, then block the 4/4 Angel Token. Emancipation Angel becomes 4/4, takes no damage from the white token due to protection, and the token dies. Net result: permanent +1/+1 counter on Emancipation Angel and opponent loses their 4/4 flyer.",
      "type": "blunder",
      "snapshot_index": 345,
      "player": "Gem3P Coach",
      "decision_index": 241,
    },
    {
      "severity": "minor",
      "description": "Angelic Page can tap for free to give the unblocked Griffin Token +1/+1, dealing 3 damage instead of 2. There's no cost or downside since the Page isn't attacking or needed for anything else.",
      "action_taken": "Passed priority without using Angelic Page's ability",
      "better_line": "Tap Angelic Page to give Griffin Token +1/+1, dealing 1 extra damage for free",
      "type": "blunder",
      "snapshot_index": 358,
      "player": "Gem3P Coach",
      "decision_index": 247,
    },
    {
      "severity": "minor",
      "description": "Angelic Page's +1/+1 pump was used on the Griffin Token (unblocked 2/2) instead of Baneslayer Angel (unblocked 5/5 with lifelink). Pumping Baneslayer would deal 6 damage and gain 6 life instead of 5/5, a 2-point swing in life differential. Pumping Griffin Token only adds 1 extra damage. The difference is 1 point of value (the extra lifelink).",
      "action_taken": "Targeted Griffin Token with Angelic Page's +1/+1 pump ability",
      "better_line": "Target Baneslayer Angel with Angelic Page's pump to get +1 damage AND +1 life from lifelink, maximizing the 2-point life differential swing",
      "type": "blunder",
      "snapshot_index": 360,
      "player": "Gem3P Coach",
      "decision_index": 249,
    },
    {
      "severity": "minor",
      "description": "Passed priority during combat with Feat of Resistance in hand and 5 untapped lands, missing the opportunity to put a permanent +1/+1 counter on Baneslayer Angel (making it 6/6) while it's attacking unblocked. Opponent's lands are all tapped, so there's no risk. This wastes a free +1 damage, +1 life from lifelink, and a permanent stat boost on the best creature on the board.",
      "action_taken": "Passed priority without casting Feat of Resistance during combat.",
      "better_line": "Cast Feat of Resistance targeting Baneslayer Angel, choosing protection from white (or any relevant color), gaining a permanent +1/+1 counter and dealing 6 lifelink damage instead of 5.",
      "type": "blunder",
      "snapshot_index": 362,
      "player": "Gem3P Coach",
      "decision_index": 252,
    },
    {
      "severity": "minor",
      "description": "Passed priority during combat with Feat of Resistance in hand and 5 untapped lands. Could have cast Feat of Resistance on Baneslayer Angel (unblocked attacker) to permanently buff it to 6/6, deal 1 extra damage, and gain 1 extra life. The opponent has all lands tapped so there's no risk of a blowout. The permanent +1/+1 counter on Baneslayer is meaningful ongoing value.",
      "action_taken": "Passed priority without casting anything during combat",
      "better_line": "Cast Feat of Resistance targeting Baneslayer Angel, choosing protection from white. This permanently buffs Baneslayer to 6/6, deals 1 extra damage and gains 1 extra life this combat, and the protection could be relevant against the opponent's white creatures/removal.",
      "type": "blunder",
      "snapshot_index": 364,
      "player": "Gem3P Coach",
      "decision_index": 254,
    },
    {
      "severity": "minor",
      "description": "Cast Bulwark Giant for 6 mana (gaining 5 life, getting a 3/6) when Brightmare for 3 mana could tap down Emiel the Blessed (gaining 4 life from its 4 power) while leaving 3 mana open for Feat of Resistance or other responses. The opponent has a dangerous flicker engine with Preston + Emiel + Distinguished Conjurer, and tapping Emiel would significantly reduce their ability to generate value next turn.",
      "action_taken": "Cast Bulwark Giant for {5}{W}, using all available mana for a 3/6 body and 5 life.",
      "better_line": "Cast Brightmare targeting Emiel the Blessed to tap it and gain 4 life, leaving 3 mana open for Feat of Resistance to protect Baneslayer Angel or another key creature if needed. This provides nearly the same life gain, better tempo by neutralizing Emiel for a turn, and keeps mana available for interaction.",
      "type": "blunder",
      "snapshot_index": 368,
      "player": "Gem3P Coach",
      "decision_index": 257,
    },
    {
      "severity": "questionable",
      "description": "Targeted Baneslayer Angel (already tapped) with Brightmare's ETB for 5 life, but Baneslayer can't block this turn anyway. Tapping an untapped opponent creature like Basri's Acolyte or Anointed Chorister would gain less life (2) but remove a blocker, potentially enabling better attacks this turn. With multiple attackers available, removing a blocker could have been more impactful than the extra 3 life.",
      "action_taken": "Targeted the already-tapped Baneslayer Angel for 5 life gain",
      "better_line": "Target Basri's Acolyte (untapped 2/3 lifelink) to tap it and prevent it from blocking, enabling more profitable attacks this combat. The 3 less life gained could be offset by better combat outcomes.",
      "type": "blunder",
      "snapshot_index": 392,
      "player": "GPT54 Sport",
      "decision_index": 269,
    }
