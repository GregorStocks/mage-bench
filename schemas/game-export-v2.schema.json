{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "game-export-v2.schema.json",
  "title": "Game Export v2",
  "description": "Schema for the .json.gz game export format (version 2). See doc/export-schema.md for seq semantics and design notes.",
  "type": "object",
  "required": [
    "version",
    "id",
    "timestamp",
    "gameType",
    "deckType",
    "totalTurns",
    "winner",
    "players",
    "cardImages",
    "snapshots",
    "actions",
    "llmEvents",
    "llmTrace",
    "gameOver",
    "harnessEpoch",
    "youtubeUrl",
    "annotations",
    "blunderScriptVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2,
      "description": "Export format version. Always 2 for this schema."
    },
    "id": {
      "type": "string",
      "description": "Game directory name, e.g. 'game_20260210_074307'."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the game was played."
    },
    "gameType": {
      "type": "string",
      "description": "XMage game type, e.g. 'Commander Free For All', 'Two Player Duel'."
    },
    "deckType": {
      "type": "string",
      "description": "XMage deck type, e.g. 'Variant Magic - Freeform Commander', 'Constructed - Standard'."
    },
    "totalTurns": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of turns in the game."
    },
    "winner": {
      "type": ["string", "null"],
      "description": "Name of the winning player, or null if no winner (draw/disconnect)."
    },
    "harnessEpoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Harness epoch at the time the game was played. Used to partition games into comparable eras."
    },
    "youtubeUrl": {
      "type": "string",
      "description": "YouTube URL for the game recording. Empty string if no recording."
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/Player" },
      "description": "Player summaries with model info, costs, and placement."
    },
    "cardImages": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Map of card name to Scryfall small image URL."
    },
    "snapshots": {
      "type": "array",
      "items": { "$ref": "#/$defs/Snapshot" },
      "description": "Game state captured at each decision point (when onPlayerQuery fires)."
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Action" },
      "description": "Game log messages, turn changes, and phase changes."
    },
    "llmEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/LlmEvent" },
      "description": "LLM tool calls, responses, errors, and lifecycle events."
    },
    "llmTrace": {
      "type": "array",
      "items": { "$ref": "#/$defs/LlmTrace" },
      "description": "Full LLM request/response traces (stripped of system prompts and tool definitions)."
    },
    "gameOver": {
      "oneOf": [
        { "$ref": "#/$defs/GameOver" },
        { "type": "null" }
      ],
      "description": "Final game result, or null if the game didn't end normally."
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Annotation" },
      "description": "Blunder annotations from analysis pipeline."
    },
    "blunderScriptVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "Version of the blunder analysis script that produced the annotations."
    }
  },

  "$defs": {
    "Player": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "description": "Player type: 'pilot' (LLM), 'cpu' (XMage AI), etc."
        },
        "model": {
          "type": "string",
          "description": "Model ID, e.g. 'anthropic/claude-opus-4-6'."
        },
        "deckName": {
          "type": "string",
          "description": "Display name for the deck (commander name or filename stem)."
        },
        "commander": {
          "type": "string",
          "description": "Legacy field: commander card name. Replaced by deckName in newer exports."
        },
        "reasoningEffort": {
          "type": "string",
          "description": "Reasoning effort level, e.g. 'low', 'medium', 'high'."
        },
        "totalCostUsd": {
          "type": "number",
          "description": "Total API cost for this player in USD."
        },
        "placement": {
          "type": "integer",
          "minimum": 1,
          "description": "Final placement: 1 = winner, 2 = second, etc."
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "MCP tools available to this player."
        },
        "toolCallsOk": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of successful tool calls."
        },
        "toolCallsFailed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of failed tool calls."
        },
        "thinkingTimeSecs": {
          "type": "number",
          "description": "Total time in seconds this player held priority (chess-clock style)."
        }
      }
    },

    "Snapshot": {
      "type": "object",
      "required": ["seq", "turn", "phase", "step", "active_player", "priority_player", "players", "stack"],
      "additionalProperties": true,
      "properties": {
        "seq": {
          "type": "integer",
          "description": "Server seq number of the decision point that triggered this snapshot."
        },
        "ts": {
          "type": "string",
          "description": "ISO timestamp (present in older exports, may be absent in newer ones)."
        },
        "turn": { "type": "integer", "minimum": 0 },
        "phase": { "type": ["string", "null"] },
        "step": { "type": ["string", "null"] },
        "active_player": { "type": ["string", "null"] },
        "priority_player": { "type": ["string", "null"] },
        "players": {
          "type": "array",
          "items": { "$ref": "#/$defs/SnapshotPlayer" }
        },
        "stack": {
          "type": "array",
          "description": "Spells and abilities on the stack."
        },
        "combat": {
          "type": "array",
          "items": { "$ref": "#/$defs/CombatGroup" },
          "description": "Combat groups (attackers, blockers, defending player)."
        }
      }
    },

    "SnapshotPlayer": {
      "type": "object",
      "required": ["name", "life", "library_size", "battlefield", "graveyard", "hand"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "life": { "type": "integer" },
        "library_size": { "type": "integer", "minimum": 0 },
        "battlefield": {
          "type": "array",
          "description": "Permanents on the battlefield. Items may be strings (card names) or objects with detailed info."
        },
        "graveyard": { "type": "array" },
        "hand": {
          "type": "array",
          "description": "Cards in hand (full contents visible to spectator)."
        },
        "hand_count": { "type": "integer", "minimum": 0 },
        "exile": { "type": "array" },
        "counters": {
          "description": "Player-level counters (poison, energy, etc.). May be array of {name, count} or object."
        },
        "commanders": { "type": "array" },
        "command_zone": { "type": "array" },
        "is_active": { "type": "boolean" },
        "has_left": { "type": "boolean" },
        "mana_pool": {
          "type": "object",
          "description": "Current mana pool by color."
        }
      }
    },

    "CombatGroup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attackers": { "type": "array" },
        "blockers": { "type": "array" },
        "blocked": { "type": "boolean" },
        "defending": { "type": "string" }
      }
    },

    "Action": {
      "type": "object",
      "required": ["seq"],
      "additionalProperties": true,
      "description": "Game log message, turn change, phase change, or chat message. Discriminated by the 'type' field (absent for plain game actions).",
      "properties": {
        "seq": { "type": "integer" },
        "message": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["turn_change", "phase_change", "chat"]
        },
        "turn": { "type": "integer" },
        "phase": { "type": ["string", "null"] },
        "step": { "type": ["string", "null"] },
        "active_player": { "type": ["string", "null"] },
        "ts": { "type": "string" },
        "from": {
          "type": "string",
          "description": "Sender name for chat messages."
        }
      }
    },

    "LlmEvent": {
      "type": "object",
      "required": ["type", "player"],
      "additionalProperties": true,
      "description": "LLM lifecycle event. Discriminated by 'type' field. Has two independent seq namespaces: 'seq' (per-player LLM counter) and 'gameSeq' (server seq cross-reference).",
      "properties": {
        "ts": { "type": "string" },
        "seq": { "type": "integer" },
        "player": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "game_start",
            "llm_response",
            "tool_call",
            "stall",
            "context_reset",
            "context_trim",
            "llm_error",
            "auto_pilot_mode"
          ]
        },
        "gameSeq": {
          "type": "integer",
          "description": "Server seq number for cross-referencing with snapshots/actions."
        },
        "model": { "type": "string" },
        "availableTools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reasoning": { "type": "string" },
        "thinking": { "type": "string" },
        "toolCalls": {},
        "usage": { "$ref": "#/$defs/LlmUsage" },
        "costUsd": { "type": "number" },
        "tool": { "type": "string" },
        "args": { "type": "object" },
        "result": { "type": "string" },
        "latencyMs": { "type": "integer" },
        "turnsWithoutProgress": { "type": "integer" },
        "lastTools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string" },
        "errorType": { "type": "string" },
        "errorMessage": { "type": "string" },
        "messagesBefore": { "type": "integer" },
        "messagesAfter": { "type": "integer" }
      }
    },

    "LlmUsage": {
      "type": "object",
      "properties": {
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "cachedTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "LlmTrace": {
      "type": "object",
      "required": ["ts", "player"],
      "additionalProperties": true,
      "properties": {
        "ts": { "type": "string" },
        "seq": { "type": "integer" },
        "player": { "type": "string" },
        "request": { "type": "object" },
        "response": { "type": "object" }
      }
    },

    "GameOver": {
      "type": "object",
      "required": ["seq", "message"],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer" },
        "message": { "type": "string" }
      }
    },

    "Annotation": {
      "type": "object",
      "required": [
        "snapshotIndex",
        "player",
        "type",
        "severity",
        "description",
        "actionTaken",
        "betterLine"
      ],
      "additionalProperties": true,
      "properties": {
        "snapshotIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the snapshots array — points to the first snapshot after the action resolved."
        },
        "player": { "type": "string" },
        "type": {
          "const": "blunder"
        },
        "severity": {
          "type": "string",
          "enum": ["questionable", "minor", "moderate", "major"]
        },
        "description": { "type": "string" },
        "actionTaken": { "type": "string" },
        "betterLine": { "type": "string" },
        "llmReasoning": {
          "type": "string",
          "description": "Optional LLM reasoning for the annotation."
        }
      }
    }
  }
}
