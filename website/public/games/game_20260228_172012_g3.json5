      "decision_index": 35,
    },
    {
      "severity": "minor",
      "description": "Declined to chump block a 5/5 Ravenous Giant with an expendable 1/1 Goblin Token, taking 5 unnecessary damage (going from 20 to 15 life). The Goblin Tokens have minimal future value compared to 5 life points.",
