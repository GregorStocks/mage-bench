      "args": {
        "card_name": "Archenemy's Charm"
      },
      "result": "{\"success\":true,\"mana_cost\":\"{B}{B}{B}\",\"name\":\"Archenemy\\u0027s Charm\",\"rules\":[\"Choose one \\u0026mdash;: \\u0026bull Exile target creature or planeswalker.: \\u0026bull Return one or two target creature and/or planeswalker cards from your graveyard to your hand.: \\u0026bull Put two +1/+1 counters on target creature you control. It gains lifelink until end of turn.: \"],\"type\":\"Instant\"}",
