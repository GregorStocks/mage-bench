  {
    "name": "choose_action",
    "description": "Respond to pending action. Blocks until an action is pending. Use choice for ID/index/yes/no, attackers/blockers for batch combat.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "choice": {
          "type": "string",
          "description": "ID (\"p3\"), index (\"0\"), or yes/no. yes=mulligan/confirm, no=keep/pass.",
        },
        "amount": {
          "type": "integer",
          "description": "Amount value (for amount actions)",
        },
        "amounts": {
          "type": "array",
          "items": {
            "type": "integer",
          },
          "description": "Multiple amount values (for multi_amount)",
        },
        "pile": {
          "type": "integer",
          "description": "Pile number: 1 or 2",
        },
        "text": {
          "type": "string",
          "description": "Text value for GAME_CHOOSE_CHOICE (pick option by name)",
        },
        "mana_plan": {
          "type": "string",
          "description": "Comma-separated permanent IDs to tap for mana (e.g. \"p1,p5:1\"). :N selects ability on multi-ability lands. Pool colors (RED, BLUE, etc.) only SPEND existing pool mana, not produce. Auto-tap fills remaining pips.",
        },
        "auto_tap": {
          "type": "boolean",
          "description": "Auto-tap mana (default true). Set false with mana_plan to require complete plan.",
        },
        "attackers": {
          "type": "string",
          "description": "Batch attack: comma-separated IDs (e.g. \"p1,p2\") or \"all\". Auto-confirms.",
        },
        "blockers": {
          "type": "string",
          "description": "Batch block: comma-separated \"blocker:attacker\" pairs (e.g. \"p5:p1,p6:p2\"). Auto-confirms.",
        }
      },
      "additionalProperties": false,
    },
