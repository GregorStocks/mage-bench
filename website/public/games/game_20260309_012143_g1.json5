      "power": "4",
      "toughness": "3",
    },
    "Garruk's Uprising": {
      "mana_cost": "{2}{G}",
      "type_line": "Enchantment",
      "oracle_text": "When this enchantment enters, if you control a creature with power 4 or greater, draw a card.\n\
