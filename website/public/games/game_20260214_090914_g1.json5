      "mana_cost": "{1}{U}",
      "type_line": "Instant — Lesson",
      "oracle_text": "Look at the top three cards of your library. Put one of those cards into your hand and the rest on the bottom of your library in any order. Put each of those cards into your hand instead if there are three or more Lesson cards in your graveyard.",
    },
    "Artist's Talent": {
      "mana_cost": "{1}{R}",
      "type_line": "Enchantment — Class",
      "oracle_text": "(Gain the next level as a sorcery to add its ability.)\n\
