---
import '../styles/game-renderer.css';
import '../styles/game-viewer.css';
import '../styles/game-header.css';
import '../styles/audit-panel.css';
import type { GameEntry } from '../utils/load-games';
import { safeHttpUrl } from '../utils/safe-http-url';
import {
  formatReplayBlunderSummary,
  normalizedBlunderScriptVersion,
} from '../utils/replay-metadata';

interface Props {
  game: GameEntry;
  minBlunderVersion: number;
  auditMode: boolean;
}

const { game, minBlunderVersion, auditMode } = Astro.props as Props;
const configJson = JSON.stringify({ auditMode }).replace(/</g, '\\u003c');

const youtubeUrl = game.youtubeUrl ? safeHttpUrl(game.youtubeUrl) : null;
const blunderSummary = game.replayBlunderSummary
  ? formatReplayBlunderSummary(game.replayBlunderSummary)
  : null;
const blunderScriptVersion = normalizedBlunderScriptVersion(game.blunderScriptVersion);
const isOldBlunderAnalysis =
  game.replayBlunderSummary != null && blunderScriptVersion < minBlunderVersion;
---

<div id="visualizer" data-spectator-mode="replay">
  <div id="error" class="hidden"></div>

  <div id="game-ui">
    <div id="game-header">
      <div id="game-title">{game.replayTitle}</div>
      {youtubeUrl && (
        <div id="youtube-link">
          <a id="youtube-url" href={youtubeUrl} target="_blank" rel="noopener">Watch on YouTube</a>
        </div>
      )}
      {blunderSummary && (
        <div id="blunder-summary">
          {blunderSummary}
          {isOldBlunderAnalysis && (
            <>
              {' '}
              <span
                class="old-analysis-tag"
                title={`Analyzed with blunder script v${blunderScriptVersion} (min: v${minBlunderVersion})`}
              >
                (older analysis)
              </span>
            </>
          )}
        </div>
      )}
      {game.errors.length > 0 && (
        <details id="error-summary">
          <summary>{game.errors.length} critical error{game.errors.length === 1 ? '' : 's'}</summary>
          <ul class="error-list">
            {game.errors.map((error) => (
              <li>[{error.ts || '?'}] [{error.source || '?'}] {error.player || '?'}: {error.message || '?'}</li>
            ))}
          </ul>
        </details>
      )}
      <div id="season-info">Season {game.season}</div>
    </div>

    {game.season === 0 && (
      <div id="season-banner">
        This is a Season 0 game. MCP tools and priority semantics have changed since this
        game was played, so its results are excluded from Season 1 ratings.
      </div>
    )}

    <div id="loading">Loading game data...</div>
    <div id="viewer-container" class="hidden"></div>
    {auditMode && <div id="audit-container"></div>}
  </div>
</div>

<script is:inline type="application/json" id="game-replay-config" set:html={configJson}></script>
<script>
  import { initSpectatorPage } from "../scripts/init-spectator-page.js";

  void initSpectatorPage();
</script>

<style>
  :global(main.wide:has(#visualizer)) {
    padding: 0.75rem 1rem;
  }

  #visualizer {
    font-family: system-ui, -apple-system, sans-serif;
  }

  #loading, #error {
    text-align: center;
    padding: 1rem 0 2rem;
    color: var(--text-muted);
  }

  #error {
    color: #e94560;
  }

  #youtube-link a {
    color: #e94560;
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid #e94560;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  #youtube-link a:hover {
    background: #e94560;
    color: #fff;
  }

  #season-info {
    font-size: 0.7rem;
    color: #666;
  }

  #season-banner {
    background: #3d1a00;
    color: #e67e22;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }
</style>
