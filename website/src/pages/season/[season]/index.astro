---
import benchmarkData from '../../../data/benchmark-results.json';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const data = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'src', 'data', 'benchmark-results.json'), 'utf-8')
  );
  const seasons: number[] = data.availableSeasons ?? [];
  return seasons.map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

// Determine redirect target based on precedence:
// 1. Championship results (if tournament has any match results)
// 2. Championship entrants (if tournament exists)
// 3. Regular season rankings (default)
const tournamentPath = path.join(process.cwd(), '..', 'data', 'tournaments', `season-${seasonNum}.json`);
let target = 'rankings';

if (fs.existsSync(tournamentPath)) {
  const tournament = JSON.parse(fs.readFileSync(tournamentPath, 'utf-8'));
  const hasResults = tournament.rounds?.some((r: any) =>
    r.matches?.some((m: any) => m.winner_seed != null)
  );
  if (hasResults) {
    target = 'results';
  } else {
    target = 'entrants';
  }
}

const redirectUrl = `/season/${seasonNum}/${target}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={redirectUrl} />
    <title>Season {seasonNum} | mage-bench</title>
    <script is:inline define:vars={{ redirectUrl }}>
      window.location.replace(redirectUrl);
    </script>
    <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
  </head>
  <body></body>
</html>
