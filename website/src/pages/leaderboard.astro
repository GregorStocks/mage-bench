---
import Base from '../layouts/Base.astro';
import benchmarkData from '../data/benchmark-results.json';
import seasonData from '../data/season.json';

const currentSeason = (seasonData as any).current_season;
const availableSeasons: number[] = (benchmarkData as any).availableSeasons ?? [currentSeason];

const FORMAT_LABELS: Record<string, string> = {
  jumpstart: 'Jumpstart',
  standard: 'Standard',
  modern: 'Modern',
  legacy: 'Legacy',
  commander: 'Commander (Exhibition)',
  combined: 'Combined',
};

const FORMAT_ORDER = ['combined', 'jumpstart', 'standard', 'modern', 'legacy', 'commander'];

// Build per-format data from the formats key (or fall back to single leaderboard)
const formats: Record<string, any> = (benchmarkData as any).formats ?? {
  combined: { totalGames: benchmarkData.totalGames, models: benchmarkData.models },
};

// Only show tabs for formats that have games (always show combined)
const activeFormats = FORMAT_ORDER.filter(
  (f) => f === 'combined' || (formats[f] && formats[f].totalGames > 0)
);

const hasData = benchmarkData.models.length > 0 || Object.keys(formats).length > 1;
---

<Base title={`Season ${currentSeason} Leaderboard`} wide>
  <div class="leaderboard-header">
    <h1 id="leaderboard-title">Season {currentSeason} Leaderboard</h1>
    {availableSeasons.length > 1 && (
      <div class="season-tabs" id="season-tabs">
        {[...availableSeasons].reverse().map((s: number) => (
          <button
            class:list={['season-tab', { active: s === currentSeason }]}
            data-season={s}
          >
            Season {s}
            {s === currentSeason && <span class="season-tab-badge">Current</span>}
          </button>
        ))}
      </div>
    )}
  </div>

  {hasData ? (
    <p class="subtitle" id="subtitle">
      Model ratings based on {benchmarkData.totalGames.toLocaleString()} rated games.
      Last updated: <time>{new Date(benchmarkData.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>.
    </p>

    <div class="format-tabs" id="format-tabs" style={activeFormats.length <= 1 ? 'display:none' : ''}>
      {activeFormats.map((fmt: string) => (
        <button class:list={['format-tab', { active: fmt === 'combined' }]} data-format={fmt}>
          {FORMAT_LABELS[fmt] || fmt}
          <span class="tab-count">({(formats[fmt]?.totalGames ?? 0)})</span>
        </button>
      ))}
      <label class="inactive-toggle" title="Inactive models are no longer in the active evaluation pool. Reasons: retired (superseded or bottom-tier), buggy (tool-use issues), or expensive (too costly for regular rotation). Historical ratings are preserved.">
        <input type="checkbox" id="show-inactive" />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        Show inactive models
      </label>
    </div>

    <p class="scoring-link"><a href="/scoring">How scoring works</a></p>

    <div class="table-wrap">
      <table id="leaderboard-table" class="format-combined">
        <thead>
          <tr>
            <th class="rank-col">#</th>
            <th data-sort="modelName" data-type="string">Model Name</th>
            <th data-sort="provider" data-type="string">Provider</th>
            <th data-sort="rating" data-type="number" data-col="rating" class="sorted desc">Rating <span class="sort-arrow">&#9660;</span></th>
            <th data-sort="blunderScore" data-type="number">Blunder Index</th>
            <th data-sort="gamesPlayed" data-type="number">Games Played</th>
            <th data-sort="winRate" data-type="number" class="col-winrate">Win Rate</th>
            <th data-sort="avgApiCost" data-type="number">Avg Cost</th>
          </tr>
        </thead>
        {activeFormats.map((fmt: string) => {
          const isExhibition = !!formats[fmt]?.exhibition;
          return (
          <tbody data-format={fmt} data-exhibition={isExhibition ? 'true' : undefined} style={fmt !== 'combined' ? 'display: none;' : ''}>
            {(formats[fmt]?.models || []).map((m: any, i: number) => (
              <tr
                data-model-id={m.modelId}
                data-reasoning-effort={m.reasoningEffort || ''}
                data-provider={m.provider}
                data-rating={m.rating ?? ''}
                data-games-played={m.gamesPlayed}
                data-win-rate={m.winRate}
                data-blunder-score={m.blunderScore}
                data-avg-api-cost={m.avgApiCost}
                data-inactive={m.inactive || ''}
                class:list={[{ inactive: m.inactive }]}
              >
                <td class="rank-cell">{i + 1}</td>
                <td class="model-name">{m.modelName}{m.inactive && <span class="inactive-label"> ({m.inactive})</span>}</td>
                <td>{m.provider}</td>
                <td class="num" data-col="rating">{m.rating != null ? m.rating : '\u2014'}</td>
                <td class="num"><span class={`blunder-val ${m.blunderScore < 0.3 ? 'blunder-good' : m.blunderScore < 0.8 ? 'blunder-ok' : 'blunder-bad'}`}>{m.blunderScore.toFixed(2)}</span></td>
                <td class="num"><a class="games-link" href={`/games?model=${encodeURIComponent(m.modelId)}${m.reasoningEffort ? '&effort=' + encodeURIComponent(m.reasoningEffort) : ''}`}>{m.gamesPlayed}</a></td>
                <td class="num col-winrate">{(m.winRate * 100).toFixed(1)}%</td>
                <td class="num">${m.avgApiCost.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
          );
        })}
      </table>
    </div>

    <p class="no-results" id="no-results" style="display: none;">
      No models match your filters.
    </p>
  ) : (
    <p class="empty-state">No games have been played yet. Check back soon!</p>
  )}
</Base>

<script>
  const table = document.getElementById('leaderboard-table') as HTMLTableElement | null;
  if (!table) {
    // No data yet, nothing to make interactive
  } else {
  const headers = table.querySelectorAll('th[data-sort]');
  const showInactiveCheckbox = document.getElementById('show-inactive') as HTMLInputElement;
  const noResults = document.getElementById('no-results')!;
  const formatTabs = document.getElementById('format-tabs');

  let activeFormat = 'combined';

  function getActiveTbody(): HTMLTableSectionElement {
    return table!.querySelector(`tbody[data-format="${activeFormat}"]`) as HTMLTableSectionElement;
  }

  function updateGamesLinks() {
    table!.querySelectorAll('tr[data-model-id]').forEach((row) => {
      const el = row as HTMLElement;
      const modelId = el.dataset.modelId!;
      const effort = el.dataset.reasoningEffort;
      const link = el.querySelector('a.games-link') as HTMLAnchorElement | null;
      if (!link) return;
      const params = new URLSearchParams({ model: modelId });
      if (effort) params.set('effort', effort);
      if (activeFormat !== 'combined') params.set('format', activeFormat);
      link.href = '/games?' + params.toString();
    });
  }

  // Format tab switching
  if (formatTabs) {
    formatTabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.format-tab') as HTMLElement | null;
      if (!btn) return;
      const fmt = btn.dataset.format!;
      if (fmt === activeFormat) return;

      // Hide all tbodies, show selected
      table!.querySelectorAll('tbody[data-format]').forEach((tb) => {
        (tb as HTMLElement).style.display = 'none';
      });
      const newTbody = table!.querySelector(`tbody[data-format="${fmt}"]`) as HTMLElement;
      if (newTbody) newTbody.style.display = '';

      // Update active tab styling
      formatTabs.querySelectorAll('.format-tab').forEach((t) => t.classList.remove('active'));
      btn.classList.add('active');

      activeFormat = fmt;
      table!.classList.toggle('format-combined', fmt === 'combined');

      // Hide rating column for exhibition formats
      const isExhibition = newTbody?.dataset.exhibition === 'true';
      table!.classList.toggle('hide-rating-col', isExhibition);

      // If sorted by rating and switching to exhibition, switch to winRate
      if (isExhibition) {
        const ratingTh = table!.querySelector('th[data-sort="rating"]');
        if (ratingTh?.classList.contains('sorted')) {
          const winRateTh = table!.querySelector('th[data-sort="winRate"]') as HTMLElement;
          if (winRateTh) winRateTh.click();
        }
      }

      updateGamesLinks();
      applyFilters();
    });
  }

  function sortTable(column: string, type: string, ascending: boolean) {
    const tbody = getActiveTbody();
    if (!tbody) return;
    const rows = Array.from(tbody.querySelectorAll('tr'));

    rows.sort((a, b) => {
      const elA = a as HTMLElement;
      const elB = b as HTMLElement;
      let valA: string | number;
      let valB: string | number;

      if (type === 'number') {
        valA = parseFloat(elA.dataset[column] ?? '0');
        valB = parseFloat(elB.dataset[column] ?? '0');
      } else {
        valA = (elA.dataset[column] ?? '').toLowerCase();
        valB = (elB.dataset[column] ?? '').toLowerCase();
      }

      if (valA < valB) return ascending ? -1 : 1;
      if (valA > valB) return ascending ? 1 : -1;
      return 0;
    });

    rows.forEach(row => tbody.appendChild(row));
  }

  headers.forEach(th => {
    th.addEventListener('click', () => {
      const el = th as HTMLElement;
      const column = el.dataset.sort!;
      const type = el.dataset.type!;

      const wasSorted = th.classList.contains('sorted');
      const wasAsc = th.classList.contains('asc');
      const ascending = wasSorted ? !wasAsc : (type === 'string');

      headers.forEach(h => {
        h.classList.remove('sorted', 'asc', 'desc');
        const arrow = h.querySelector('.sort-arrow');
        if (arrow) arrow.textContent = '';
      });

      th.classList.add('sorted', ascending ? 'asc' : 'desc');
      let arrow = th.querySelector('.sort-arrow');
      if (!arrow) {
        arrow = document.createElement('span');
        arrow.className = 'sort-arrow';
        th.appendChild(arrow);
      }
      arrow.textContent = ascending ? '\u25B2' : '\u25BC';

      sortTable(column, type, ascending);
      updateRanks();
    });
  });

  function applyFilters() {
    const showInactive = showInactiveCheckbox.checked;
    const tbody = getActiveTbody();
    if (!tbody) return;
    const rows = tbody.querySelectorAll('tr');
    let visibleCount = 0;

    rows.forEach(row => {
      const el = row as HTMLElement;
      const visible = showInactive || !el.dataset.inactive;

      el.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    noResults.style.display = visibleCount === 0 ? '' : 'none';
    updateRanks();
  }

  function updateRanks() {
    const tbody = getActiveTbody();
    if (!tbody) return;
    let rank = 1;
    tbody.querySelectorAll('tr').forEach(row => {
      const el = row as HTMLElement;
      const rankCell = el.querySelector('.rank-cell');
      if (!rankCell) return;
      if (el.style.display === 'none') {
        rankCell.textContent = '';
        delete el.dataset.rank;
      } else {
        const r = rank++;
        rankCell.textContent = String(r);
        el.dataset.rank = String(r);
      }
    });
  }

  showInactiveCheckbox.addEventListener('change', applyFilters);
  updateGamesLinks();
  applyFilters();

  // --- Season switching ---
  const FORMAT_LABELS: Record<string, string> = {
    jumpstart: 'Jumpstart', standard: 'Standard', modern: 'Modern',
    legacy: 'Legacy', commander: 'Commander (Exhibition)', combined: 'Combined',
  };
  const FORMAT_ORDER = ['combined', 'jumpstart', 'standard', 'modern', 'legacy', 'commander'];

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function blunderClass(score: number): string {
    if (score < 0.3) return 'blunder-good';
    if (score < 0.8) return 'blunder-ok';
    return 'blunder-bad';
  }

  function rebuildFromData(data: any) {
    const formats = data.formats ?? { combined: { totalGames: data.totalGames, models: data.models } };
    const activeFmts = FORMAT_ORDER.filter(f => f === 'combined' || (formats[f] && formats[f].totalGames > 0));

    // Update subtitle
    const subtitle = document.getElementById('subtitle');
    if (subtitle) {
      const dateStr = data.generatedAt ? new Date(data.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
      subtitle.innerHTML = `Model ratings based on ${data.totalGames.toLocaleString()} rated games. Last updated: <time>${dateStr}</time>.`;
    }

    // Rebuild format tabs
    if (formatTabs) {
      // Remove all format-tab buttons but keep the inactive toggle
      const toggle = formatTabs.querySelector('.inactive-toggle');
      formatTabs.innerHTML = '';
      activeFmts.forEach(fmt => {
        const btn = document.createElement('button');
        btn.className = 'format-tab' + (fmt === 'combined' ? ' active' : '');
        btn.dataset.format = fmt;
        btn.innerHTML = `${FORMAT_LABELS[fmt] || fmt} <span class="tab-count">(${formats[fmt]?.totalGames ?? 0})</span>`;
        formatTabs.appendChild(btn);
      });
      if (toggle) formatTabs.appendChild(toggle);
      formatTabs.style.display = activeFmts.length <= 1 ? 'none' : '';
    }

    // Remove old tbodies, add new ones
    table!.querySelectorAll('tbody').forEach(tb => tb.remove());
    activeFmts.forEach(fmt => {
      const tbody = document.createElement('tbody');
      tbody.dataset.format = fmt;
      const isExhibition = !!formats[fmt]?.exhibition;
      if (isExhibition) tbody.dataset.exhibition = 'true';
      if (fmt !== 'combined') tbody.style.display = 'none';

      (formats[fmt]?.models || []).forEach((m: any, i: number) => {
        const tr = document.createElement('tr');
        tr.dataset.modelId = m.modelId;
        tr.dataset.reasoningEffort = m.reasoningEffort || '';
        tr.dataset.provider = m.provider;
        tr.dataset.rating = m.rating != null ? String(m.rating) : '';
        tr.dataset.gamesPlayed = String(m.gamesPlayed);
        tr.dataset.winRate = String(m.winRate);
        tr.dataset.blunderScore = String(m.blunderScore);
        tr.dataset.avgApiCost = String(m.avgApiCost);
        tr.dataset.inactive = m.inactive || '';
        if (m.inactive) tr.classList.add('inactive');

        const effortParam = m.reasoningEffort ? '&effort=' + encodeURIComponent(m.reasoningEffort) : '';
        tr.innerHTML = `
          <td class="rank-cell">${i + 1}</td>
          <td class="model-name">${escapeHtml(m.modelName)}${m.inactive ? ' <span class="inactive-label">(' + escapeHtml(m.inactive) + ')</span>' : ''}</td>
          <td>${escapeHtml(m.provider)}</td>
          <td class="num" data-col="rating">${m.rating != null ? m.rating : '\u2014'}</td>
          <td class="num"><span class="blunder-val ${blunderClass(m.blunderScore)}">${m.blunderScore.toFixed(2)}</span></td>
          <td class="num"><a class="games-link" href="/games?model=${encodeURIComponent(m.modelId)}${effortParam}">${m.gamesPlayed}</a></td>
          <td class="num col-winrate">${(m.winRate * 100).toFixed(1)}%</td>
          <td class="num">$${m.avgApiCost.toFixed(2)}</td>
        `;
        tbody.appendChild(tr);
      });
      table!.appendChild(tbody);
    });

    activeFormat = 'combined';
    table!.className = 'format-combined';
    table!.classList.remove('hide-rating-col');
    updateGamesLinks();
    applyFilters();
  }

  const seasonTabs = document.getElementById('season-tabs');
  if (seasonTabs) {
    seasonTabs.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.season-tab') as HTMLElement | null;
      if (!btn || btn.classList.contains('active')) return;
      const season = btn.dataset.season!;

      seasonTabs.querySelectorAll('.season-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');

      const title = document.getElementById('leaderboard-title');
      if (title) title.textContent = `Season ${season} Leaderboard`;

      // Update URL
      const url = new URL(window.location.href);
      url.searchParams.set('season', season);
      history.replaceState(null, '', url.toString());

      try {
        const resp = await fetch(`/data/benchmark-results-season-${parseInt(season, 10)}.json`);
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        rebuildFromData(data);
      } catch (err) {
        console.error('Failed to load season data:', err);
      }
    });

    // On page load, check for ?season= param
    const params = new URLSearchParams(window.location.search);
    const seasonParam = params.get('season');
    if (seasonParam && /^\d+$/.test(seasonParam)) {
      const btn = seasonTabs.querySelector(`.season-tab[data-season="${seasonParam}"]`) as HTMLElement | null;
      if (btn && !btn.classList.contains('active')) {
        btn.click();
      }
    }
  }

  }
</script>

<style is:global>
  h1 {
    font-family: var(--font-heading);
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
  }

  .leaderboard-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .season-tabs {
    display: flex;
    gap: 0.5rem;
  }

  .season-tab {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 20px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .season-tab:hover {
    border-color: var(--accent-secondary);
    color: var(--text-primary);
  }

  .season-tab.active {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
    color: #fff;
  }

  .season-tab-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.2);
    line-height: 1;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .subtitle time {
    color: var(--text-primary);
  }

  .format-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .format-tab {
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 20px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .format-tab:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .format-tab.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #fff;
    font-weight: 700;
  }

  .format-tab.active[data-format="standard"] {
    background: var(--format-standard);
    border-color: var(--format-standard);
  }

  .format-tab.active[data-format="modern"] {
    background: var(--format-modern);
    border-color: var(--format-modern);
  }

  .format-tab.active[data-format="legacy"] {
    background: var(--format-legacy);
    border-color: var(--format-legacy);
  }

  .format-tab.active[data-format="commander"] {
    background: var(--format-commander);
    border-color: var(--format-commander);
  }

  .format-tab.active[data-format="combined"] {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  .tab-count {
    font-size: 0.75rem;
    opacity: 0.7;
    margin-left: 0.2rem;
  }

  .scoring-link {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .scoring-link a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .scoring-link a:hover {
    color: var(--accent-primary);
  }

  .inactive-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    margin-left: auto;
    border-bottom: 1px dotted var(--text-secondary);
    padding-bottom: 1px;
  }

  .inactive-toggle input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-track {
    position: relative;
    display: inline-block;
    width: 32px;
    height: 18px;
    background: var(--border-default);
    border-radius: 9px;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background: var(--text-secondary);
    border-radius: 50%;
    transition: transform 0.2s, background 0.2s;
  }

  .inactive-toggle input:checked + .toggle-track {
    background: var(--accent-primary);
  }

  .inactive-toggle input:checked + .toggle-track .toggle-thumb {
    transform: translateX(14px);
    background: #fff;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid var(--border-default);
    color: var(--text-secondary);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  th:hover {
    color: var(--accent-primary);
  }

  th.sorted {
    color: var(--accent-primary);
  }

  .sort-arrow {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.7rem;
    vertical-align: middle;
  }

  td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .rank-col {
    cursor: default;
    width: 2rem;
    text-align: center;
  }

  .rank-cell {
    text-align: center;
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .model-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .games-link {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .games-link:hover {
    text-decoration: underline;
  }

  .blunder-good {
    color: var(--color-success);
  }

  .blunder-ok {
    color: var(--color-warning);
  }

  .blunder-bad {
    color: var(--accent-primary);
  }

  th[data-sort="rating"],
  th[data-sort="gamesPlayed"],
  th[data-sort="winRate"],
  th[data-sort="blunderScore"],
  th[data-sort="avgApiCost"] {
    text-align: right;
  }

  table.hide-rating-col [data-col="rating"] {
    display: none;
  }

  /* Medal treatment for top 3 */
  tbody tr[data-rank="1"] {
    background: linear-gradient(to right, rgba(255, 215, 0, 0.08), transparent 50%);
    box-shadow: inset 3px 0 0 #ffd700;
