---
import Base from '../../layouts/Base.astro';
import benchmarkData from '../../data/benchmark-results.json';
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';

const minBlunderVersion = (benchmarkData as any).minBlunderVersion ?? 11;
const availableSeasons: number[] = (benchmarkData as any).availableSeasons ?? [];

export function getStaticPaths() {
  const data = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'src', 'data', 'benchmark-results.json'), 'utf-8')
  );
  const seasons: number[] = data.availableSeasons ?? [];
  return seasons.map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

// Load tournament data if it exists
const tournamentPath = path.join(process.cwd(), '..', 'data', 'tournaments', `season-${seasonNum}.json`);
let tournament: any = null;
if (fs.existsSync(tournamentPath)) {
  tournament = JSON.parse(fs.readFileSync(tournamentPath, 'utf-8'));
}

// Load personalities for display
const personalitiesPath = path.join(process.cwd(), '..', 'puppeteer', 'personalities.json');
let personalities: Record<string, any> = {};
if (fs.existsSync(personalitiesPath)) {
  personalities = JSON.parse(fs.readFileSync(personalitiesPath, 'utf-8'));
}

// Load games for this season (same logic as games/index.astro, filtered by season)
const gamesDir = path.join(process.cwd(), 'public', 'games');
const games: Array<Record<string, unknown>> = [];
if (fs.existsSync(gamesDir)) {
  for (const file of fs.readdirSync(gamesDir)) {
    if (!file.startsWith('game_')) continue;
    let data;
    if (file.endsWith('.json') && !file.endsWith('.json.gz')) {
      data = JSON.parse(fs.readFileSync(path.join(gamesDir, file), 'utf-8'));
    } else if (file.endsWith('.json.gz')) {
      const jsonPath = path.join(gamesDir, file.replace('.json.gz', '.json'));
      if (fs.existsSync(jsonPath)) continue;
      const compressed = fs.readFileSync(path.join(gamesDir, file));
      data = JSON.parse(zlib.gunzipSync(compressed).toString());
    } else {
      continue;
    }
    const gameSeason = data.season ?? 0;
    if (gameSeason !== seasonNum) continue;

    const players = data.players || [];
    if (players.length > 0 && !players.some((p: any) => p.toolCallsOk != null)) {
      const toolOk: Record<string, number> = {};
      const toolFailed: Record<string, number> = {};
      for (const ev of (data.llmEvents || [])) {
        if (ev.type !== 'tool_call' || !ev.player) continue;
        let isFail = false;
        if (ev.result) {
          try {
            const r = JSON.parse(ev.result);
            if (r && typeof r === 'object' && r.success === false) isFail = true;
          } catch {}
        }
        if (isFail) toolFailed[ev.player] = (toolFailed[ev.player] || 0) + 1;
        else toolOk[ev.player] = (toolOk[ev.player] || 0) + 1;
      }
      for (const p of players) {
        if (toolOk[p.name] != null || toolFailed[p.name] != null) {
          p.toolCallsOk = toolOk[p.name] || 0;
          p.toolCallsFailed = toolFailed[p.name] || 0;
        }
      }
    }
    if (players.length > 0 && !players.some((p: any) => p.thinkingTimeSecs != null)) {
      const llmEvents: any[] = data.llmEvents || [];
      if (llmEvents.length > 1) {
        const thinking: Record<string, number> = {};
        for (let i = 0; i < llmEvents.length - 1; i++) {
          const player = llmEvents[i].player;
          if (!player) continue;
          const tsA = llmEvents[i].ts;
          const tsB = llmEvents[i + 1].ts;
          if (!tsA || !tsB) continue;
          const gap = (new Date(tsB).getTime() - new Date(tsA).getTime()) / 1000;
          if (gap > 0) thinking[player] = (thinking[player] || 0) + gap;
        }
        for (const p of players) {
          if (thinking[p.name] != null) {
            p.thinkingTimeSecs = Math.round(thinking[p.name] * 10) / 10;
          }
        }
      }
    }
    const entry: Record<string, unknown> = {
      id: data.id,
      timestamp: data.timestamp,
      totalTurns: data.totalTurns,
      winner: data.winner,
      players: players,
      deckType: data.deckType || '',
      harnessEpoch: data.harnessEpoch ?? null,
      season: data.season ?? 0,
      tournament: data.tournament ?? null,
    };
    if (data.youtubeUrl) entry.youtubeUrl = data.youtubeUrl;
    const annotations = data.annotations;
    if (annotations == null) {
      throw new Error(`Game ${data.id} has no annotations`);
    }
    const totalTurns = data.totalTurns as number;
    if (!totalTurns || totalTurns <= 0) {
      throw new Error(`Game ${data.id} has no turns`);
    }
    const WEIGHTS: Record<string, number> = { minor: 1, moderate: 2, major: 4 };
    const weightedByPlayer: Record<string, number> = {};
    for (const p of players) {
      weightedByPlayer[(p as any).name] = 0;
    }
    for (const a of annotations) {
      const ann = a as Record<string, unknown>;
      if (ann.type !== "blunder") continue;
      const sev = ann.severity as string;
      const player = (ann.player as string) || "Unknown";
      weightedByPlayer[player] = (weightedByPlayer[player] || 0) + (WEIGHTS[sev] || 0);
    }
    const scoreByPlayer: Record<string, number> = {};
    for (const [player, weight] of Object.entries(weightedByPlayer)) {
      scoreByPlayer[player] = Math.round((weight / totalTurns) * 100) / 100;
    }
    entry.blunderScoreByPlayer = scoreByPlayer;
    entry.blunderScriptVersion = data.blunderScriptVersion ?? null;
    games.push(entry);
  }
}
games.sort((a, b) => String(b.id).localeCompare(String(a.id)));

// Split tournament games from free-play games
const tournamentGames = games.filter(g => g.tournament != null);
const freePlayGames = games.filter(g => g.tournament == null);

// Build entrants lookup for bracket rendering
const entrantsBySeed: Record<number, any> = {};
if (tournament) {
  for (const e of tournament.entrants) {
    entrantsBySeed[e.seed] = e;
  }
}

// Standard single-elimination seeding order for 16 players
// Top half: seeds that feed into the left side of the bracket
const BRACKET_16_LEFT: [number, number][] = [
  [1, 16], [8, 9], [5, 12], [4, 13],
];
// Bottom half: seeds that feed into the right side of the bracket
const BRACKET_16_RIGHT: [number, number][] = [
  [6, 11], [3, 14], [7, 10], [2, 15],
];

const ROUND_NAMES: Record<number, string> = {
  1: 'Round of 16',
  2: 'Quarterfinals',
  3: 'Semifinals',
  4: 'Finals',
};

// Build two-sided bracket: { left: Round[], right: Round[], finals: Round }
function buildTwoSidedBracket(tournament: any) {
  if (!tournament) return null;

  let rounds: any[];
  if (tournament.rounds && tournament.rounds.length > 0) {
    rounds = tournament.rounds.map((round: any) => ({
      name: round.name,
      round: round.round,
      matches: round.matches,
    }));
  } else if (tournament.size === 16) {
    // Generate empty bracket from seeds
    const allR1 = [...BRACKET_16_LEFT, ...BRACKET_16_RIGHT];
    rounds = [{
      name: ROUND_NAMES[1], round: 1,
      matches: allR1.map(([a, b]) => ({ seed_a: a, seed_b: b, winner_seed: null, game_id: null })),
    }];
    let matchCount = 4;
    for (let r = 2; r <= 4; r++) {
      rounds.push({
        name: ROUND_NAMES[r], round: r,
        matches: Array.from({ length: matchCount }, () => ({ seed_a: null, seed_b: null, winner_seed: null, game_id: null })),
      });
      matchCount = Math.max(1, matchCount / 2);
    }
  } else {
    return null;
  }

  // Split each round's matches into left half and right half
  const leftRounds: any[] = [];
  const rightRounds: any[] = [];
  for (let i = 0; i < rounds.length - 1; i++) {
    const round = rounds[i];
    const half = Math.ceil(round.matches.length / 2);
    leftRounds.push({ ...round, matches: round.matches.slice(0, half) });
    rightRounds.push({ ...round, matches: round.matches.slice(half) });
  }

  return { leftRounds, rightRounds, finals: rounds[rounds.length - 1] };
}
const bracket = buildTwoSidedBracket(tournament);
---

<Base title={`Season ${seasonNum}`} wide={!!tournament}>
  <h1>Season {seasonNum}</h1>

  {seasonNum === 0 && (
    <div class="season0-warning">
      Season 0 was early development &mdash; results are not representative of actual model quality. The harness had significant bugs affecting gameplay, tool reliability, and game outcomes.
    </div>
  )}

  {tournament && (
    <section class="tournament-section">
      <div class="tournament-header">
        <h2>Season {seasonNum} Championship</h2>
        <div class="tournament-meta">
          <span class="meta-chip">{tournament.format.replace('-', ' ')}</span>
          <span class="meta-chip">{tournament.size} players</span>
          <span class="meta-chip">Jumpstart draft</span>
        </div>
        <p class="tournament-how"><a href="/scoring">How scoring and seeding work &rarr;</a></p>
      </div>

      {/* Bracket */}
      {bracket && (
        <div class="bracket-section">
          <h3>Bracket</h3>
          <div class="bracket-scroll">
            <div class="bracket-two-sided" style={`--bracket-half-height: ${(tournament.size / 2) * 56}px`}>
              {/* Left half: R1 → QF → SF */}
              <div class="bracket-half bracket-half-left">
                {bracket.leftRounds.map((round: any, ri: number) => (
                  <>
                    <div class="bracket-round">
                      <div class="round-label">{round.name}</div>
                      <div class="round-matches">
                        {round.matches.map((match: any) => {
                          const ea = match.seed_a != null ? entrantsBySeed[match.seed_a] : null;
                          const eb = match.seed_b != null ? entrantsBySeed[match.seed_b] : null;
                          const isComplete = match.winner_seed != null;
                          const isTBD = match.seed_a == null || match.seed_b == null;
                          const gameUrl = match.game_id ? `/games/${match.game_id}` : null;
                          return (
                            <div class="bracket-match-wrap">
                              <a class:list={['bracket-match', { 'has-link': !!gameUrl, 'tbd': isTBD }]} href={gameUrl || undefined}>
                                <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                                  {match.seed_a != null ? (
                                    <>
                                      <span class="bracket-seed-num">#{match.seed_a}</span>
                                      <span class="bracket-player-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                                      {isComplete && match.winner_seed === match.seed_a && <span class="bracket-win-mark">W</span>}
                                    </>
                                  ) : (
                                    <span class="bracket-player-name tbd-text">TBD</span>
                                  )}
                                </div>
                                <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                                  {match.seed_b != null ? (
                                    <>
                                      <span class="bracket-seed-num">#{match.seed_b}</span>
                                      <span class="bracket-player-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                                      {isComplete && match.winner_seed === match.seed_b && <span class="bracket-win-mark">W</span>}
                                    </>
                                  ) : (
                                    <span class="bracket-player-name tbd-text">TBD</span>
                                  )}
                                </div>
                              </a>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                    {ri < bracket.leftRounds.length - 1 && (
                      <div class="bracket-conn-col">
                        {Array.from({ length: bracket.leftRounds[ri + 1].matches.length }).map((_: any) => (
                          <div class="bracket-conn-item" />
                        ))}
                      </div>
                    )}
                  </>
                ))}
              </div>

              {/* Center: Finals + Champion */}
              <div class="bracket-center">
                <div class="bracket-conn-col">
                  <div class="bracket-conn-item" />
                </div>
                <div class="bracket-round bracket-finals">
                  <div class="round-label">{bracket.finals.name}</div>
                  <div class="round-matches">
                    {bracket.finals.matches.map((match: any) => {
                      const ea = match.seed_a != null ? entrantsBySeed[match.seed_a] : null;
                      const eb = match.seed_b != null ? entrantsBySeed[match.seed_b] : null;
                      const isComplete = match.winner_seed != null;
                      const isTBD = match.seed_a == null || match.seed_b == null;
                      const gameUrl = match.game_id ? `/games/${match.game_id}` : null;
                      return (
                        <div class="bracket-match-wrap">
                          <a class:list={['bracket-match', { 'has-link': !!gameUrl, 'tbd': isTBD }]} href={gameUrl || undefined}>
                            <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                              {match.seed_a != null ? (
                                <>
                                  <span class="bracket-seed-num">#{match.seed_a}</span>
                                  <span class="bracket-player-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                                  {isComplete && match.winner_seed === match.seed_a && <span class="bracket-win-mark">W</span>}
                                </>
                              ) : (
                                <span class="bracket-player-name tbd-text">TBD</span>
                              )}
                            </div>
                            <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                              {match.seed_b != null ? (
                                <>
                                  <span class="bracket-seed-num">#{match.seed_b}</span>
                                  <span class="bracket-player-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                                  {isComplete && match.winner_seed === match.seed_b && <span class="bracket-win-mark">W</span>}
                                </>
                              ) : (
                                <span class="bracket-player-name tbd-text">TBD</span>
                              )}
                            </div>
                          </a>
                        </div>
                      );
                    })}
                    {/* Champion */}
                    {(() => {
                      const finalMatch = bracket.finals.matches[0];
                      const champion = finalMatch?.winner_seed ? entrantsBySeed[finalMatch.winner_seed] : null;
                      return champion ? (
                        <div class="champion-card">
                          <span class="champion-trophy">&#127942;</span>
                          <span class="champion-name">{champion.display_name}</span>
                        </div>
                      ) : null;
                    })()}
                  </div>
                </div>
                <div class="bracket-conn-col bracket-conn-col-right">
                  <div class="bracket-conn-item" />
                </div>
              </div>

              {/* Right half: SF ← QF ← R1 (reversed order in DOM) */}
              <div class="bracket-half bracket-half-right">
                {[...bracket.rightRounds].reverse().map((round: any, ri: number) => (
                  <>
                    {ri < bracket.rightRounds.length - 1 && (
                      <div class="bracket-conn-col bracket-conn-col-right">
                        {Array.from({ length: round.matches.length }).map((_: any) => (
                          <div class="bracket-conn-item" />
                        ))}
                      </div>
                    )}
                    <div class="bracket-round">
                      <div class="round-label">{round.name}</div>
                      <div class="round-matches">
                        {round.matches.map((match: any) => {
                          const ea = match.seed_a != null ? entrantsBySeed[match.seed_a] : null;
                          const eb = match.seed_b != null ? entrantsBySeed[match.seed_b] : null;
                          const isComplete = match.winner_seed != null;
                          const isTBD = match.seed_a == null || match.seed_b == null;
                          const gameUrl = match.game_id ? `/games/${match.game_id}` : null;
                          return (
                            <div class="bracket-match-wrap">
                              <a class:list={['bracket-match', { 'has-link': !!gameUrl, 'tbd': isTBD }]} href={gameUrl || undefined}>
                                <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                                  {match.seed_a != null ? (
                                    <>
                                      <span class="bracket-seed-num">#{match.seed_a}</span>
                                      <span class="bracket-player-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                                      {isComplete && match.winner_seed === match.seed_a && <span class="bracket-win-mark">W</span>}
                                    </>
                                  ) : (
                                    <span class="bracket-player-name tbd-text">TBD</span>
                                  )}
                                </div>
                                <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                                  {match.seed_b != null ? (
                                    <>
                                      <span class="bracket-seed-num">#{match.seed_b}</span>
                                      <span class="bracket-player-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                                      {isComplete && match.winner_seed === match.seed_b && <span class="bracket-win-mark">W</span>}
                                    </>
                                  ) : (
                                    <span class="bracket-player-name tbd-text">TBD</span>
                                  )}
                                </div>
                              </a>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Draft */}
      {tournament.draft && (
        <details class="draft-section">
          <summary><h3>Draft Picks</h3></summary>
          <div class="draft-picks">
            {tournament.draft.picks.map((pick: any, i: number) => {
              const entrant = entrantsBySeed[pick.seed];
              return (
                <div class="draft-pick">
                  <span class="pick-num">Pick {i + 1}</span>
                  <span class="pick-player">#{pick.seed} {entrant?.display_name}</span>
                  <span class="pick-round">Round {pick.round}</span>
                  <span class="pick-choice">
                    chose <strong>{pick.picked}</strong>
                    <span class="pick-options"> from [{pick.options.join(', ')}]</span>
                  </span>
                </div>
              );
            })}
          </div>
        </details>
      )}

      {/* Draft pending */}
      {!tournament.draft && (
        <div class="draft-pending-section">
          <h3>Draft</h3>
          <div class="bracket-pending">
            <p>Draft results will appear here once the Jumpstart draft is complete.</p>
          </div>
        </div>
      )}

      {/* Entrants */}
      <details class="entrants-section" open>
        <summary><h3>Entrants</h3></summary>
        <div class="entrants-grid">
          {tournament.entrants.map((e: any) => {
            const p = personalities[e.personality];
            const deckInfo = tournament.draft?.decklists?.[String(e.seed)];
            return (
              <div class="entrant-card">
                <div class="entrant-seed">#{e.seed}</div>
                <div class="entrant-info">
                  <div class="entrant-name">
                    {e.display_name}
                  </div>
                  <div class="entrant-personality">
                    <span class="personality-name">{e.personality}</span>
                    {p?.prompt_suffix && (
                      <span class="personality-desc" title={p.prompt_suffix}>
                        {p.prompt_suffix.length > 60 ? p.prompt_suffix.slice(0, 60) + '...' : p.prompt_suffix}
                      </span>
                    )}
                  </div>
                  <div class="entrant-stats">
                    <span class="entrant-elo">Elo {e.combined_elo}</span>
                    <span class="entrant-games">{e.games_played} games</span>
                  </div>
                  {deckInfo && (
                    <div class="entrant-deck">
                      {deckInfo.half_decks.join(' + ')}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </details>

      {/* Tournament games */}
      {tournamentGames.length > 0 && (
        <div class="tournament-games-section">
          <h3>Tournament Games</h3>
          <div id="tournament-games-list"></div>
        </div>
      )}
    </section>
  )}

  {/* Free-play games */}
  <section class="games-section">
    {tournament && freePlayGames.length > 0 && <h2>Free Play Games</h2>}
    {!tournament && games.length > 0 && <p class="subtitle">Replay past mage-bench games from Season {seasonNum}.</p>}
    {!tournament && games.length === 0 && <p class="subtitle empty">No games in Season {seasonNum} yet.</p>}
    <div id="format-tabs" class="format-tabs"></div>
    <details class="model-filter-details" id="model-filter-details">
      <summary class="model-filter-summary">Filter by model</summary>
      <div id="model-tabs" class="model-tabs"></div>
    </details>
    <div id="filter-bar" style="display:none"></div>
    <div id="games-list">
      {(tournament ? freePlayGames : games).length > 0 && <p class="loading">Loading games...</p>}
    </div>
  </section>
</Base>

<style>
  h1 {
    font-family: var(--font-heading);
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
  }

  .season0-warning {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: #ef4444;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .subtitle.empty {
    font-style: italic;
  }

  .loading {
    color: var(--text-secondary);
  }

  /* --- Tournament Section --- */
  .tournament-section {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-default);
  }

  .tournament-header {
    margin-bottom: 2rem;
  }

  .tournament-header h2 {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .tournament-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .meta-chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.3);
    border-radius: 20px;
    color: var(--accent-secondary);
    text-transform: capitalize;
  }

  .tournament-how {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .tournament-how a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .tournament-how a:hover {
    color: var(--accent-primary);
  }

  .draft-pending-section {
    margin-bottom: 2rem;
  }

  /* --- Entrants --- */
  .entrants-section {
    margin-bottom: 2rem;
  }

  .entrants-section > summary {
    cursor: pointer;
    user-select: none;
  }

  .entrants-section > summary h3 {
    display: inline;
  }

  .entrants-section h3,
  .bracket-section h3,
  .draft-section h3,
  .draft-pending-section h3,
  .tournament-games-section h3 {
    font-family: var(--font-heading);
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .entrants-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .entrant-card {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    transition: border-color 0.2s;
    overflow: hidden;
  }

  .entrant-card:hover {
    border-color: var(--accent-secondary);
  }

  .entrant-seed {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent-secondary);
    min-width: 2rem;
    text-align: center;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }

  .entrant-info {
