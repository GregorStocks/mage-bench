---
import '../styles/base.css';
import { loadBenchmarkResults } from '../utils/season-data';

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide } = Astro.props;
const currentPath = Astro.url.pathname;
const availableSeasons = loadBenchmarkResults().availableSeasons;

const docsLinks = [
  { href: '/docs/about', label: 'About' },
  { href: '/scoring', label: 'Scoring' },
  { href: '/internals', label: 'Internals' },
];

const navLinks = [
  { href: '/', label: 'Home' },
  ...[...availableSeasons].reverse().map(s => ({
    href: `/season/${s}`,
    label: `Season ${s}`,
  })),
  { href: '/blog', label: 'Blog' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title} | mage-bench</title>
  </head>
  <body>
    <nav class="site-nav">
      <a class="site-title" href="/">mage-bench</a>
      <ul class="site-nav-links">
        {navLinks.map((link, i) => (
          <Fragment>
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
              >
                {link.label}
              </a>
            </li>
            {i === navLinks.length - 2 && (
              <li class="nav-dropdown">
                <span class:list={['nav-dropdown-trigger', { active: docsLinks.some(l => currentPath === l.href || currentPath.startsWith(l.href)) }]}>Docs</span>
                <ul class="nav-dropdown-menu">
                  {docsLinks.map(link => (
                    <li>
                      <a
                        href={link.href}
                        class:list={['nav-link', { active: currentPath === link.href || currentPath.startsWith(link.href) }]}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            )}
          </Fragment>
        ))}
      </ul>
    </nav>
    <main class:list={['site-main', { wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-links">
        <a href="/docs/about">About</a>
        <a href="/contact">Contact</a>
        <a href="https://github.com/GregorStocks/mage-bench">GitHub</a>
      </div>
    </footer>
  </body>
</html>
