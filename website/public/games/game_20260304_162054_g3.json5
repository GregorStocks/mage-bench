  "annotations": [
    {
      "severity": "minor",
      "description": "Playing Mountain on turn 1 instead of Plains means the player cannot cast Anointed Chorister (a {W} 1/1 lifelink) this turn, wasting a turn of development. Plains would enable the turn 1 play while Mountain produces no castable spells on turn 1.",
      "action_taken": "Played Mountain on turn 1",
      "better_line": "Play Plains, then cast Anointed Chorister. Play Thriving Bluff (choosing red) on turn 2 tapped, then Mountain on turn 3 to have {1}{R}{R} for Goblin Artillery.",
      "type": "blunder",
      "snapshot_index": 3,
      "player": "MiniMx Johnny",
      "decision_index": 3,
    },
    {
      "severity": "moderate",
      "description": "Cast Basri's Solidarity with zero creatures on the battlefield, completely wasting the card. Basri's Solidarity puts a +1/+1 counter on each creature you control - with no creatures, it does absolutely nothing. This card has significant value later when cast with multiple creatures (especially with Falconer Adept and Aven Gagglemaster in hand).",
      "action_taken": "Cast Basri's Solidarity with no creatures on the battlefield, achieving nothing and losing a valuable card.",
      "better_line": "Pass priority and save Basri's Solidarity for a later turn when you have creatures on the battlefield. The card scales with creature count and would be much more impactful after deploying Falconer Adept and Aven Gagglemaster.",
      "type": "blunder",
      "snapshot_index": 54,
      "player": "MstLg Stoic",
      "decision_index": 21,
    }
  ],
