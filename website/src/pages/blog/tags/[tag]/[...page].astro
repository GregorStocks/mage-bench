---
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Pagination from '../../../../components/Pagination.astro';
import { getSortedPosts, getUniqueTags, getPostsByTag, slugifyTag } from '../../../../utils/blog';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = getSortedPosts(await getCollection('blog'));
  const tags = getUniqueTags(allPosts);

  return tags.flatMap(tag => {
    const filtered = getPostsByTag(allPosts, tag);
    return paginate(filtered, {
      params: { tag: slugifyTag(tag) },
      props: { tagName: tag },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const { tagName } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={`Posts tagged "${tagName}"`}>
  <a href="/blog/tags" class="back-link">&larr; All tags</a>
  <h1>Tag: {tagName}</h1>
  <p class="subtitle">{page.total} {page.total === 1 ? 'post' : 'posts'}</p>

  <div class="post-list">
    {page.data.map((post: any) => (
      <a href={`/blog/${post.id}`} class="post-card">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="post-author">{post.data.author}</span>
        </div>
        <h2 class="post-title">{post.data.title}</h2>
        <p class="post-desc">{post.data.description}</p>
      </a>
    ))}
  </div>

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
  />
</Base>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-body);
    margin-bottom: 2rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  h1 {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 0.35rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-family: var(--font-prose);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-default);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: block;
    padding: 1.75rem 0;
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.15s;
  }

  .post-card:hover {
    background: rgba(255, 255, 255, 0.02);
    margin: 0 -1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    border-radius: 6px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-family: var(--font-body);
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-author::before {
    content: '\00b7';
    margin-right: 0.5rem;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .post-desc {
    font-family: var(--font-prose);
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.5;
  }
</style>
