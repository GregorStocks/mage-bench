---
import Base from '../../layouts/Base.astro';
import GameListView from '../../components/GameListView.astro';
import { loadAllGames } from '../../utils/load-games';
import { loadBenchmarkResults } from '../../utils/season-data';
import '../../styles/shared.css';
const minBlunderVersion = loadBenchmarkResults().minBlunderVersion;

const games = loadAllGames().filter(g => !g.tournament);
---

<Base title="Games">
  <h1 class="page-title games-title">Games</h1>
  <p class="subtitle">Replay past mage-bench games.</p>
  <GameListView
    games={games}
    minBlunderVersion={minBlunderVersion}
    showSeasonFilter={true}
    showSeasonBadge={true}
  />
</Base>

<style>
  .games-title {
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
</style>
