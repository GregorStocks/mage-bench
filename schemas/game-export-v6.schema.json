{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "game-export-v6.schema.json",
  "title": "Game Export v6",
  "description": "Schema for the .json.gz game export format (version 6). Removes llmTrace (redundant with llmEvents).",
  "type": "object",
  "required": [
    "version",
    "id",
    "timestamp",
    "gameType",
    "deckType",
    "totalTurns",
    "winner",
    "players",
    "cardImages",
    "snapshots",
    "actions",
    "llmEvents",
    "gameOver",
    "harnessEpoch",
    "youtubeUrl",
    "annotations",
    "blunderScriptVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 6,
      "description": "Export format version 6: removed llmTrace (redundant with llmEvents)."
    },
    "id": {
      "type": "string",
      "description": "Game directory name, e.g. 'game_20260210_074307'."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the game was played."
    },
    "gameType": {
      "type": "string",
      "description": "XMage game type, e.g. 'Commander Free For All', 'Two Player Duel'."
    },
    "deckType": {
      "type": "string",
      "description": "XMage deck type, e.g. 'Variant Magic - Freeform Commander', 'Constructed - Standard'."
    },
    "totalTurns": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of turns in the game."
    },
    "winner": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the winning player, or null if no winner (draw/disconnect)."
    },
    "harnessEpoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Harness epoch at the time the game was played. Used to partition games into comparable eras."
    },
    "youtubeUrl": {
      "type": "string",
      "description": "YouTube URL for the game recording. Empty string if no recording."
    },
    "players": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Player"
      },
      "description": "Player summaries with model info, costs, and placement."
    },
    "cardImages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of card name to Scryfall small image URL."
    },
    "cardData": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CardMetadata"
      },
      "description": "Map of card name to Scryfall metadata (oracle text, type line, mana cost, etc.). Present in version 3+ exports."
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Snapshot"
      },
      "description": "Game state captured at each decision point (when onPlayerQuery fires)."
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "description": "Game log messages, turn changes, and phase changes."
    },
    "llmEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LlmEvent"
      },
      "description": "LLM tool calls, responses, errors, and lifecycle events."
    },
    "gameOver": {
      "oneOf": [
        {
          "$ref": "#/$defs/GameOver"
        },
        {
          "type": "null"
        }
      ],
      "description": "Final game result, or null if the game didn't end normally."
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "description": "Blunder annotations from analysis pipeline."
    },
    "blunderScriptVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "Version of the blunder analysis script that produced the annotations."
    },
    "season": {
      "type": "integer",
      "minimum": 0,
      "description": "Season number. 0 = pre-season (harnessEpoch < MIN_LEADERBOARD_EPOCH), 1 = season 1. Present in version 4+ exports."
    },
    "tournament": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tournament identifier, or null for non-tournament games. Present in version 4+ exports."
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "description": "Canonical decision records built at export time. Each references a snapshot and overlays pilot-specific context (choices, playable cards, etc.). See doc/unified-decisions-plan.md."
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GameError"
      },
      "description": "Errors from per-player error logs, surfacing critical issues (loop detection, uncaught exceptions, short ID collisions) for automated analysis. Absent when no errors occurred."
    }
  },
  "$defs": {
    "Player": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Player type: 'pilot' (LLM), 'cpu' (XMage AI), etc."
        },
        "model": {
          "type": "string",
          "description": "Model ID, e.g. 'anthropic/claude-opus-4-6'."
        },
        "deckName": {
          "type": "string",
          "description": "Display name for the deck from the deck registry."
        },
        "deckStrategy": {
          "type": "string",
          "description": "1-2 sentence strategy summary for blunder annotation context."
        },
        "commander": {
          "type": "string",
          "description": "Legacy field: commander card name. Replaced by deckName in newer exports."
        },
        "reasoningEffort": {
          "type": "string",
          "description": "Reasoning effort level, e.g. 'low', 'medium', 'high'."
        },
        "totalCostUsd": {
          "type": "number",
          "description": "Total API cost for this player in USD."
        },
        "placement": {
          "type": "integer",
          "minimum": 1,
          "description": "Final placement: 1 = winner, 2 = second, etc."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "MCP tools available to this player."
        },
        "toolCallsOk": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of successful tool calls."
        },
        "toolCallsFailed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of failed tool calls."
        },
        "thinkingTimeSecs": {
          "type": "number",
          "description": "Total time in seconds this player held priority (chess-clock style)."
        },
        "timedOut": {
          "type": "boolean",
          "description": "True if this player lost by running out of time on the game timer."
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "required": [
        "seq",
        "turn",
        "phase",
        "step",
        "active_player",
        "priority_player",
        "players",
        "stack"
      ],
      "additionalProperties": true,
      "properties": {
        "seq": {
          "type": "integer",
          "description": "Server seq number of the decision point that triggered this snapshot."
        },
        "ts": {
          "type": "string",
          "description": "ISO timestamp (present in older exports, may be absent in newer ones)."
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_player": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority_player": {
          "type": [
            "string",
            "null"
          ]
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapshotPlayer"
          }
        },
        "stack": {
          "type": "array",
          "description": "Spells and abilities on the stack."
        },
        "combat": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CombatGroup"
          },
          "description": "Combat groups (attackers, blockers, defending player)."
        }
      }
    },
    "SnapshotPlayer": {
      "type": "object",
      "required": [
        "name",
        "life",
        "library_size",
        "battlefield",
        "graveyard",
        "hand"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "life": {
          "type": "integer"
        },
        "library_size": {
          "type": "integer",
          "minimum": 0
        },
        "battlefield": {
          "type": "array",
          "description": "Permanents on the battlefield. Items may be strings (card names) or objects with detailed info."
        },
        "graveyard": {
          "type": "array"
        },
        "hand": {
          "type": "array",
          "description": "Cards in hand (full contents visible to spectator)."
        },
        "hand_count": {
          "type": "integer",
          "minimum": 0
        },
        "exile": {
          "type": "array"
        },
        "counters": {
          "description": "Player-level counters (poison, energy, etc.). May be array of {name, count} or object."
        },
        "commanders": {
          "type": "array"
        },
        "command_zone": {
          "type": "array"
        },
        "is_active": {
          "type": "boolean"
        },
        "has_left": {
          "type": "boolean"
        },
        "mana_pool": {
          "type": "object",
          "description": "Current mana pool by color."
        }
      }
    },
    "CombatGroup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attackers": {
          "type": "array"
        },
        "blockers": {
          "type": "array"
        },
        "blocked": {
          "type": "boolean"
        },
        "defending": {
          "type": "string"
        }
      }
    },
    "Action": {
      "type": "object",
      "required": [
        "seq"
      ],
      "additionalProperties": true,
      "description": "Game log message, turn change, phase change, or chat message. Discriminated by the 'type' field (absent for plain game actions).",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "turn_change",
            "phase_change",
            "chat"
          ]
        },
        "turn": {
          "type": "integer"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_player": {
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "Sender name for chat messages."
        }
      }
    },
    "LlmEvent": {
      "type": "object",
      "required": [
        "type",
        "player"
      ],
      "additionalProperties": true,
      "description": "LLM lifecycle event. Discriminated by 'type' field. Has two independent seq namespaces: 'seq' (per-player LLM counter) and 'gameSeq' (server seq cross-reference).",
      "properties": {
        "ts": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "player": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "game_start",
            "llm_response",
            "tool_call",
            "stall",
            "context_reset",
            "context_trim",
            "llm_error",
            "auto_pilot_mode"
          ]
        },
        "gameSeq": {
          "type": "integer",
          "description": "Server seq number for cross-referencing with snapshots/actions."
        },
        "model": {
          "type": "string"
        },
        "availableTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolCalls": {},
        "usage": {
          "$ref": "#/$defs/LlmUsage"
        },
        "costUsd": {
          "type": "number"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "result": {
          "type": "string"
        },
        "latencyMs": {
          "type": "integer"
        },
        "turnsWithoutProgress": {
          "type": "integer"
        },
        "lastTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "errorType": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        },
        "messagesBefore": {
          "type": "integer"
        },
        "messagesAfter": {
          "type": "integer"
        }
      }
    },
    "LlmUsage": {
      "type": "object",
      "properties": {
        "promptTokens": {
          "type": "integer",
          "minimum": 0
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "GameOver": {
      "type": "object",
      "required": [
        "seq",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Annotation": {
      "type": "object",
      "required": [
        "snapshotIndex",
        "player",
        "type",
        "severity",
        "description",
        "actionTaken",
        "betterLine"
      ],
      "additionalProperties": true,
      "properties": {
        "snapshotIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the snapshots array — points to the first snapshot after the action resolved."
        },
        "player": {
          "type": "string"
        },
        "type": {
          "const": "blunder"
        },
        "severity": {
          "type": "string",
          "enum": [
            "questionable",
            "minor",
            "moderate",
            "major"
          ]
        },
        "description": {
          "type": "string"
        },
        "actionTaken": {
          "type": "string"
        },
        "betterLine": {
          "type": "string"
        },
        "llmReasoning": {
          "type": "string",
          "description": "Optional LLM reasoning for the annotation."
        }
      }
    },
    "Decision": {
      "type": "object",
      "required": [
        "index",
        "snapshotIndex",
        "player",
        "turn",
        "phase",
        "actionType",
        "responseType",
        "message",
        "choices",
        "choiceCount",
        "isForced",
        "llmEventIndices",
        "subsequentActions"
      ],
      "additionalProperties": true,
      "description": "Canonical decision record. References a snapshot (by index) and overlays pilot-specific context. See doc/unified-decisions-plan.md.",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Position in the decisions array (0-indexed)."
        },
        "snapshotIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the snapshots array — the game state when this decision was presented."
        },
        "player": {
          "type": "string",
          "description": "Name of the player making this decision."
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "actionType": {
          "type": "string",
          "description": "XMage action type, e.g. 'GAME_SELECT', 'GAME_PICK_REQUIRED_TARGETS'."
        },
        "responseType": {
          "type": "string",
          "description": "MCP response type, e.g. 'select', 'boolean', 'amount', 'multi_select'."
        },
        "message": {
          "type": "string",
          "description": "Prompt message shown to the player."
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Available choices. Shape depends on the tool (name, id, action, mana_cost, etc.)."
        },
        "choiceCount": {
          "type": "integer",
          "minimum": 0
        },
        "isForced": {
          "type": "boolean",
          "description": "True if there is at most one choice (forced action)."
        },
        "pilotContext": {
          "$ref": "#/$defs/PilotContext",
          "description": "Pilot-specific overlay data not captured in the server snapshot."
        },
        "chosen": {
          "description": "Index, answer, or amount the player chose. Null if no response recorded."
        },
        "chosenArgs": {
          "type": "object",
          "additionalProperties": true,
          "description": "Raw args from the choose_action tool call."
        },
        "actionResult": {
          "type": "object",
          "additionalProperties": true,
          "description": "Result of the choose_action tool call."
        },
        "llmEventIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Indices into llmEvents[] covering this decision (source tool call, LLM response, choose_action)."
        },
        "subsequentActions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Game log messages after the action resolved, for annotator context."
        },
        "castRolledBack": {
          "type": "boolean",
          "description": "True if the cast was rolled back (failed mana payment, etc.)."
        }
      }
    },
    "PilotContext": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pilot-specific data extracted from MCP tool results. Not present in server snapshots.",
      "properties": {
        "untappedLands": {
          "type": "integer",
          "minimum": 0
        },
        "landDropsUsed": {
          "type": "integer",
          "minimum": 0
        },
        "playableCards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of cards flagged as playable by the bridge."
        },
        "combatPhase": {
          "type": [
            "string",
            "null"
          ],
          "description": "Combat sub-phase if in combat, null otherwise."
        },
        "alreadyAttacking": {
          "type": "array",
          "description": "Creatures already declared as attackers."
        },
        "incomingAttackers": {
          "type": "array",
          "description": "Opponent creatures attacking this player."
        }
      }
    },
    "GameError": {
      "type": "object",
      "required": [
        "ts",
        "player",
        "source",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "ts": {
          "type": "string",
          "description": "HH:MM:SS timestamp from the error log, or empty string for malformed lines."
        },
        "player": {
          "type": "string",
          "description": "Player name derived from the error log filename."
        },
        "source": {
          "type": "string",
          "description": "Error source tag: 'pilot' (Python-side), 'mcp' (Java bridge-side), or 'unknown'."
        },
        "message": {
          "type": "string",
          "description": "Error message text."
        },
        "decisionIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the decisions array for the decision active when this error occurred. Absent when no matching decision was found."
        }
      }
    },
    "CardMetadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scryfall card metadata baked at export time for offline rendering.",
      "properties": {
        "mana_cost": {
          "type": "string"
        },
        "type_line": {
          "type": "string"
        },
        "oracle_text": {
          "type": "string"
        },
        "power": {
          "type": "string"
        },
        "toughness": {
          "type": "string"
        },
        "loyalty": {
          "type": "string"
        },
        "defense": {
          "type": "string"
        }
      }
    }
  }
}
