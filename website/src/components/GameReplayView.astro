---
import '../styles/game-renderer.css';
import '../styles/game-viewer.css';
import '../styles/game-header.css';
import '../styles/audit-panel.css';
import '../styles/shared.css';
import type { GameEntry } from '../utils/load-games';
import type { GameExportV9 } from '../types/game-export';
import type { PrerenderResult } from '../utils/prerender-timeline';
import { safeHttpUrl } from '../utils/safe-http-url';
import {
  formatReplayBlunderSummary,
  normalizedBlunderScriptVersion,
} from '../utils/replay-metadata';

interface Props {
  game: GameEntry;
  fullGame: GameExportV9;
  prerendered: PrerenderResult;
  minBlunderVersion: number;
  auditMode: boolean;
}

const { game, fullGame, prerendered, minBlunderVersion, auditMode } = Astro.props as Props;
const configJson = JSON.stringify({ auditMode }).replace(/</g, '\\u003c');

const youtube_url = game.youtube_url ? safeHttpUrl(game.youtube_url) : null;
const blunderSummary = game.replayBlunderSummary
  ? formatReplayBlunderSummary(game.replayBlunderSummary)
  : null;
const blunder_script_version = normalizedBlunderScriptVersion(game.blunder_script_version);
const isOldBlunderAnalysis =
  game.replayBlunderSummary != null && blunder_script_version < minBlunderVersion;

// Serialize game JSON for inline embedding, stripping actions and llm_events
// which are already prerendered into the action log HTML.
// For very large games (snapshots > 15 MB), skip inlining entirely to stay
// under Cloudflare Pages' 25 MB per-file limit — the viewer falls back to fetch.
const strippedGame = { ...fullGame, actions: [], llm_events: [] };
const strippedJson = JSON.stringify(strippedGame);
const INLINE_SIZE_LIMIT = 15_000_000; // 15 MB — leaves room for prerendered HTML + page chrome
const inlineGameData = strippedJson.length <= INLINE_SIZE_LIMIT;
const gameDataJson = inlineGameData ? strippedJson.replace(/</g, '\\u003c') : '';

const { entries, snapshotCount, hasLlm, hasChat, hasAnnotations, runningCostBySnapshot } = prerendered;
const runningCostsJson = JSON.stringify(runningCostBySnapshot).replace(/</g, '\\u003c');
---

<div id="visualizer" data-spectator-mode="replay">
  <div id="error" class="hidden"></div>

  <div id="game-ui">
    <div id="game-header" class="surface-card">
      <div id="game-title">{game.replayTitle}</div>
      {youtube_url && (
        <div id="youtube-link">
          <a id="youtube-url" href={youtube_url} target="_blank" rel="noopener">Watch on YouTube</a>
        </div>
      )}
      {blunderSummary && (
        <div id="blunder-summary">
          {blunderSummary}
          {isOldBlunderAnalysis && (
            <>
              {' '}
              <span
                class="old-analysis-tag"
                title={`Analyzed with blunder script v${blunder_script_version} (min: v${minBlunderVersion})`}
              >
                (older analysis)
              </span>
            </>
          )}
        </div>
      )}
      {game.errors.length > 0 && (
        <details id="error-summary">
          <summary>{game.errors.length} critical error{game.errors.length === 1 ? '' : 's'}</summary>
          <ul class="error-list">
            {game.errors.map((error) => (
              <li>[{error.ts || '?'}] [{error.source || '?'}] {error.player || '?'}: {error.message || '?'}</li>
            ))}
          </ul>
        </details>
      )}
      <div id="season-info">Season {game.season}</div>
    </div>

    {game.season === 0 && (
      <div id="season-banner">
        This is a Season 0 game. MCP tools and priority semantics have changed since this
        game was played, so its results are excluded from Season 1 ratings.
      </div>
    )}

    <!-- Prerendered viewer skeleton (was previously built by JS buildDOM()) -->
    <div id="viewer-container">
      <div id="transport" class="surface-card">
        <div class="transport-buttons">
          <button id="btn-prev" title="Previous (Left arrow)">&lt;</button>
          <button id="btn-auto" title="Auto-play">Play</button>
          <button id="btn-next" title="Next (Right arrow)">&gt;</button>
        </div>
        <div id="slider-container">
          <input type="range" id="slider" min="0" max={String(snapshotCount - 1)} value="0" />
        </div>
        <div class="snapshot-position">
          <input type="number" id="snapshot-jump" min="1" max={String(snapshotCount)} value="1" title="Jump to snapshot #" />
          <span class="snap-divider">/</span>
          <span class="snap-total">{snapshotCount}</span>
        </div>
      </div>
      <div id="game-content">
        <div id="game-left">
          <div id="stack-section">
            <div class="section-title">Stack</div>
            <div id="stack-cards" class="cards-row"></div>
          </div>
          <div id="players-grid"></div>
        </div>
        <div id="game-right">
          <div id="action-log" class="surface-card">
            <div class="action-log-header">
              <span class="section-title">Game Log</span>
              <div class="log-filters">
                <label class:list={['filter-checkbox', { hidden: !hasLlm }]}><input type="checkbox" id="filter-llm" checked /> LLM</label>
                <label class="filter-checkbox"><input type="checkbox" id="filter-game" checked /> Game</label>
                <label class:list={['filter-checkbox', { hidden: !hasChat }]}><input type="checkbox" id="filter-chat" checked /> Chat</label>
                <label class:list={['filter-checkbox', { hidden: !hasAnnotations }]}><input type="checkbox" id="filter-annotations" checked /> Blunders</label>
              </div>
            </div>
            <div id="action-list" data-prerendered>
              {entries.map((html) => <Fragment set:html={html} />)}
            </div>
          </div>
        </div>
      </div>
      <div id="card-preview" class="hidden">
        <img id="preview-image" alt="" />
        <div class="card-meta">
          <div class="card-name-row">
            <div id="preview-name" class="card-name"></div>
            <div id="preview-cost" class="card-cost"></div>
          </div>
          <div id="preview-type" class="card-type"></div>
          <pre id="preview-rules" class="card-rules"></pre>
          <div id="preview-stats" class="card-stats"></div>
        </div>
      </div>
    </div>
    {auditMode && <div id="audit-container"></div>}
  </div>
</div>

<script is:inline type="application/json" id="game-replay-config" set:html={configJson}></script>
{inlineGameData && <script is:inline type="application/json" id="game-data" set:html={gameDataJson}></script>}
{inlineGameData && <script is:inline type="application/json" id="running-costs" set:html={runningCostsJson}></script>}
<script>
  import { initSpectatorPage } from "../scripts/init-spectator-page.js";

  void initSpectatorPage();
</script>

<style>
  :global(main.wide:has(#visualizer)) {
    padding: 0.75rem 1rem;
  }

  #visualizer {
    font-family: system-ui, -apple-system, sans-serif;
  }

  #error {
    text-align: center;
    padding: 1rem 0 2rem;
    color: var(--accent-primary);
  }

  #youtube-link a {
    color: var(--accent-primary);
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--accent-primary);
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  #youtube-link a:hover {
    background: var(--accent-primary);
    color: #fff;
  }

  #season-info {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  #season-banner {
    background: #3d1a00;
    color: #e67e22;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }
</style>
