---
import Base from '../../layouts/Base.astro';
import '../../styles/game-renderer.css';
import '../../styles/game-viewer.css';
import '../../styles/game-header.css';
import '../../styles/shared.css';
import fs from 'node:fs';
import path from 'node:path';
import { parseJSON5 } from '../../utils/parse-json5';

const goldenDir = path.resolve(process.cwd(), '..', 'puppeteer', 'tests', 'golden');
const exportsDir = path.join(goldenDir, 'exports');
const promptsDir = path.join(goldenDir, 'prompts');

export function getStaticPaths() {
  const exportsDir = path.resolve(process.cwd(), '..', 'puppeteer', 'tests', 'golden', 'exports');
  if (!fs.existsSync(exportsDir)) {
    return [];
  }
  return fs.readdirSync(exportsDir)
    .filter((f: string) => f.endsWith('.json5'))
    .map((f: string) => f.replace('.json5', ''))
    .map((name: string) => ({ params: { slug: name } }));
}

const { slug } = Astro.params;

// Load export data
const exportFile = path.join(exportsDir, slug + '.json5');
const exportData: unknown = parseJSON5(fs.readFileSync(exportFile, 'utf-8'));

interface PromptMessage {
  role: string;
  content?: unknown;
  tool_calls?: Array<{ id: string; function: { name: string } }>;
  tool_call_id?: string;
}

// Extract MCP tool results from prompt fixture (for the JSON panel)
function extractMcpFixture(promptFile: string): { gameState: unknown, passPriority: unknown } {
  const messages = parseJSON5(fs.readFileSync(promptFile, 'utf-8')) as PromptMessage[];
  const toolCallNames: Record<string, string> = {};
  for (const msg of messages) {
    if (msg.role === 'assistant' && msg.tool_calls) {
      for (const tc of msg.tool_calls) {
        toolCallNames[tc.id] = tc.function.name;
      }
    }
  }
  const targetTools = new Set(['get_game_state', 'pass_priority']);
  let gameState: unknown = null;
  let passPriority: unknown = null;
  for (const msg of messages) {
    if (msg.role !== 'tool') continue;
    const callName = toolCallNames[msg.tool_call_id!];
    if (!targetTools.has(callName)) continue;
    if (typeof msg.content !== 'object' || msg.content === null) continue;
    if (callName === 'get_game_state') gameState = msg.content;
    if (callName === 'pass_priority') passPriority = msg.content;
  }
  return { gameState, passPriority };
}

const promptFile = path.join(promptsDir, slug + '.json5');
const fixture = fs.existsSync(promptFile)
  ? extractMcpFixture(promptFile)
  : { gameState: null, passPriority: null };

const scenarioTitle = slug.replace(/_/g, ' ');
---

<Base title={`Golden: ${scenarioTitle}`} wide>
  <div id="visualizer"
    data-spectator-mode="golden"
    data-game={JSON.stringify(exportData)}
    data-fixture={JSON.stringify({ mcp_game_state: fixture.gameState, mcp_pass_priority: fixture.passPriority })}
  >
    <div id="game-ui">
      <!-- Header -->
      <div id="game-header" class="surface-card">
        <a href="/internals" id="back-link">&larr; All golden tests</a>
        <div id="game-title">{scenarioTitle}</div>
      </div>

      <!-- Transport controls -->
      <div id="transport" class="surface-card">
        <div class="transport-buttons">
          <button id="btn-start" title="First snapshot">|&lt;</button>
          <button id="btn-prev" title="Previous (Left arrow)">&lt;</button>
          <button id="btn-next" title="Next (Right arrow)">&gt;</button>
          <button id="btn-end" title="Last snapshot">&gt;|</button>
          <button id="btn-auto" title="Auto-play">Play</button>
        </div>
        <div class="turn-nav">
          <button id="btn-prev-turn" title="Previous turn ([)">&lt;T</button>
          <select id="turn-select" title="Jump to turn"></select>
          <button id="btn-next-turn" title="Next turn (])">T&gt;</button>
        </div>
        <div id="slider-container">
          <input type="range" id="slider" min="0" max="0" value="0" />
        </div>
        <input type="number" id="snapshot-jump" min="1" max="1" value="1" title="Jump to snapshot #" />
        <div id="snapshot-counter"></div>
      </div>

      <!-- Main content: board left, logs + JSON right -->
      <div id="game-content">
        <div id="game-left">
          <!-- Stack -->
          <div id="stack-section">
            <div class="section-title">Stack</div>
            <div id="stack-cards" class="cards-row"></div>
          </div>

          <!-- Board: player grid -->
          <div id="players-grid"></div>
        </div>

        <div id="game-right">
          <!-- Action log -->
          <div id="action-log" class="surface-card">
            <div class="action-log-header">
              <span class="section-title">Game Log</span>
              <div class="log-filters">
                <select id="player-filter" class="hidden" title="Filter by player">
                  <option value="">All players</option>
                </select>
                <select id="event-type-filter" class="hidden" title="Filter by event type">
                  <option value="">All events</option>
                  <option value="llm">LLM calls only</option>
                  <option value="game">Game actions only</option>
                  <option value="chat">Chat only</option>
                </select>
                <label id="llm-toggle-label" class="hidden">
                  <input type="checkbox" id="llm-toggle" checked /> Show LLM thinking
                </label>
              </div>
            </div>
            <div id="action-list"></div>
          </div>

          <!-- MCP JSON panel -->
          <div id="mcp-json-panel">
            <details open>
              <summary class="section-title">MCP game_state (what the LLM sees)</summary>
              <pre id="mcp-json-block"></pre>
            </details>
          </div>
        </div>
      </div>

      <!-- Card preview (hover) -->
      <div id="card-preview" class="hidden">
        <img id="preview-image" alt="" />
        <div class="card-meta">
          <div class="card-name-row">
            <div id="preview-name" class="card-name"></div>
            <div id="preview-cost" class="card-cost"></div>
          </div>
          <div id="preview-type" class="card-type"></div>
          <pre id="preview-rules" class="card-rules"></pre>
          <div id="preview-stats" class="card-stats"></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  #visualizer {
    font-family: system-ui, -apple-system, sans-serif;
  }

  #back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  #back-link:hover {
    color: var(--accent-primary);
  }

  #game-title {
    text-transform: capitalize;
  }

  #transport {
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  .turn-nav {
    display: flex;
    gap: 0.25rem;
    flex-shrink: 0;
    align-items: center;
  }

  .turn-nav button {
    background: var(--border-default);
    color: #e0e0e0;
    border: 1px solid #1a4a8a;
    border-radius: 4px;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
    font-family: monospace;
    font-size: 0.8rem;
    transition: background 0.15s;
  }

  .turn-nav button:hover {
    background: #1a4a8a;
  }

  #turn-select {
    background: var(--border-default);
    color: #e0e0e0;
    border: 1px solid #1a4a8a;
    border-radius: 4px;
    padding: 0.3rem 0.4rem;
    font-family: monospace;
    font-size: 0.8rem;
    cursor: pointer;
  }

  #snapshot-jump {
    width: 5rem;
    background: var(--border-default);
    color: #e0e0e0;
    border: 1px solid #1a4a8a;
    border-radius: 4px;
    padding: 0.3rem 0.4rem;
    font-family: monospace;
    font-size: 0.8rem;
    text-align: center;
    flex-shrink: 0;
  }

  #snapshot-jump::-webkit-inner-spin-button,
  #snapshot-jump::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  #snapshot-jump { -moz-appearance: textfield; }

  #snapshot-counter {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    min-width: 4rem;
    text-align: right;
  }

  @media (max-width: 600px) {
    #snapshot-jump {
      width: 3.5rem;
    }

    #snapshot-counter {
      min-width: auto;
    }

    #game-left {
      flex-direction: column;
    }
  }

  #game-content {
    gap: 0.75rem;
  }

  #game-left {
    gap: 0.75rem;
  }

  #game-right {
    flex: 0 0 420px;
  }

  #action-log {
    padding: 0.75rem 1rem;
  }

  #player-filter,
  #event-type-filter {
    font-size: 0.72rem;
  }

  #llm-toggle-label {
    font-size: 0.72rem;
  }

  #action-list {
    font-size: 0.93rem;
    line-height: 1.5;
  }

  /* MCP JSON panel */
  #mcp-json-panel {
    margin-top: 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  #mcp-json-panel summary {
    cursor: pointer;
    user-select: none;
  }

  #mcp-json-block {
    background: #0d1117;
    color: #c9d1d9;
    padding: 1rem;
    border-radius: 6px;
    font-size: 0.75rem;
    line-height: 1.4;
    overflow-x: auto;
    max-height: 600px;
    overflow-y: auto;
    white-space: pre;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    margin-top: 0.5rem;
  }
</style>

<script>
  import { initSpectatorPage } from "../../scripts/init-spectator-page.js";

  void initSpectatorPage();
</script>
