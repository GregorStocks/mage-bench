---
import Base from '../layouts/Base.astro';
import modelStats from '../data/model-stats.json';
import internalsData from '../data/internals-data.json';
import blunderData from '../data/blunder-internals.json';
import fs from 'node:fs';
import path from 'node:path';

const goldenDir = path.resolve(process.cwd(), '..', 'puppeteer', 'tests', 'golden');
const exportsDir = path.join(goldenDir, 'exports');

const scenarios: Array<{name: string, snapshots: number, turns: number}> = [];
if (fs.existsSync(exportsDir)) {
  for (const file of fs.readdirSync(exportsDir).sort()) {
    if (!file.endsWith('.json')) continue;
    const data = JSON.parse(fs.readFileSync(path.join(exportsDir, file), 'utf-8'));
    const snaps = data.snapshots || [];
    const lastSnap = snaps.length > 0 ? snaps[snaps.length - 1] : null;
    scenarios.push({
      name: file.replace('.json', ''),
      snapshots: snaps.length,
      turns: lastSnap ? (lastSnap.turn || 0) : 0,
    });
  }
}
---

<Base title="Internals" wide>
  <h1>Internals</h1>

  <div class="tabs">
    <button class="tab active" data-tab="trends">Trends</button>
    <button class="tab" data-tab="model-stats">Model Stats</button>
    <button class="tab" data-tab="blunder">Blunder Analysis</button>
    <button class="tab" data-tab="golden">Golden Tests</button>
  </div>

  <!-- Trends Tab -->
  <div class="tab-content active" id="tab-trends">
    <div class="trends-controls">
      <div class="metric-row">
        <span class="control-label">Metric</span>
        <div class="metric-buttons" id="metric-buttons">
          <button class="metric-btn active" data-metric="costPerGame" title="Total API cost in USD per game">Cost/Game</button>
          <button class="metric-btn" data-metric="winRate" title="Percentage of games won">Win Rate</button>
          <button class="metric-btn" data-metric="toolFailRate" title="Percentage of tool calls that failed (failed / total tool calls)">Tool Fail%</button>
          <button class="metric-btn" data-metric="errorRate" title="Percentage of responses that were errors (errors / total responses+timeouts+errors)">Error Rate</button>
          <button class="metric-btn" data-metric="latencyP50" title="Median (p50) response latency in seconds">Latency p50</button>
          <button class="metric-btn" data-metric="timerTimeoutRate" title="Percentage of games where the player timed out on the game clock">Timer TO%</button>
          <button class="metric-btn" data-metric="timeoutRate" title="Percentage of individual API calls that timed out (timeouts / total responses+timeouts)">TO Rate</button>
          <button class="metric-btn" data-metric="cacheRate" title="Percentage of prompt tokens served from cache (cached / total prompt tokens)">Cache%</button>
          <button class="metric-btn" data-metric="toolCallsPerGame" title="Total tool calls (successful + failed) per game">Tools/Game</button>
          <button class="metric-btn" data-metric="avgPromptTokens" title="Average prompt tokens per API response">Prompt Tok</button>
          <button class="metric-btn" data-metric="avgCompletionTokens" title="Average completion tokens per API response">Compl Tok</button>
          <button class="metric-btn" data-metric="resetsPerGame" title="Number of context window resets per game (when conversation exceeds token limit)">Resets/Game</button>
          <button class="metric-btn" data-metric="thinkingTimePerGame" title="Total time spent in model thinking/reasoning per game, in seconds">Think Time</button>
          <button class="metric-btn" data-metric="reasoningPct" title="Percentage of completion tokens that were reasoning/thinking tokens">Reasoning%</button>
        </div>
      </div>
      <div class="filter-row">
        <div class="filter-group">
          <span class="control-label">Format</span>
          <div class="toggle-buttons" id="format-buttons">
            <button class="toggle-btn active" data-format="all">All</button>
            <button class="toggle-btn" data-format="jumpstart">Jumpstart</button>
            <button class="toggle-btn" data-format="standard">Standard</button>
            <button class="toggle-btn" data-format="modern">Modern</button>
            <button class="toggle-btn" data-format="legacy">Legacy</button>
            <button class="toggle-btn" data-format="commander">Commander</button>
          </div>
        </div>
        <div class="filter-group">
          <label class="control-label">
            Min Epoch
            <input type="number" id="trend-min-epoch" value={1} min="1" />
          </label>
        </div>
        <div class="filter-group">
          <label class="control-label">
            Smoothing
            <input type="number" id="smoothing-window" value="5" min="0" max="50" />
          </label>
        </div>
      </div>
      <div class="model-filter">
        <div class="model-filter-header">
          <span class="control-label">Models</span>
          <input type="text" id="model-search" placeholder="Search..." autocomplete="off" />
          <button class="small-btn" id="select-all-models">All</button>
          <button class="small-btn" id="select-none-models">None</button>
        </div>
        <div class="model-checkboxes" id="model-checkboxes"></div>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="trend-chart"></canvas>
    </div>
    <p class="chart-note" id="chart-note"></p>
  </div>

  <!-- Model Stats Tab -->
  <div class="tab-content" id="tab-model-stats">
    <div class="filters">
      <label class="epoch-label">
        Min Epoch
        <input type="number" id="min-epoch" value={1} min="1" />
      </label>
      <input type="text" id="search-input" placeholder="Search model name..." autocomplete="off" />
    </div>

    <div class="table-wrap">
      <table id="stats-table">
        <colgroup>
          <col style="width: 17%;" />
          <col style="width: 7%;" />
          <col style="width: 4%;" />
          <col style="width: 6%;" />
          <col style="width: 5%;" />
          <col style="width: 4%;" />
          <col style="width: 4%;" />
          <col style="width: 8%;" />
          <col style="width: 7%;" />
          <col style="width: 6%;" />
          <col style="width: 6%;" />
          <col style="width: 6%;" />
          <col style="width: 5%;" />
          <col style="width: 5%;" />
        </colgroup>
        <thead>
          <tr>
            <th data-sort="modelName" data-type="string">Model</th>
            <th data-sort="provider" data-type="string">Provider</th>
            <th data-sort="gamesPlayed" data-type="number" title="Total games played">Games</th>
            <th data-sort="timeoutRate" data-type="number" class="sorted desc" title="Percentage of API calls that timed out">TO Rate <span class="sort-arrow">&#9660;</span></th>
            <th data-sort="totalTimeouts" data-type="number" title="Total number of API call timeouts across all games">Timeouts</th>
            <th data-sort="totalOtherErrors" data-type="number" title="Total non-timeout errors across all games">Errors</th>
            <th data-sort="contextResets" data-type="number" title="Total context window resets across all games">Resets</th>
            <th data-sort="avgPromptTokens" data-type="number" title="Average prompt tokens per API response">Avg Prompt</th>
            <th data-sort="avgCompletionTokens" data-type="number" title="Average completion tokens per API response">Avg Compl</th>
            <th data-sort="avgCost" data-type="number" title="Average API cost per game in USD">Avg Cost</th>
            <th data-sort="cacheRate" data-type="number" title="Percentage of prompt tokens served from cache">Cache%</th>
            <th data-sort="reasoningPct" data-type="number" title="Percentage of completion tokens that were reasoning/thinking tokens">Reasoning%</th>
            <th data-sort="latencyP50" data-type="number" title="Median response latency in seconds">p50 (s)</th>
            <th data-sort="latencyP95" data-type="number" title="95th percentile response latency in seconds">p95 (s)</th>
          </tr>
        </thead>
        <tbody id="stats-body"></tbody>
      </table>
    </div>

    <p class="footnote" id="token-detail-footnote" style="display: none;">
      * Includes games from before epoch 18 when cache/reasoning tokens were not tracked. Percentages only reflect data from epoch 18+.
    </p>
    <p class="no-results" id="no-results" style="display: none;">
      No models match your filters.
    </p>

    <div id="error-detail" class="error-detail" style="display: none;">
      <h2 id="error-detail-heading"></h2>
      <table id="error-detail-table">
        <thead>
          <tr>
            <th>Error Type</th>
            <th class="num">Count</th>
          </tr>
        </thead>
        <tbody id="error-detail-body"></tbody>
      </table>
    </div>
  </div>

  <!-- Blunder Analysis Tab -->
  <div class="tab-content" id="tab-blunder">
    <div class="trends-controls">
      <div class="metric-row">
        <span class="control-label">Metric</span>
        <div class="metric-buttons" id="blunder-metric-buttons">
          <button class="metric-btn active" data-metric="cacheRate" title="Percentage of prompt tokens served from cache">Cache%</button>
          <button class="metric-btn" data-metric="cost" title="Total API cost in USD">Cost</button>
          <button class="metric-btn" data-metric="promptTokens" title="Total prompt tokens used">Prompt Tok</button>
          <button class="metric-btn" data-metric="decisions" title="Number of decisions (action points) in the game">Decisions</button>
        </div>
      </div>
      <div class="filter-row">
        <div class="filter-group">
          <label class="control-label">
            Min Version
            <input type="number" id="blunder-min-version" value="1" min="1" />
          </label>
        </div>
      </div>
    </div>
    <div class="chart-container">
      <canvas id="blunder-chart"></canvas>
    </div>
    <p class="chart-note" id="blunder-chart-note"></p>
  </div>

  <!-- Golden Tests Tab -->
  <div class="tab-content" id="tab-golden">
    <p class="subtitle">Board states from golden prompt tests. Click a scenario to view the full game replay.</p>
    {scenarios.length === 0 && <p>No golden scenarios found. Run <code>make test-golden</code> to generate fixtures.</p>}
    <div class="scenario-list">
      {scenarios.map(s => (
        <a class="scenario-card" href={`/golden/${s.name}`}>
          <div class="scenario-name">{s.name.replace(/_/g, ' ')}</div>
          <div class="scenario-meta">
            {s.snapshots} snapshots &middot; {s.turns} turns
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Data blobs -->
  <script type="application/json" id="model-stats-data" set:html={JSON.stringify(modelStats)} />
  <script type="application/json" id="internals-data" set:html={JSON.stringify(internalsData)} />
  <script type="application/json" id="blunder-data" set:html={JSON.stringify(blunderData)} />

  <!-- Chart.js trends -->
  <script>
    import { Chart, registerables } from 'chart.js';
    Chart.register(...registerables);

    // ─── Tab switching ───
    function switchTab(tabName: string) {
      const btn = document.querySelector(`.tab[data-tab="${tabName}"]`);
      if (!btn) return;
      document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(`tab-${tabName}`)!.classList.add('active');
    }

    document.querySelectorAll('.tab').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab')!;
        location.hash = target;
      });
    });

    // Activate tab from URL hash (e.g. /internals#model-stats)
    function activateFromHash() {
      const hash = location.hash.replace('#', '');
      if (hash && document.querySelector(`.tab[data-tab="${hash}"]`)) {
        switchTab(hash);
      }
    }
    activateFromHash();
    window.addEventListener('hashchange', activateFromHash);

    // ─── Trend chart ───
    type PlayerRecord = {
      key: string;
      modelName: string;
      won: boolean;
      timedOut: boolean;
      costUsd: number;
      promptTokens: number;
      completionTokens: number;
      cachedTokens: number;
      reasoningTokens: number;
      toolCallsOk: number;
      toolCallsFailed: number;
      thinkingTimeSecs: number;
      responses: number;
      timeouts: number;
      otherErrors: number;
      contextResets: number;
      latencyP50: number | null;
    };

    type GameRecord = {
      id: string;
      ts: string;
      epoch: number;
      format: string;
      players: PlayerRecord[];
    };

    const trendData = JSON.parse(document.getElementById('internals-data')!.textContent!) as {
      games: GameRecord[];
    };

    // Build unique model list sorted by name
    const modelMap = new Map<string, string>();
    for (const g of trendData.games) {
      for (const p of g.players) {
        if (!modelMap.has(p.key)) {
          modelMap.set(p.key, p.modelName);
        }
      }
    }
    const allModels = Array.from(modelMap.entries())
      .sort((a, b) => a[1].localeCompare(b[1]));

    // Color palette for lines
    const LINE_COLORS = [
      '#e94560', '#4ecdc4', '#fbbf24', '#a78bfa', '#34d399',
      '#f472b6', '#60a5fa', '#fb923c', '#a3e635', '#c084fc',
      '#38bdf8', '#f87171', '#2dd4bf', '#facc15', '#818cf8',
      '#4ade80', '#f9a8d4', '#93c5fd', '#fdba74', '#bef264',
      '#e879f9', '#7dd3fc', '#fca5a5', '#5eead4', '#fde047',
      '#a5b4fc', '#86efac', '#f5d0fe', '#bfdbfe', '#fed7aa',
    ];

    // State
    let currentMetric = 'costPerGame';
    let currentFormat = 'all';
    let selectedModels = new Set(allModels.map(m => m[0]));
    let minEpochTrend = 11;
    let smoothingWindow = 5;

    // Build model checkboxes
    const checkboxContainer = document.getElementById('model-checkboxes')!;
    const modelSearch = document.getElementById('model-search') as HTMLInputElement;

    function buildCheckboxes() {
      const search = modelSearch.value.toLowerCase();
      checkboxContainer.innerHTML = '';
      for (const [key, name] of allModels) {
        if (search && !name.toLowerCase().includes(search)) continue;
        const label = document.createElement('label');
        label.className = 'model-checkbox';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.value = key;
        cb.checked = selectedModels.has(key);
        cb.addEventListener('change', () => {
          if (cb.checked) selectedModels.add(key);
          else selectedModels.delete(key);
          updateChart();
        });
        const colorIdx = allModels.findIndex(m => m[0] === key);
        const dot = document.createElement('span');
        dot.className = 'color-dot';
        dot.style.background = LINE_COLORS[colorIdx % LINE_COLORS.length];
        const span = document.createElement('span');
        span.textContent = name;
        label.appendChild(cb);
        label.appendChild(dot);
        label.appendChild(span);
        checkboxContainer.appendChild(label);
      }
    }
    buildCheckboxes();
    modelSearch.addEventListener('input', buildCheckboxes);

    document.getElementById('select-all-models')!.addEventListener('click', () => {
      selectedModels = new Set(allModels.map(m => m[0]));
      buildCheckboxes();
      updateChart();
    });
    document.getElementById('select-none-models')!.addEventListener('click', () => {
      selectedModels.clear();
      buildCheckboxes();
      updateChart();
    });

    // Metric buttons
    document.querySelectorAll('.metric-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.metric-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentMetric = (btn as HTMLElement).dataset.metric!;
        updateChart();
      });
    });

    // Format buttons
    document.querySelectorAll('#format-buttons .toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#format-buttons .toggle-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFormat = (btn as HTMLElement).dataset.format!;
        updateChart();
      });
    });

    // Min epoch
    const minEpochTrendInput = document.getElementById('trend-min-epoch') as HTMLInputElement;
    minEpochTrendInput.addEventListener('input', () => {
      minEpochTrend = parseInt(minEpochTrendInput.value) || 1;
      updateChart();
    });

    // Smoothing window
    const smoothingInput = document.getElementById('smoothing-window') as HTMLInputElement;
    smoothingInput.addEventListener('input', () => {
      smoothingWindow = Math.max(0, parseInt(smoothingInput.value) || 0);
      updateChart();
    });

    // Models with known-unreliable cached_tokens data (upstream API bug).
    // Keys may have a ::effort suffix, so check the model ID prefix.
    const UNRELIABLE_CACHE_MODELS = new Set(['x-ai/grok-4.1-fast']);
    function hasUnreliableCache(key: string): boolean {
      const modelId = key.split('::')[0];
      return UNRELIABLE_CACHE_MODELS.has(modelId);
    }

    // Per-game metric: computes a single value for one player in one game
    type PerGameMetric = {
      label: string;
      unit: string;
      compute: (p: PlayerRecord) => number | null;
    };

    const METRICS: Record<string, PerGameMetric> = {
      costPerGame: {
        label: 'Cost per Game',
        unit: '$',
        compute: (p) => p.costUsd,
      },
      winRate: {
        label: 'Win Rate',
        unit: '%',
        compute: (p) => p.won ? 100 : 0,
      },
      toolFailRate: {
        label: 'Tool Fail Rate',
        unit: '%',
        compute: (p) => {
          const total = p.toolCallsOk + p.toolCallsFailed;
          return total > 0 ? (p.toolCallsFailed / total) * 100 : null;
        },
      },
      errorRate: {
        label: 'Error Rate',
        unit: '%',
        compute: (p) => {
          const total = p.responses + p.timeouts + p.otherErrors;
          return total > 0 ? (p.otherErrors / total) * 100 : null;
        },
      },
      latencyP50: {
        label: 'Latency p50',
        unit: 's',
        compute: (p) => p.latencyP50,
      },
      timerTimeoutRate: {
        label: 'Timer Timeout Rate',
        unit: '%',
        compute: (p) => p.timedOut ? 100 : 0,
      },
      timeoutRate: {
        label: 'Timeout Rate',
        unit: '%',
        compute: (p) => {
          const total = p.timeouts + p.responses;
          return total > 0 ? (p.timeouts / total) * 100 : null;
        },
      },
      cacheRate: {
        label: 'Cache Rate',
        unit: '%',
        compute: (p) => p.promptTokens > 0 && !hasUnreliableCache(p.key)
            ? (p.cachedTokens / p.promptTokens) * 100 : null,
      },
      toolCallsPerGame: {
        label: 'Tool Calls per Game',
        unit: '',
        compute: (p) => p.toolCallsOk + p.toolCallsFailed,
      },
      avgPromptTokens: {
        label: 'Prompt Tokens per Response',
        unit: '',
        compute: (p) => p.responses > 0 ? p.promptTokens / p.responses : null,
      },
      avgCompletionTokens: {
        label: 'Completion Tokens per Response',
        unit: '',
        compute: (p) => p.responses > 0 ? p.completionTokens / p.responses : null,
      },
      resetsPerGame: {
        label: 'Context Resets',
        unit: '',
        compute: (p) => p.contextResets,
      },
      thinkingTimePerGame: {
        label: 'Thinking Time',
        unit: 's',
        compute: (p) => p.thinkingTimeSecs,
      },
      reasoningPct: {
        label: 'Reasoning Token %',
        unit: '%',
        compute: (p) => p.completionTokens > 0 ? (p.reasoningTokens / p.completionTokens) * 100 : null,
      },
    };

    // Moving average smoothing (x is game index)
    function movingAverage(points: {x: number; y: number}[], window: number): {x: number; y: number}[] {
      if (points.length === 0 || window <= 1) return points;
      const result: {x: number; y: number}[] = [];
      for (let i = 0; i < points.length; i++) {
        const start = Math.max(0, i - Math.floor(window / 2));
        const end = Math.min(points.length, i + Math.ceil(window / 2));
        let sum = 0;
        for (let j = start; j < end; j++) sum += points[j].y;
        result.push({ x: points[i].x, y: sum / (end - start) });
      }
      return result;
    }

    // Chart instance
    const canvas = document.getElementById('trend-chart') as HTMLCanvasElement;
    let chart: Chart | null = null;

    function updateChart() {
      const metric = METRICS[currentMetric];

      // Filter games and sort chronologically
      const filtered = trendData.games
        .filter(g => {
          if (g.epoch < minEpochTrend) return false;
          if (currentFormat !== 'all' && g.format !== currentFormat) return false;
          return g.ts !== '';
        })
        .sort((a, b) => new Date(a.ts).getTime() - new Date(b.ts).getTime());

      // Build a global game index: each filtered game gets a sequential number.
      // Also store date for tick labels.
      const gameIndex = new Map<string, number>();
      const gameDate = new Map<number, Date>();
      filtered.forEach((g, i) => {
        gameIndex.set(g.id, i);
        gameDate.set(i, new Date(g.ts));
      });

      // Collect per-model raw points: {x: game_index, y: metric_value}
      const modelPoints = new Map<string, {x: number; y: number; date: Date}[]>();

      for (const g of filtered) {
        const idx = gameIndex.get(g.id)!;
        const date = new Date(g.ts);

        for (const p of g.players) {
          if (!selectedModels.has(p.key)) continue;
          const val = metric.compute(p);
          if (val === null) continue;

          if (!modelPoints.has(p.key)) modelPoints.set(p.key, []);
          modelPoints.get(p.key)!.push({ x: idx, y: val, date });
        }
      }

      // Sort each model's points by game index
      for (const points of modelPoints.values()) {
        points.sort((a, b) => a.x - b.x);
      }

      // Build datasets: raw scatter + smoothed line per model
      const datasets: any[] = [];
      let totalRawPoints = 0;

      for (const [modelKey] of allModels) {
        if (!selectedModels.has(modelKey)) continue;
        const points = modelPoints.get(modelKey);
        if (!points || points.length === 0) continue;

        const colorIdx = allModels.findIndex(m => m[0] === modelKey);
        const color = LINE_COLORS[colorIdx % LINE_COLORS.length];
        const modelName = modelMap.get(modelKey) || modelKey;

        totalRawPoints += points.length;

        // Raw scatter points
        datasets.push({
          label: modelName,
          data: points.map(p => ({ x: p.x, y: p.y })),
          type: 'scatter' as const,
          borderColor: color,
          backgroundColor: color + '66',
          pointRadius: 3,
          pointHoverRadius: 6,
          showLine: false,
          order: 2,
        });

        // Smoothed trend line (skip when smoothing is 0)
        const smoothed = smoothingWindow > 0 ? movingAverage(points, smoothingWindow) : [];
        if (smoothed.length >= 2) {
          datasets.push({
            label: modelName + ' (trend)',
            data: smoothed.map(p => ({ x: p.x, y: p.y })),
            type: 'line' as const,
            borderColor: color,
            backgroundColor: 'transparent',
            borderWidth: 2.5,
            tension: 0.3,
            pointRadius: 0,
            pointHoverRadius: 0,
            order: 1,
          });
        }
      }

      // Update note
      const noteEl = document.getElementById('chart-note')!;
      if (totalRawPoints === 0) {
        noteEl.textContent = 'No data for selected filters. Try selecting different models or adjusting filters.';
        if (chart) { chart.destroy(); chart = null; }
        return;
      }
      const numModels = new Set(Array.from(modelPoints.keys()).filter(k => selectedModels.has(k))).size;
      noteEl.textContent = `${numModels} model(s), ${totalRawPoints} game data points, smoothing window: ${smoothingWindow}`;

      // Build date tick labels: show date when it changes between games.
      // Skip the first one (index 0) so it doesn't render on/left of the Y axis.
      const dateTicks: {value: number; label: string}[] = [];
      let lastDateStr = '';
      for (let i = 0; i < filtered.length; i++) {
        const d = gameDate.get(i)!;
        const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        if (dateStr !== lastDateStr) {
          if (lastDateStr !== '') {
            dateTicks.push({ value: i, label: dateStr });
          }
          lastDateStr = dateStr;
        }
      }

      // For very few games, ensure the X scale has sensible bounds
      const xMin = -0.5;
      const xMax = Math.max(filtered.length - 1, 1) + 0.5;

      // Render chart
      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'scatter',
        data: { datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'nearest',
            intersect: false,
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                color: '#a0a0b8',
                boxWidth: 12,
                padding: 12,
                font: { size: 11 },
                filter: (item: any) => !item.text.endsWith('(trend)'),
              },
            },
            tooltip: {
              backgroundColor: '#16213e',
              borderColor: '#0f3460',
              borderWidth: 1,
              titleColor: '#e0e0e0',
              bodyColor: '#a0a0b8',
              filter: (item: any) => !item.dataset.label?.endsWith('(trend)'),
              callbacks: {
                title: (items: any[]) => {
                  if (items.length === 0) return '';
                  const idx = Math.round(items[0].parsed.x);
                  const d = gameDate.get(idx);
                  if (!d) return `Game #${idx}`;
                  return `Game #${idx + 1} — ${d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;
                },
                label: (ctx: any) => {
                  const val = ctx.parsed.y;
                  const name = ctx.dataset.label;
                  if (val === null || val === undefined) return `${name}: no data`;
                  if (metric.unit === '%') return `${name}: ${val.toFixed(1)}%`;
                  if (metric.unit === '$') return `${name}: $${val.toFixed(2)}`;
                  if (metric.unit === 's') return `${name}: ${val.toFixed(1)}s`;
                  return `${name}: ${val.toFixed(1)}`;
                },
              },
            },
          },
          scales: {
            x: {
              type: 'linear',
              min: xMin,
              max: xMax,
              title: {
                display: true,
                text: 'Games (chronological)',
                color: '#a0a0b8',
                font: { size: 11 },
              },
              ticks: {
                color: '#a0a0b8',
                maxRotation: 45,
                font: { size: 11 },
                callback: function(value: any) {
                  const tick = dateTicks.find(t => t.value === value);
                  return tick ? tick.label : '';
                },
                autoSkip: false,
              },
              afterBuildTicks: function(axis: any) {
                axis.ticks = dateTicks.map(t => ({ value: t.value }));
              },
              grid: { color: 'rgba(15, 52, 96, 0.5)' },
            },
            y: {
              ticks: {
                color: '#a0a0b8',
                font: { size: 11 },
                callback: (val: any) => {
                  if (metric.unit === '%') return val + '%';
                  if (metric.unit === '$') return '$' + val;
                  if (metric.unit === 's') return val + 's';
                  return val;
                },
              },
              grid: { color: 'rgba(15, 52, 96, 0.5)' },
              beginAtZero: true,
            },
          },
        },
      });
    }

    updateChart();
  </script>

  <!-- Model Stats logic (same as old model-stats.astro) -->
  <script>
    // Models with known-unreliable cached_tokens data (upstream API bug).
    // Keys may have a ::effort suffix, so check the model ID prefix.
    const UNRELIABLE_CACHE_MODELS = new Set(['x-ai/grok-4.1-fast']);
    function hasUnreliableCache(key: string): boolean {
      const modelId = key.split('::')[0];
      return UNRELIABLE_CACHE_MODELS.has(modelId);
    }

    const rawData = JSON.parse(document.getElementById('model-stats-data')!.textContent!);
    const models = rawData.models as Record<string, any>;
    const minEpochInput = document.getElementById('min-epoch') as HTMLInputElement;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const tbody = document.getElementById('stats-body') as HTMLTableSectionElement;
    const noResults = document.getElementById('no-results') as HTMLElement;
    const tokenDetailFootnote = document.getElementById('token-detail-footnote') as HTMLElement;
    const errorDetail = document.getElementById('error-detail') as HTMLElement;
    const errorDetailHeading = document.getElementById('error-detail-heading') as HTMLElement;
    const errorDetailBody = document.getElementById('error-detail-body') as HTMLTableSectionElement;
    const headers = document.querySelectorAll('#stats-table th[data-sort]');

    let currentSort = 'timeoutRate';
    let currentSortAsc = false;
    let selectedModelKey: string | null = null;

    const TOKEN_DETAIL_EPOCH = 18;

    interface AggregatedStats {
      key: string;
      modelName: string;
      provider: string;
      gamesPlayed: number;
      totalTimeouts: number;
      totalOtherErrors: number;
      timeoutRate: number;
      contextResets: number;
      successfulResponses: number;
      avgPromptTokens: number;
      avgCompletionTokens: number;
      avgCost: number;
      cacheRate: number;
      reasoningPct: number;
      hasPreTokenDetailData: boolean;
      latencyP50: number;
      latencyP95: number;
      errors: Record<string, number>;
    }

    function aggregate(minEpoch: number): AggregatedStats[] {
      const results: AggregatedStats[] = [];
      for (const [key, model] of Object.entries(models) as [string, any][]) {
        let gamesPlayed = 0, totalCost = 0;
        let totalPrompt = 0, totalCompletion = 0, successfulResponses = 0;
        let totalCached = 0, totalReasoning = 0;
        let hasPreTokenDetailData = false;
        let contextResets = 0;
        let weightedP50 = 0, weightedP95 = 0, totalSamples = 0;
        const errors: Record<string, number> = {};

        for (const [epochStr, bucket] of Object.entries(model.epochs) as [string, any][]) {
          const epochNum = parseInt(epochStr);
          if (epochNum < minEpoch) continue;
          if (epochNum < TOKEN_DETAIL_EPOCH) hasPreTokenDetailData = true;
          gamesPlayed += bucket.gamesPlayed;
          totalCost += bucket.totalCostUsd;
          totalPrompt += bucket.totalPromptTokens;
          totalCompletion += bucket.totalCompletionTokens;
          totalCached += bucket.totalCachedTokens || 0;
          totalReasoning += bucket.totalReasoningTokens || 0;
          successfulResponses += bucket.successfulResponses;
          contextResets += bucket.contextResets;
          const samples = bucket.latencySamples || 0;
          if (samples > 0) {
            weightedP50 += (bucket.latencyP50 || 0) * samples;
            weightedP95 += (bucket.latencyP95 || 0) * samples;
            totalSamples += samples;
          }
          for (const [errType, count] of Object.entries(bucket.errors) as [string, number][]) {
            errors[errType] = (errors[errType] || 0) + (count as number);
          }
        }

        if (gamesPlayed === 0) continue;

        const totalTimeouts = errors['timeout'] || 0;
        const totalOtherErrors = Object.entries(errors)
          .filter(([t]) => t !== 'timeout')
          .reduce((sum, [, c]) => sum + (c as number), 0);
        const totalAttempts = totalTimeouts + successfulResponses;

        results.push({
          key,
          modelName: model.modelName,
          provider: model.provider,
          gamesPlayed,
          totalTimeouts,
          totalOtherErrors,
          timeoutRate: totalAttempts > 0 ? totalTimeouts / totalAttempts : 0,
          contextResets,
          successfulResponses,
          avgPromptTokens: successfulResponses > 0 ? totalPrompt / successfulResponses : 0,
          avgCompletionTokens: successfulResponses > 0 ? totalCompletion / successfulResponses : 0,
          avgCost: gamesPlayed > 0 ? totalCost / gamesPlayed : 0,
          cacheRate: hasUnreliableCache(key) ? -1 : (totalPrompt > 0 ? totalCached / totalPrompt : 0),
          reasoningPct: totalCompletion > 0 ? totalReasoning / totalCompletion : 0,
          hasPreTokenDetailData,
          latencyP50: totalSamples > 0 ? weightedP50 / totalSamples : 0,
          latencyP95: totalSamples > 0 ? weightedP95 / totalSamples : 0,
          errors,
        });
      }
      return results;
    }

    function timeoutRateClass(rate: number): string {
      if (rate < 0.02) return 'rate-good';
      if (rate < 0.10) return 'rate-ok';
      return 'rate-bad';
    }

    function render() {
      const minEpoch = parseInt(minEpochInput.value) || 1;
      const searchTerm = searchInput.value.toLowerCase().trim();
      let stats = aggregate(minEpoch);

      if (searchTerm) {
        stats = stats.filter(s => s.modelName.toLowerCase().includes(searchTerm));
      }

      stats.sort((a, b) => {
        const va = (a as any)[currentSort];
        const vb = (b as any)[currentSort];
        if (typeof va === 'string') {
          const cmp = va.toLowerCase().localeCompare(vb.toLowerCase());
          return currentSortAsc ? cmp : -cmp;
        }
        return currentSortAsc ? va - vb : vb - va;
      });

      tbody.innerHTML = '';
      for (const s of stats) {
        const tr = document.createElement('tr');
        tr.dataset.key = s.key;
        if (s.key === selectedModelKey) tr.classList.add('selected');
        tr.innerHTML = `
          <td class="model-name">${esc(s.modelName)}</td>
          <td>${esc(s.provider)}</td>
          <td class="num">${s.gamesPlayed}</td>
          <td class="num"><span class="${timeoutRateClass(s.timeoutRate)}">${(s.timeoutRate * 100).toFixed(1)}%</span></td>
          <td class="num">${s.totalTimeouts}</td>
          <td class="num">${s.totalOtherErrors}</td>
          <td class="num">${s.contextResets}</td>
          <td class="num">${Math.round(s.avgPromptTokens).toLocaleString()}</td>
          <td class="num">${Math.round(s.avgCompletionTokens).toLocaleString()}</td>
          <td class="num">$${s.avgCost.toFixed(2)}</td>
          <td class="num">${s.cacheRate < 0 ? '*' : s.cacheRate > 0 ? (s.cacheRate * 100).toFixed(1) + '%' : '-'}${s.hasPreTokenDetailData ? '*' : ''}</td>
          <td class="num">${s.reasoningPct > 0 ? (s.reasoningPct * 100).toFixed(1) + '%' : '-'}${s.hasPreTokenDetailData ? '*' : ''}</td>
          <td class="num">${s.latencyP50.toFixed(1)}</td>
          <td class="num">${s.latencyP95.toFixed(1)}</td>
        `;
        tr.addEventListener('click', () => showErrorDetail(s));
        tbody.appendChild(tr);
      }

      noResults.style.display = stats.length === 0 ? '' : 'none';
      tokenDetailFootnote.style.display = stats.some(s => s.hasPreTokenDetailData) ? '' : 'none';

      if (selectedModelKey) {
        const selected = stats.find(s => s.key === selectedModelKey);
        if (selected) {
          renderErrorDetail(selected);
        } else {
          errorDetail.style.display = 'none';
          selectedModelKey = null;
        }
      }
    }

    function esc(s: string): string {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    function showErrorDetail(s: AggregatedStats) {
      selectedModelKey = s.key;
      tbody.querySelectorAll('tr').forEach(r => r.classList.remove('selected'));
      const row = tbody.querySelector(`tr[data-key="${CSS.escape(s.key)}"]`);
      if (row) row.classList.add('selected');
      renderErrorDetail(s);
    }

    function renderErrorDetail(s: AggregatedStats) {
      errorDetailHeading.textContent = `Error Breakdown: ${s.modelName}`;
      errorDetailBody.innerHTML = '';

      const entries = Object.entries(s.errors).sort((a, b) => (b[1] as number) - (a[1] as number));
      if (entries.length === 0) {
        errorDetailBody.innerHTML = '<tr><td colspan="2" class="empty">No errors</td></tr>';
      } else {
        for (const [errType, count] of entries) {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${esc(errType)}</td><td class="num">${count}</td>`;
          errorDetailBody.appendChild(tr);
        }
      }
      errorDetail.style.display = '';
    }

    // Sorting
    headers.forEach(th => {
      th.addEventListener('click', () => {
        const el = th as HTMLElement;
        const column = el.dataset.sort!;
        const type = el.dataset.type!;

        const wasSorted = th.classList.contains('sorted');
        const wasAsc = th.classList.contains('asc');
        const ascending = wasSorted ? !wasAsc : (type === 'string');

        headers.forEach(h => {
          h.classList.remove('sorted', 'asc', 'desc');
          const arrow = h.querySelector('.sort-arrow');
          if (arrow) arrow.textContent = '';
        });

        th.classList.add('sorted', ascending ? 'asc' : 'desc');
        let arrow = th.querySelector('.sort-arrow');
        if (!arrow) {
          arrow = document.createElement('span');
          arrow.className = 'sort-arrow';
          th.appendChild(arrow);
        }
        arrow.textContent = ascending ? '\u25B2' : '\u25BC';

        currentSort = column;
        currentSortAsc = ascending;
        render();
      });
    });

    minEpochInput.addEventListener('input', render);
    searchInput.addEventListener('input', render);
    render();
  </script>

  <!-- Blunder Analysis chart -->
  <script>
    import { Chart, registerables } from 'chart.js';
    Chart.register(...registerables);

    interface BlunderRun {
      gameId: string;
      ts: string;
      version: number;
      model: string;
      decisionsAnalyzed: number;
      promptTokens: number;
      completionTokens: number;
      cachedTokens: number;
      costUsd: number;
    }

    const blunderRaw = JSON.parse(document.getElementById('blunder-data')!.textContent!) as {
      runs: BlunderRun[];
    };

    const BLUNDER_METRICS: Record<string, {
      label: string;
      unit: string;
      compute: (r: BlunderRun) => number | null;
    }> = {
      cacheRate: {
        label: 'Cache Rate',
        unit: '%',
        compute: (r) => r.promptTokens > 0 ? (r.cachedTokens / r.promptTokens) * 100 : null,
      },
      cost: {
        label: 'Cost',
        unit: '$',
        compute: (r) => r.costUsd,
      },
      promptTokens: {
        label: 'Prompt Tokens',
        unit: '',
        compute: (r) => r.promptTokens,
      },
      decisions: {
        label: 'Decisions Analyzed',
        unit: '',
        compute: (r) => r.decisionsAnalyzed,
      },
    };

    let blunderMetric = 'cacheRate';
    let blunderMinVersion = 1;
    let blunderChart: Chart | null = null;

    const blunderCanvas = document.getElementById('blunder-chart') as HTMLCanvasElement;
    const blunderNote = document.getElementById('blunder-chart-note') as HTMLElement;

    // Metric button switching
    document.querySelectorAll('#blunder-metric-buttons .metric-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#blunder-metric-buttons .metric-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        blunderMetric = btn.getAttribute('data-metric')!;
        updateBlunderChart();
      });
    });

    const blunderMinVersionInput = document.getElementById('blunder-min-version') as HTMLInputElement;
    blunderMinVersionInput.addEventListener('input', () => {
      blunderMinVersion = parseInt(blunderMinVersionInput.value) || 1;
      updateBlunderChart();
    });

    function updateBlunderChart() {
      const metric = BLUNDER_METRICS[blunderMetric];
      const filtered = blunderRaw.runs
        .filter(r => r.version >= blunderMinVersion && r.ts)
        .sort((a, b) => a.ts.localeCompare(b.ts));

      const points: { x: number; y: number; label: string }[] = [];
      filtered.forEach((r, i) => {
        const val = metric.compute(r);
        if (val !== null) {
          const date = new Date(r.ts);
          const dateStr = `${date.getMonth() + 1}/${date.getDate()}`;
          points.push({ x: i, y: val, label: `${r.gameId}\n${dateStr} v${r.version}` });
        }
      });

      // Date labels for x-axis
      const dateLabels = new Map<number, Date>();
      filtered.forEach((r, i) => dateLabels.set(i, new Date(r.ts)));

      blunderNote.textContent = `${filtered.length} annotation run(s)`;

      if (blunderChart) blunderChart.destroy();

      blunderChart = new Chart(blunderCanvas, {
        type: 'scatter',
        data: {
          datasets: [{
            label: metric.label,
            data: points,
            backgroundColor: 'rgba(233, 69, 96, 0.6)',
            borderColor: '#e94560',
            pointRadius: 4,
            pointHoverRadius: 6,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const p = ctx.raw as { x: number; y: number; label: string };
                  const val = metric.unit === '%' ? p.y.toFixed(1) + '%'
                    : metric.unit === '$' ? '$' + p.y.toFixed(3)
                    : p.y.toLocaleString();
                  return `${p.label}: ${val}`;
                },
              },
            },
          },
          scales: {
            x: {
              type: 'linear',
              title: { display: true, text: 'Annotation Run', color: '#a0a0b8' },
              ticks: {
                color: '#a0a0b8',
                callback: function(value: string | number) {
                  const idx = typeof value === 'string' ? parseInt(value) : value;
                  const d = dateLabels.get(idx);
                  return d ? `${d.getMonth() + 1}/${d.getDate()}` : '';
                },
              },
              grid: { color: 'rgba(255,255,255,0.05)' },
            },
            y: {
              title: {
                display: true,
                text: metric.unit ? `${metric.label} (${metric.unit})` : metric.label,
                color: '#a0a0b8',
              },
              ticks: { color: '#a0a0b8' },
              grid: { color: 'rgba(255,255,255,0.05)' },
            },
          },
        },
      });
    }

    updateBlunderChart();
  </script>
</Base>

