---
import Base from '../../layouts/Base.astro';
import GameReplayView from '../../components/GameReplayView.astro';
import type { GameEntry } from '../../utils/load-games';
import { loadAllGames } from '../../utils/load-games';
import { loadFullGame } from '../../utils/load-full-game';
import { prerenderTimeline } from '../../utils/prerender-timeline';
import { loadBenchmarkResults } from '../../utils/season-data';

const minBlunderVersion = loadBenchmarkResults().minBlunderVersion;
const auditMode = !!process.env.AUDIT_API_PORT;

interface Props {
  game: GameEntry;
}

export function getStaticPaths() {
  return loadAllGames().map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props as Props;

// Load full game JSON and prerender the action log at build time
const fullGame = loadFullGame(game.id);
const prerendered = prerenderTimeline(fullGame);
---

<Base title={game.replayTitle} wide>
  <GameReplayView
    game={game}
    fullGame={fullGame}
    prerendered={prerendered}
    minBlunderVersion={minBlunderVersion}
    auditMode={auditMode}
  />
</Base>
