---
import Base from '../layouts/Base.astro';
import benchmarkData from '../data/benchmark-results.json';
import seasonData from '../data/season.json';
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';

const currentSeason = (seasonData as any).current_season;
const seasonPhase = (seasonData as any).phase;
const phaseLabel = seasonPhase === 'tournament' ? 'Tournament' : 'Regular Season';

const DECK_TYPE_FORMATS: Record<string, string> = {
  "Constructed - Standard": "standard",
  "Constructed - Modern": "modern",
  "Constructed - Legacy": "legacy",
  "Variant Magic - Freeform Commander": "commander",
  "Variant Magic - Commander": "commander",
  "Limited": "jumpstart",
};

const FORMAT_DISPLAY: Record<string, string> = {
  standard: "Standard",
  modern: "Modern",
  legacy: "Legacy",
  commander: "Commander (Exhibition)",
  jumpstart: "Jumpstart",
};

// Season 1 championship data
const tournamentPath = path.join(process.cwd(), '..', 'data', 'tournaments', 'season-1.json');
const tournament = JSON.parse(fs.readFileSync(tournamentPath, 'utf-8'));
const entrantsBySeed: Record<number, any> = {};
for (const e of tournament.entrants) {
  entrantsBySeed[e.seed] = e;
}
const finalsRound = tournament.rounds[tournament.rounds.length - 1];
const finalsMatch = finalsRound.matches[0];
const champion = entrantsBySeed[finalsMatch.winner_seed];
const runnerUpSeed = finalsMatch.seed_a === finalsMatch.winner_seed ? finalsMatch.seed_b : finalsMatch.seed_a;
const runnerUp = entrantsBySeed[runnerUpSeed];
const champWins = finalsMatch.games.filter((g: any) => g.winner_seed === finalsMatch.winner_seed).length;
const runnerUpWins = finalsMatch.games.filter((g: any) => g.winner_seed === runnerUpSeed).length;

// Stats
const formats: Record<string, any> = (benchmarkData as any).formats ?? {};
const combinedModels = (benchmarkData as any).models ?? [];
const top5 = combinedModels.slice(0, 5);
const totalGames = benchmarkData.totalGames;

const allModelIds = new Set<string>();
for (const [, fmt] of Object.entries(formats)) {
  for (const m of ((fmt as any).models ?? [])) {
    allModelIds.add(m.modelId);
  }
}
// Fallback: count from top-level models if formats is empty
if (allModelIds.size === 0) {
  for (const m of combinedModels) {
    allModelIds.add(m.modelId);
  }
}
const totalModels = allModelIds.size;
const formatCount = Object.keys(formats).filter(f => f !== 'combined' && ((formats[f] as any)?.totalGames ?? 0) > 0).length || 5;

// Recent games — 3 most recent 1v1 and 3 most recent commander
const gamesDir = path.join(process.cwd(), 'public', 'games');
const recentDuels: Array<Record<string, any>> = [];
const recentCommander: Array<Record<string, any>> = [];
if (fs.existsSync(gamesDir)) {
  const files = fs.readdirSync(gamesDir)
    .filter((f: string) => f.startsWith('game_'))
    .sort()
    .reverse();
  for (const file of files) {
    if (recentDuels.length >= 3 && recentCommander.length >= 3) break;
    let data;
    if (file.endsWith('.json') && !file.endsWith('.json.gz')) {
      data = JSON.parse(fs.readFileSync(path.join(gamesDir, file), 'utf-8'));
    } else if (file.endsWith('.json.gz')) {
      const jsonPath = path.join(gamesDir, file.replace('.json.gz', '.json'));
      if (fs.existsSync(jsonPath)) continue;
      const compressed = fs.readFileSync(path.join(gamesDir, file));
      data = JSON.parse(zlib.gunzipSync(compressed).toString());
    } else {
      continue;
    }
    const formatKey = DECK_TYPE_FORMATS[data.deckType] || 'commander';
    const entry = {
      id: data.id,
      format: formatKey,
      formatLabel: FORMAT_DISPLAY[formatKey] || formatKey,
      winner: data.winner,
      totalTurns: data.totalTurns,
      players: (data.players || []).map((p: any) => ({
        name: p.name,
        model: p.model ? (p.model.includes('/') ? p.model.split('/').pop() : p.model) : '',
      })),
    };
    if (formatKey === 'commander') {
      if (recentCommander.length < 3) recentCommander.push(entry);
    } else {
      if (recentDuels.length < 3) recentDuels.push(entry);
    }
  }
}
---

<Base title="Home">
  <section class="hero">
    <h1>mage-bench</h1>
    <p class="tagline">LLMs play Magic: The Gathering.</p>
    <a href={`/season/${currentSeason}`} class="season-status" data-phase={seasonPhase}>
      <span class="season-status-label">Season {currentSeason}</span>
      <span class="season-status-separator"></span>
      <span class="season-status-phase">{phaseLabel}</span>
    </a>
  </section>

  <a href="/season/1/results" class="champ-banner">
    <span class="champ-eyebrow">Season 1 Champion</span>
    <span class="champ-name">{champion.display_name}</span>
    <span class="champ-finals">
      Finals: def. {runnerUp.display_name} ({champWins}–{runnerUpWins})
    </span>
    <span class="champ-cta">View full bracket &rarr;</span>
  </a>

  <section class="intro">
    <p>
      mage-bench is a fork of <a href="https://github.com/magefree/mage">XMage</a>
      that enables large language models to play Magic: The Gathering against each
      other across multiple formats — Jumpstart, Standard, Modern, Legacy, and Commander.
    </p>
    <p>
      The XMage game server presents each LLM with the current game state and available
      actions. The LLM chooses what to do, and the game engine enforces the rules. No
      shortcuts, no simplified rulesets — the full complexity of Magic.
    </p>
  </section>

  <section class="links">
    <a href={`/season/${currentSeason}/rankings`}>Leaderboard</a>
    <a href="/games">Watch games</a>
    <a href="https://github.com/GregorStocks/mage-bench">GitHub</a>
  </section>

  <section class="stats-strip">
    <p class="stats-qualifier">Season {currentSeason}</p>
    <div class="stats-cards">
      <div class="stat-card">
        <span class="stat-number">{totalGames}</span>
        <span class="stat-label">Games Played</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{totalModels}</span>
        <span class="stat-label">Models Tested</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">{formatCount}</span>
        <span class="stat-label">Formats</span>
      </div>
    </div>
  </section>

  {top5.length > 0 && (
    <section class="leaderboard-preview">
      <h2>Top Models <a href={`/season/${currentSeason}/rankings`} class="section-link">Full leaderboard &rarr;</a></h2>
      <div class="mini-leaderboard">
        {top5.map((m: any, i: number) => (
          <div class:list={['mini-row', { 'mini-gold': i === 0, 'mini-silver': i === 1, 'mini-bronze': i === 2 }]}>
            <span class="mini-rank">{i + 1}</span>
            <div class="mini-info">
              <span class="mini-name">{m.modelName}</span>
              <span class="mini-provider">{m.provider}</span>
            </div>
            <span class="mini-rating">{m.rating}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {recentDuels.length > 0 && (
    <section class="recent-games">
      <h2>Recent 1v1 Games <a href="/games" class="section-link">All games &rarr;</a></h2>
      <div class="game-strip">
        {recentDuels.map((game) => (
          <a href={`/games/${game.id}`} class="mini-game-card" data-format={game.format}>
            <div class="mgc-header">
              <span class={`mgc-format mgc-format-${game.format}`}>{game.formatLabel}</span>
              <span class="mgc-turns">{game.totalTurns} turns</span>
            </div>
            <div class="mgc-players">
              {game.players.map((p: any) => (
                <div class:list={['mgc-player', { 'mgc-winner': p.name === game.winner }]}>
                  <span class="mgc-pname">{p.name}</span>
                  {p.name === game.winner && <span class="mgc-winner-label">WINNER</span>}
                </div>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {recentCommander.length > 0 && (
    <section class="recent-games">
      <h2>Recent Exhibition Games <a href="/games?format=commander" class="section-link">All exhibition &rarr;</a></h2>
      <div class="game-strip">
        {recentCommander.map((game) => (
          <a href={`/games/${game.id}`} class="mini-game-card" data-format={game.format}>
            <div class="mgc-header">
              <span class={`mgc-format mgc-format-${game.format}`}>{game.formatLabel}</span>
              <span class="mgc-turns">{game.totalTurns} turns</span>
            </div>
            <div class="mgc-players">
              {game.players.map((p: any) => (
                <div class:list={['mgc-player', { 'mgc-winner': p.name === game.winner }]}>
                  <span class="mgc-pname">{p.name}</span>
                  {p.name === game.winner && <span class="mgc-winner-label">WINNER</span>}
                </div>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0 1.5rem;
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .tagline {
    font-size: 1.35rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    font-weight: 500;
  }

  .season-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(var(--accent-primary-rgb), 0.08);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.25);
    border-radius: 100px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .season-status:hover {
    border-color: var(--accent-primary);
  }

  .season-status[data-phase="tournament"] {
    background: rgba(233, 69, 96, 0.08);
    border-color: rgba(233, 69, 96, 0.25);
  }

  .season-status-label {
    color: var(--accent-primary);
  }

  .season-status[data-phase="tournament"] .season-status-label {
    color: var(--accent-primary);
  }

  .season-status-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-secondary);
    opacity: 0.5;
  }

  .season-status-phase {
    color: var(--text-secondary);
  }

  .season-status[data-phase="tournament"] .season-status-phase {
    color: var(--accent-primary);
  }

  /* Championship banner */
  .champ-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    position: relative;
    max-width: 32rem;
    margin: 2rem auto 2.5rem;
    padding: 2rem 2rem 1.6rem;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 215, 0, 0.06) 0%, transparent 70%),
      var(--bg-surface);
    border: 1px solid rgba(255, 215, 0, 0.18);
    border-radius: 12px;
    text-decoration: none;
    text-align: center;
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
  }

  .champ-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      #ffd700 30%,
      #fff8dc 50%,
      #ffd700 70%,
      transparent
    );
    border-radius: 2px;
  }

  .champ-banner:hover {
    border-color: rgba(255, 215, 0, 0.45);
    transform: translateY(-2px);
  }

  .champ-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #ffd700;
  }

  .champ-name {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0.15rem 0;
  }

  .champ-finals {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .champ-cta {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .champ-banner:hover .champ-cta {
    color: #ffd700;
  }

  @media (max-width: 600px) {
    .champ-banner {
      margin: 1.5rem 0 2rem;
      padding: 1.5rem 1.2rem 1.2rem;
    }

    .champ-name {
      font-size: 1.25rem;
    }
  }

  .intro {
    font-size: 1.05rem;
    line-height: 1.75;
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
    color: var(--text-secondary);
  }

  .intro p {
    margin-bottom: 1rem;
  }

  .intro a {
    color: var(--accent-primary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 0;
  }

  .links a {
    padding: 0.7rem 1.5rem;
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    transition: border-color 0.15s, background 0.15s;
  }

  .links a:hover {
    border-color: var(--accent-primary);
    background: rgba(var(--accent-primary-rgb), 0.1);
  }

  /* Stats strip */
  .stats-strip {
    padding: 1.5rem 0 2.5rem;
    text-align: center;
  }

  .stats-qualifier {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .stats-cards {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .stat-card {
    text-align: center;
    padding: 1.2rem 2rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    min-width: 140px;
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Leaderboard preview */
  .leaderboard-preview {
    padding: 0 0 2.5rem;
  }

  .leaderboard-preview h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    letter-spacing: -0.01em;
  }

  .section-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    margin-left: auto;
  }

  .section-link:hover {
    color: var(--text-primary);
  }

  .mini-leaderboard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mini-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 6px;
    transition: border-color 0.2s;
  }

  .mini-row:hover {
    border-color: var(--accent-primary);
  }

  .mini-gold {
    border-left: 3px solid #ffd700;
    background: linear-gradient(to right, rgba(255, 215, 0, 0.06), var(--bg-surface) 40%);
  }

  .mini-silver {
    border-left: 3px solid #c0c0c0;
    background: linear-gradient(to right, rgba(192, 192, 192, 0.04), var(--bg-surface) 40%);
  }

  .mini-bronze {
    border-left: 3px solid #cd7f32;
    background: linear-gradient(to right, rgba(205, 127, 50, 0.04), var(--bg-surface) 40%);
  }

  .mini-rank {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-muted);
    min-width: 1.5rem;
    text-align: center;
  }

  .mini-gold .mini-rank { color: #ffd700; }
  .mini-silver .mini-rank { color: #c0c0c0; }
  .mini-bronze .mini-rank { color: #cd7f32; }

  .mini-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .mini-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .mini-provider {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .mini-rating {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  /* Recent games */
  .recent-games {
    padding: 0 0 2rem;
  }

  .recent-games h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    letter-spacing: -0.01em;
  }

  .game-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .mini-game-card {
    display: block;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .mini-game-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .mini-game-card[data-format="standard"] { border-left: 3px solid var(--format-standard); }
  .mini-game-card[data-format="modern"] { border-left: 3px solid var(--format-modern); }
  .mini-game-card[data-format="legacy"] { border-left: 3px solid var(--format-legacy); }
  .mini-game-card[data-format="commander"] { border-left: 3px solid var(--format-commander); }
  .mini-game-card[data-format="jumpstart"] { border-left: 3px solid var(--format-jumpstart); }

  .mgc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.85rem;
  }

  .mgc-format {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .mgc-format-standard { background: rgba(76, 175, 80, 0.15); color: var(--format-standard); }
  .mgc-format-modern { background: rgba(33, 150, 243, 0.15); color: var(--format-modern); }
  .mgc-format-legacy { background: rgba(156, 39, 176, 0.15); color: var(--format-legacy); }
  .mgc-format-commander { background: rgba(255, 152, 0, 0.15); color: var(--format-commander); }
  .mgc-format-jumpstart { background: rgba(233, 69, 96, 0.15); color: var(--format-jumpstart); }

  .mgc-turns {
    color: var(--text-secondary);
  }

  .mgc-players {
    padding: 0.5rem 0.75rem;
  }

  .mgc-player {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0;
    font-size: 0.9rem;
  }

  .mgc-winner {
    font-weight: 700;
  }

  .mgc-pname {
    color: var(--text-primary);
  }

  .mgc-winner .mgc-pname {
    color: var(--color-success);
  }

  .mgc-winner-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--bg-base);
    background: var(--color-success);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    margin-left: auto;
  }

  @media (max-width: 600px) {
    .stats-cards {
      gap: 0.75rem;
    }

    .stat-card {
      min-width: auto;
      flex: 1;
      padding: 0.8rem 0.5rem;
    }

    .stat-number {
      font-size: 1.6rem;
    }

    .game-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
