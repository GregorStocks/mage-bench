  }

  #player-filter, #event-type-filter {
    background: #0f3460;
    color: #e0e0e0;
    border: 1px solid #1a4a8a;
    border-radius: 4px;
    padding: 0.2rem 0.3rem;
    font-size: 0.72rem;
    cursor: pointer;
  }

  #llm-toggle-label {
    font-size: 0.72rem;
    color: #888;
    cursor: pointer;
    user-select: none;
  }

