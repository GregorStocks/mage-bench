---
import type { TournamentMatch, TournamentRound } from '../../../utils/season-data';
import {
  buildAllSeasonStaticPaths,
  parseRequiredSeasonParam,
} from '../../../utils/season-pages';
import { hasTournament, loadTournament } from '../../../utils/season-data';

export function getStaticPaths() {
  return buildAllSeasonStaticPaths();
}

const seasonNum = parseRequiredSeasonParam(Astro.params.season);

// Determine redirect target based on precedence:
// 1. Championship results (if tournament has any match results)
// 2. Championship entrants (if tournament exists)
// 3. Regular season rankings (default)
let target = 'rankings';

if (hasTournament(seasonNum)) {
  const tournament = loadTournament(seasonNum);
  const hasResults = tournament.rounds?.some((r: TournamentRound) =>
    r.matches?.some((m: TournamentMatch) => m.winner_seed != null)
  );
  if (hasResults) {
    target = 'results';
  } else {
    target = 'entrants';
  }
}

const redirectUrl = `/season/${seasonNum}/${target}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={redirectUrl} />
    <title>Season {seasonNum} | mage-bench</title>
    <script is:inline define:vars={{ redirectUrl }}>
      window.location.replace(redirectUrl);
    </script>
    <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
  </head>
  <body></body>
</html>
