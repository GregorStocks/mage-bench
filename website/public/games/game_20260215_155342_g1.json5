      "decision_index": 168,
    },
    {
      "severity": "minor",
      "description": "When returning a land due to Rakdos Carnarium's ETB trigger, bouncing a basic Plains is slightly suboptimal compared to bouncing Akoum Refuge. Since the land drop was already used this turn, the bounced land can't be replayed immediately regardless. Bouncing Akoum Refuge would let the player gain 1 life again when replaying it later, providing small incremental value at no cost.",
      "action_taken": "Chose to return a Plains to hand",
      "better_line": "Return Akoum Refuge to hand to get the 1 life ETB trigger again when replaying it later",
      "type": "blunder",
      "snapshot_index": 188,
