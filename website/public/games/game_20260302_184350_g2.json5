"id\":\"p34\",\"power\":\"1\",\"toughness\":\"1\",\"summoning_sick\":true},{\"tapped\":true,\"name\":\"Thriving Heath\",\"rules\":[\"{this} enters tapped.\",\"As {this} enters, choose a color other than white.\",\"{T}: Add {W}.\",\"{T}: Add one mana of the chosen color.\",\"Chosen color: Red\"],\"id\":\"p16\"}],\"name\":\"MstMed Sarge\",\"library_size\":30,\"life\":18}]}",
