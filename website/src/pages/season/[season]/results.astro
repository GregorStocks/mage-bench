<script is:inline>
  (function() {
    var scroll = document.querySelector('.bracket-horizontal .bracket-scroll');
    var bracket = scroll && scroll.querySelector('.bracket-two-sided');
    if (!scroll || !bracket) return;
    bracket.style.transformOrigin = 'top left';
    function update() {
      bracket.style.transform = 'none';
      scroll.style.height = '';
      var natural = bracket.scrollWidth;
      var available = scroll.clientWidth;
      if (natural === 0 || available === 0) return;
      var scale = Math.min(1, available / natural);
      if (scale < 1) {
        bracket.style.transform = 'scale(' + scale + ')';
      }
      scroll.style.height = bracket.scrollHeight * scale + 'px';
    }
    new ResizeObserver(update).observe(scroll);
  })();
</script>
