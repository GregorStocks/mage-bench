---
import Base from '../../../layouts/Base.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import benchmarkData from '../../../data/benchmark-results.json';
import fs from 'node:fs';
import path from 'node:path';

const availableSeasons: number[] = (benchmarkData as any).availableSeasons ?? [];

export function getStaticPaths() {
  const data = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'src', 'data', 'benchmark-results.json'), 'utf-8')
  );
  const seasons: number[] = data.availableSeasons ?? [];
  return seasons
    .filter(s => {
      const tp = path.join(process.cwd(), '..', 'data', 'tournaments', `season-${s}.json`);
      if (!fs.existsSync(tp)) return false;
      const t = JSON.parse(fs.readFileSync(tp, 'utf-8'));
      return !!t.draft;
    })
    .map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

const tournamentPath = path.join(process.cwd(), '..', 'data', 'tournaments', `season-${seasonNum}.json`);
const tournament = JSON.parse(fs.readFileSync(tournamentPath, 'utf-8'));

const entrantsBySeed: Record<number, any> = {};
for (const e of tournament.entrants) {
  entrantsBySeed[e.seed] = e;
}

function cleanThemeName(name: string): string {
  return name.replace(/^J22 /, '');
}
---

<Base title={`Season ${seasonNum} Championship Draft`} wide>
  <SeasonNav season={seasonNum} active="draft" hasTournament={true} hasDraft={true} />

  <div class="draft-page">
    <h2>Draft</h2>
    <div class="draft-stats-bar">
      <span>{tournament.draft.picks.length} picks</span>
      <span class="draft-stat-sep">&middot;</span>
      <span>{tournament.draft.pool.length} packs in pool</span>
      <span class="draft-stat-sep">&middot;</span>
      <span>${tournament.draft.total_cost_usd.toFixed(2)} total cost</span>
    </div>
    {[1, 2].map((roundNum: number) => {
      const roundPicks = tournament.draft.picks
        .map((p: any, idx: number) => ({ ...p, _idx: idx }))
        .filter((p: any) => p.round === roundNum);
      return (
        <div class={`draft-round draft-round-${roundNum}`}>
          <div class="draft-round-header">
            <span class="draft-round-label">Round {roundNum}</span>
            <span class="draft-round-count">{roundPicks.length} picks</span>
          </div>
          <div class="draft-round-picks">
            {roundPicks.map((pick: any) => {
              const ent = entrantsBySeed[pick.seed];
              const previewSrc = pick.thinking || (pick.reasoning?.length > 10 ? pick.reasoning : null);
              const preview = previewSrc ? previewSrc.slice(0, 300).replace(/\*+/g, '') : null;
              return (
                <div class="dpick">
                  <button class="dpick-row" type="button" aria-expanded="false">
                    <span class="dpick-num">{pick._idx + 1}</span>
                    <span class="dpick-player">
                      <span class="dpick-seed">#{pick.seed}</span>
                      <span class="dpick-name">{ent?.display_name || `Seed ${pick.seed}`}</span>
                    </span>
                    <span class="dpick-chose">{cleanThemeName(pick.picked)}</span>
                    <span class="dpick-cost">${pick.cost_usd.toFixed(2)}</span>
                    <span class="dpick-chevron">&#9656;</span>
                  </button>
                  {preview && (
                    <div class="dpick-preview">{preview}</div>
                  )}
                  <div class="dpick-detail" hidden>
                    {pick.thinking && (
                      <details class="dpick-logic" open>
                        <summary class="dpick-detail-label clickable">Logic</summary>
                        <div class="dpick-logic-text">{pick.thinking}</div>
                      </details>
                    )}
                    <div class="dpick-decision">
                      <div class="dpick-detail-label">Decision</div>
                      <div class="dpick-decision-text">{pick.reasoning}</div>
                    </div>
                    <div class="dpick-pool">
                      <div class="dpick-detail-label">Available ({pick.options.length} packs)</div>
                      <div class="dpick-pool-tags">
                        {pick.options.map((opt: string) => (
                          <span class:list={['dpick-tag', { 'dpick-tag-picked': opt === pick.picked }]}>
                            {cleanThemeName(opt)}
                          </span>
                        ))}
                      </div>
                    </div>
                    <div class="dpick-meta">
                      {pick.usage.prompt_tokens.toLocaleString()} prompt &middot; {pick.usage.completion_tokens.toLocaleString()} completion tokens
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</Base>

<style>
  h2 {
    font-family: var(--font-heading);
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .draft-page {
    max-width: 1000px;
  }

  .draft-stats-bar {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .draft-stat-sep {
    color: var(--text-muted);
  }

  .draft-round {
    margin-bottom: 1.5rem;
  }

  .draft-round-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--border-default);
  }

  .draft-round-label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-secondary);
  }

  .draft-round-2 .draft-round-label {
    color: var(--accent-primary);
  }

  .draft-round-count {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .draft-round-picks {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dpick {
    border-left: 3px solid var(--accent-secondary);
    background: var(--bg-surface);
    border-radius: 0 4px 4px 0;
    overflow: hidden;
  }

  .draft-round-2 .dpick {
    border-left-color: var(--accent-primary);
  }

  .dpick-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.4rem 0.75rem;
    background: none;
    border: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s;
  }

  .dpick-row:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .dpick-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    min-width: 1.8rem;
    text-align: right;
    flex-shrink: 0;
  }

  .dpick-player {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    flex: 1;
  }

  .dpick-seed {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .dpick-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.85rem;
  }

  .dpick-chose {
    color: var(--accent-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .draft-round-2 .dpick-chose {
    color: var(--accent-primary);
  }

  .dpick-cost {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .dpick-chevron {
    color: var(--text-muted);
    font-size: 0.7rem;
    transition: transform 0.15s;
    flex-shrink: 0;
  }

  .dpick.open .dpick-chevron {
    transform: rotate(90deg);
  }

  .dpick-detail {
    padding: 0.5rem 0.75rem 0.75rem 2.8rem;
    border-top: 1px solid var(--border-subtle);
  }

  .dpick-detail-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .dpick-detail-label.clickable {
    cursor: pointer;
    user-select: none;
  }

  .dpick-preview {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
    padding: 0 0.75rem 0.4rem 2.8rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
  }

  .dpick-preview:hover {
    color: var(--text-secondary);
  }

  .dpick.open .dpick-preview {
    display: none;
  }

  .dpick-logic,
  .dpick-decision {
    margin-bottom: 0.75rem;
  }

  .dpick-logic-text,
  .dpick-decision-text {
    font-size: 0.8rem;
    color: var(--text-primary);
    line-height: 1.4;
    white-space: pre-wrap;
  }

  .dpick-logic-text {
    margin-top: 0.25rem;
  }

  .dpick-pool {
    margin-bottom: 0.5rem;
  }

  .dpick-pool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .dpick-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    background: var(--bg-elevated);
    color: var(--text-secondary);
  }

  .dpick-tag-picked {
    background: rgba(20, 184, 166, 0.15);
    color: var(--accent-secondary);
    font-weight: 600;
  }

  .draft-round-2 .dpick-tag-picked {
    background: rgba(233, 69, 96, 0.15);
    color: var(--accent-primary);
  }

  .dpick-meta {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .dpick-player {
      min-width: 0;
      flex: 0 1 auto;
    }

    .dpick-cost {
      display: none;
    }

    .dpick-detail {
      padding-left: 1rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.dpick-row, .dpick-preview');
    if (!btn) return;
    var card = btn.closest('.dpick');
    var detail = card.querySelector('.dpick-detail');
    if (!detail) return;
    var isOpen = !detail.hidden;
    detail.hidden = isOpen;
    card.classList.toggle('open', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
