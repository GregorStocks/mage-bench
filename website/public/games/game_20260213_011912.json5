    },
    "Kinscaer Sentry": {
      "mana_cost": "{1}{W}",
      "type_line": "Creature — Kithkin Soldier",
      "oracle_text": "First strike, lifelink\nWhenever this creature attacks, you may put a creature card with mana value X or less from your hand onto the battlefield tapped and attacking, where X is the number of attacking creatures you control.",
      "power": "2",
      "toughness": "2"
    },
    "Loch Mare": {
      "mana_cost": "{1}{U}",
      "type_line": "Creature — Horse Serpent",
      "oracle_text": "This creature enters with three -1/-1 counters on it.\n{1}{U}, Remove a counter from this creature: Draw a card.\n{2}{U}, Remove two counters from this creature: Tap target creature. Put a stun counter on it. (If a permanent with a stun counter would become untapped, remove one from it instead.)",
      "power": "4",
      "toughness": "5"
    },
    "Marsh Flats": {
