---
import Base from '../../layouts/Base.astro';
import GameReplayView from '../../components/GameReplayView.astro';
import benchmarkData from '../../data/benchmark-results.json';
import type { GameEntry } from '../../utils/load-games';
import { loadAllGames } from '../../utils/load-games';

const minBlunderVersion = (benchmarkData as any).minBlunderVersion ?? 11;
const auditMode = !!process.env.AUDIT_API_PORT;

interface Props {
  game: GameEntry;
}

export function getStaticPaths() {
  return loadAllGames().map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props as Props;
---

<Base title={game.replayTitle} wide>
  <GameReplayView game={game} minBlunderVersion={minBlunderVersion} auditMode={auditMode} />
</Base>
