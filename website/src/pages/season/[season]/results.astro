---
import Base from '../../../layouts/Base.astro';
import GameListCard from '../../../components/GameListCard.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import {
  getTournamentDeckName,
  loadSeasonGameEntries,
  loadSeasonTournamentContext,
  parseRequiredSeasonParam,
  buildTournamentSeasonStaticPaths,
} from '../../../utils/season-pages';
import {
  loadBenchmarkResults,
} from '../../../utils/season-data';
import type { TournamentData, TournamentEntrant, TournamentMatch } from '../../../utils/season-data';
import '../../../styles/game-list.css';
import '../../../styles/shared.css';

export function getStaticPaths() {
  return buildTournamentSeasonStaticPaths();
}

const seasonNum = parseRequiredSeasonParam(Astro.params.season);
const minBlunderVersion = loadBenchmarkResults().minBlunderVersion;

const { tournament, hasDraft, entrantsBySeed } = loadSeasonTournamentContext(seasonNum);

const games = loadSeasonGameEntries(seasonNum);

// Split tournament games from regular-season games
const tournamentGames = games.filter(g => g.tournament != null);

// Build entrants lookup for bracket rendering
// Standard single-elimination seeding order for 16 players
// Top half: seeds that feed into the left side of the bracket
const BRACKET_16_LEFT: [number, number][] = [
  [1, 16], [8, 9], [5, 12], [4, 13],
];
// Bottom half: seeds that feed into the right side of the bracket
const BRACKET_16_RIGHT: [number, number][] = [
  [6, 11], [3, 14], [7, 10], [2, 15],
];

const ROUND_NAMES: Record<number, string> = {
  1: 'Round of 16',
  2: 'Quarterfinals',
  3: 'Semifinals',
  4: 'Finals',
};

interface BracketRound {
  name: string;
  round: number;
  matches: TournamentMatch[];
}

interface TwoSidedBracket {
  leftRounds: BracketRound[];
  rightRounds: BracketRound[];
  finals: BracketRound;
  rounds: BracketRound[];
}

function createEmptyMatch(seedA: number | null, seedB: number | null): TournamentMatch {
  return {
    match: null,
    seed_a: seedA,
    seed_b: seedB,
    winner_seed: null,
    games: [],
  };
}

// Build two-sided bracket: { left: Round[], right: Round[], finals: Round }
function buildTwoSidedBracket(tournamentData: TournamentData): TwoSidedBracket | null {
  let rounds: BracketRound[];
  if (tournamentData.rounds.length > 0) {
    rounds = tournamentData.rounds.map((round) => ({
      name: round.name,
      round: round.round,
      matches: round.matches.map((match) => ({
        ...match,
        games: [...match.games],
      })),
    }));
  } else if (tournamentData.size === 16) {
    // Generate empty bracket from seeds
    const allR1 = [...BRACKET_16_LEFT, ...BRACKET_16_RIGHT];
    rounds = [
      {
        name: ROUND_NAMES[1],
        round: 1,
        matches: allR1.map(([seedA, seedB]) => createEmptyMatch(seedA, seedB)),
      },
    ];
    let matchCount = 4;
    for (let r = 2; r <= 4; r++) {
      rounds.push({
        name: ROUND_NAMES[r],
        round: r,
        matches: Array.from({ length: matchCount }, () => createEmptyMatch(null, null)),
      });
      matchCount = Math.max(1, matchCount / 2);
    }
  } else {
    return null;
  }

  // Propagate winners forward: in single elimination, consecutive match pairs
  // (2i, 2i+1) in round N feed into match i of round N+1.
  for (let r = 1; r < rounds.length; r++) {
    const prev = rounds[r - 1].matches;
    const curr = rounds[r].matches;
    for (let m = 0; m < curr.length; m++) {
      const feederA = prev[m * 2];
      const feederB = prev[m * 2 + 1];
      if (feederA?.winner_seed != null && curr[m].seed_a == null) {
        curr[m].seed_a = feederA.winner_seed;
      }
      if (feederB?.winner_seed != null && curr[m].seed_b == null) {
        curr[m].seed_b = feederB.winner_seed;
      }
    }
  }

  // Split each round's matches into left half and right half
  const leftRounds: BracketRound[] = [];
  const rightRounds: BracketRound[] = [];
  for (let i = 0; i < rounds.length - 1; i++) {
    const round = rounds[i];
    const half = Math.ceil(round.matches.length / 2);
    leftRounds.push({ ...round, matches: round.matches.slice(0, half) });
    rightRounds.push({ ...round, matches: round.matches.slice(half) });
  }

  return { leftRounds, rightRounds, finals: rounds[rounds.length - 1], rounds };
}
const bracket = buildTwoSidedBracket(tournament);
const linearBracket = bracket?.rounds ?? null;

function matchScore(match: TournamentMatch): { winsA: number; winsB: number } | null {
  const games = match.games;
  if (games.length === 0) return null;
  let winsA = 0;
  let winsB = 0;
  for (const g of games) {
    if (g.winner_seed === match.seed_a) winsA++;
    else if (g.winner_seed === match.seed_b) winsB++;
  }
  return { winsA, winsB };
}

function deckNameForSeed(seed: number): string | null {
  return getTournamentDeckName(tournament, seed);
}

interface MatchRenderData {
  ea: TournamentEntrant | null;
  eb: TournamentEntrant | null;
  isComplete: boolean;
  isTBD: boolean;
  score: { winsA: number; winsB: number } | null;
  matchUrl: string | null;
}

// Match rendering data used by all bracket sections
function matchRenderData(match: TournamentMatch, roundNum?: number): MatchRenderData {
  const ea = match.seed_a != null ? entrantsBySeed.get(match.seed_a) ?? null : null;
  const eb = match.seed_b != null ? entrantsBySeed.get(match.seed_b) ?? null : null;
  const isComplete = match.winner_seed != null;
  const isTBD = match.seed_a == null || match.seed_b == null;
  const score = matchScore(match);
  const rawGames = match.games;
  let matchUrl: string | null = null;
  if (isComplete && rawGames.length === 1) {
    matchUrl = `/games/${rawGames[0].game_id}`;
  } else if (isComplete && rawGames.length > 1 && roundNum != null && match.match != null) {
    matchUrl = `/season/${seasonNum}/match/r${roundNum}m${match.match}`;
  }
  return { ea, eb, isComplete, isTBD, score, matchUrl };
}

---

<Base title={`Season ${seasonNum} Championship Results`} wide={true}>
  <SeasonNav season={seasonNum} active="results" hasTournament={true} hasDraft={hasDraft} />

  <section class="tournament-section">
    <div class="tournament-header">
      <h2>Season {seasonNum} Championship</h2>
      <div class="tournament-meta">
        <span class="meta-chip">best of {tournament.best_of}</span>
        <span class="meta-chip">{tournament.elimination} elimination</span>
        <span class="meta-chip">{tournament.size} players</span>
        <span class="meta-chip">Jumpstart draft</span>
      </div>
      <p class="tournament-how"><a href="/scoring">How scoring and seeding work &rarr;</a></p>
    </div>

    {/* Bracket */}
    {bracket && (
      <div class="bracket-section bracket-horizontal">
        <h3 class="section-heading">Bracket</h3>
        <div class="bracket-scroll">
          <div class="bracket-two-sided" style={`--bracket-half-height: ${(tournament.size / 2) * 72}px`}>
            {/* Left half: R1 -> QF -> SF */}
            <div class="bracket-half bracket-half-left">
              {bracket.leftRounds.map((round, ri) => (
                <>
                  <div class="bracket-round">
                    <div class="round-label">{round.name}</div>
                    <div class="round-matches">
                      {round.matches.map((match) => {
                        const { ea, eb, isComplete, isTBD, score, matchUrl } = matchRenderData(match, round.round);
                        return (
                          <div class="bracket-match-wrap">
                            <a class:list={['bracket-match', { 'has-link': !!matchUrl, 'tbd': isTBD }]} href={matchUrl || undefined}>
                              <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                                {match.seed_a != null ? (
                                  <>
                                    <span class="bracket-seed-num">#{match.seed_a}</span>
                                    <span class="bracket-player-info">
                                      <span class="bracket-player-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                                      {deckNameForSeed(match.seed_a) && <span class="bracket-deck">{deckNameForSeed(match.seed_a)}</span>}
                                    </span>
                                    {score && <span class="bracket-wins">{score.winsA}</span>}
                                    <span class:list={['bracket-win-mark', { visible: isComplete && match.winner_seed === match.seed_a }]}>W</span>
                                  </>
                                ) : (
                                  <span class="bracket-player-name tbd-text">TBD</span>
                                )}
                              </div>
                              <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                                {match.seed_b != null ? (
                                  <>
                                    <span class="bracket-seed-num">#{match.seed_b}</span>
                                    <span class="bracket-player-info">
                                      <span class="bracket-player-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                                      {deckNameForSeed(match.seed_b) && <span class="bracket-deck">{deckNameForSeed(match.seed_b)}</span>}
                                    </span>
                                    {score && <span class="bracket-wins">{score.winsB}</span>}
                                    <span class:list={['bracket-win-mark', { visible: isComplete && match.winner_seed === match.seed_b }]}>W</span>
                                  </>
                                ) : (
                                  <span class="bracket-player-name tbd-text">TBD</span>
                                )}
                              </div>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                  {ri < bracket.leftRounds.length - 1 && (
                    <div class="bracket-conn-col">
                      {Array.from({ length: bracket.leftRounds[ri + 1].matches.length }).map(() => (
                        <div class="bracket-conn-item" />
                      ))}
                    </div>
                  )}
                </>
              ))}
            </div>

            {/* Center: Finals + Champion */}
            <div class="bracket-center">
              <div class="bracket-conn-col">
                <div class="bracket-conn-item" />
              </div>
              <div class="bracket-round bracket-finals">
                <div class="round-label">{bracket.finals.name}</div>
                <div class="round-matches">
                  {bracket.finals.matches.map((match) => {
                    const { ea, eb, isComplete, isTBD, score, matchUrl } = matchRenderData(match, bracket.finals.round);
                    return (
                      <div class="bracket-match-wrap">
                        <a class:list={['bracket-match', { 'has-link': !!matchUrl, 'tbd': isTBD }]} href={matchUrl || undefined}>
                          <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                            {match.seed_a != null ? (
                              <>
                                <span class="bracket-seed-num">#{match.seed_a}</span>
                                <span class="bracket-player-info">
                                  <span class="bracket-player-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                                  {deckNameForSeed(match.seed_a) && <span class="bracket-deck">{deckNameForSeed(match.seed_a)}</span>}
                                </span>
                                {score && <span class="bracket-wins">{score.winsA}</span>}
                                <span class:list={['bracket-win-mark', { visible: isComplete && match.winner_seed === match.seed_a }]}>W</span>
                              </>
                            ) : (
                              <span class="bracket-player-name tbd-text">TBD</span>
                            )}
                          </div>
                          <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                            {match.seed_b != null ? (
                              <>
                                <span class="bracket-seed-num">#{match.seed_b}</span>
                                <span class="bracket-player-info">
                                  <span class="bracket-player-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                                  {deckNameForSeed(match.seed_b) && <span class="bracket-deck">{deckNameForSeed(match.seed_b)}</span>}
                                </span>
                                {score && <span class="bracket-wins">{score.winsB}</span>}
                                <span class:list={['bracket-win-mark', { visible: isComplete && match.winner_seed === match.seed_b }]}>W</span>
                              </>
                            ) : (
                              <span class="bracket-player-name tbd-text">TBD</span>
                            )}
                          </div>
                        </a>
                      </div>
                    );
                  })}
                </div>
                {/* Champion */}
                {(() => {
                  const finalMatch = bracket.finals.matches[0];
                  const champion = finalMatch?.winner_seed != null ? entrantsBySeed.get(finalMatch.winner_seed) ?? null : null;
                  return champion ? (
                    <div class="champion-card">
                      <span class="champion-trophy">&#127942;</span>
                      <span class="champion-name">{champion.display_name}</span>
                    </div>
                  ) : null;
                })()}
              </div>
              <div class="bracket-conn-col bracket-conn-col-right">
                <div class="bracket-conn-item" />
              </div>
            </div>

            {/* Right half: SF <- QF <- R1 (reversed order in DOM) */}
            <div class="bracket-half bracket-half-right">
              {(() => {
                const reversed = [...bracket.rightRounds].reverse();
                return reversed.map((round, ri) => (
                <>
                  {ri > 0 && (
                    <div class="bracket-conn-col bracket-conn-col-right">
                      {Array.from({ length: reversed[ri - 1].matches.length }).map(() => (
                        <div class="bracket-conn-item" />
                      ))}
                    </div>
                  )}
                  <div class="bracket-round">
                    <div class="round-label">{round.name}</div>
                    <div class="round-matches">
                      {round.matches.map((match) => {
                        const { ea, eb, isComplete, isTBD, score, matchUrl } = matchRenderData(match, round.round);
                        return (
                          <div class="bracket-match-wrap">
                            <a class:list={['bracket-match', { 'has-link': !!matchUrl, 'tbd': isTBD }]} href={matchUrl || undefined}>
                              <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                                {match.seed_a != null ? (
                                  <>
                                    <span class="bracket-seed-num">#{match.seed_a}</span>
                                    <span class="bracket-player-info">
                                      <span class="bracket-player-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                                      {deckNameForSeed(match.seed_a) && <span class="bracket-deck">{deckNameForSeed(match.seed_a)}</span>}
                                    </span>
                                    {score && <span class="bracket-wins">{score.winsA}</span>}
                                    <span class:list={['bracket-win-mark', { visible: isComplete && match.winner_seed === match.seed_a }]}>W</span>
                                  </>
                                ) : (
                                  <span class="bracket-player-name tbd-text">TBD</span>
                                )}
                              </div>
                              <div class:list={['bracket-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                                {match.seed_b != null ? (
                                  <>
                                    <span class="bracket-seed-num">#{match.seed_b}</span>
                                    <span class="bracket-player-info">
                                      <span class="bracket-player-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                                      {deckNameForSeed(match.seed_b) && <span class="bracket-deck">{deckNameForSeed(match.seed_b)}</span>}
                                    </span>
                                    {score && <span class="bracket-wins">{score.winsB}</span>}
                                    <span class:list={['bracket-win-mark', { visible: isComplete && match.winner_seed === match.seed_b }]}>W</span>
                                  </>
                                ) : (
                                  <span class="bracket-player-name tbd-text">TBD</span>
                                )}
                              </div>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </>
                ));
              })()}
            </div>
          </div>
        </div>
      </div>
    )}

    {/* Linear bracket for smaller screens */}
    {linearBracket && (
      <div class="bracket-section bracket-linear">
        <h3 class="section-heading">Bracket</h3>
        {linearBracket.map((round, ri) => {
          const isFinals = ri === linearBracket.length - 1;
          return (
            <div class="lin-round">
              <div class="lin-round-header">
                <span class="lin-round-name">{round.name}</span>
                <span class="lin-round-line" />
              </div>
              <div class:list={['lin-matches', { 'lin-matches-few': round.matches.length >= 2 && round.matches.length <= 4, 'lin-matches-single': round.matches.length === 1 }]}>
                {round.matches.map((match) => {
                  const { ea, eb, isComplete, isTBD, score, matchUrl } = matchRenderData(match, round.round);
                  return (
                    <a class:list={['lin-match', { 'has-link': !!matchUrl, 'tbd': isTBD }]} href={matchUrl || undefined}>
                      <div class:list={['lin-slot', { winner: isComplete && match.winner_seed === match.seed_a }]}>
                        {match.seed_a != null ? (
                          <>
                            <span class="lin-seed">#{match.seed_a}</span>
                            <span class="lin-name">{ea?.display_name || `Seed ${match.seed_a}`}</span>
                            {score && <span class="lin-score">{score.winsA}</span>}
                            <span class:list={['lin-w', { visible: isComplete && match.winner_seed === match.seed_a }]}>W</span>
                          </>
                        ) : (
                          <span class="lin-name tbd-text">TBD</span>
                        )}
                      </div>
                      <div class:list={['lin-slot', { winner: isComplete && match.winner_seed === match.seed_b }]}>
                        {match.seed_b != null ? (
                          <>
                            <span class="lin-seed">#{match.seed_b}</span>
                            <span class="lin-name">{eb?.display_name || `Seed ${match.seed_b}`}</span>
                            {score && <span class="lin-score">{score.winsB}</span>}
                            <span class:list={['lin-w', { visible: isComplete && match.winner_seed === match.seed_b }]}>W</span>
                          </>
                        ) : (
                          <span class="lin-name tbd-text">TBD</span>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>
              {/* Champion after finals */}
              {isFinals && (() => {
                const finalMatch = round.matches[0];
                const champion = finalMatch?.winner_seed != null ? entrantsBySeed.get(finalMatch.winner_seed) ?? null : null;
                return champion ? (
                  <div class="champion-card lin-champion-card">
                    <span class="champion-trophy">&#127942;</span>
                    <span class="champion-name">{champion.display_name}</span>
                  </div>
                ) : null;
              })()}
            </div>
          );
        })}
      </div>
    )}
  </section>

  {/* Tournament Games */}
  {tournamentGames.length > 0 && (
    <section class="games-section">
      <h2>Tournament Games</h2>
      <div id="tournament-games-list">
        {tournamentGames.map((game) => (
          <GameListCard
            game={game}
            minBlunderVersion={minBlunderVersion}
            showSeasonBadge={false}
            showBlunderScores={false}
          />
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  /* --- Tournament Section --- */
  .tournament-section {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-default);
  }

  .tournament-header {
    margin-bottom: 2rem;
  }

  .tournament-header h2 {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .tournament-how {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .tournament-how a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .tournament-how a:hover {
    color: var(--accent-primary);
  }

  /* --- Bracket --- */
  .bracket-section {
    margin-bottom: 2rem;
  }

  .bracket-scroll {
    overflow: hidden;
    padding-bottom: 1rem;
    max-width: 100%;
  }

  .bracket-two-sided {
    display: flex;
    align-items: stretch;
    min-height: var(--bracket-half-height, 220px);
  }

  .bracket-half {
    display: flex;
    align-items: stretch;
    flex: 1;
  }

  .bracket-half-left {
    justify-content: flex-end;
  }

  .bracket-half-right {
    justify-content: flex-start;
  }

  .bracket-center {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  .bracket-round {
    flex-shrink: 0;
    min-width: 210px;
  }

  .bracket-finals {
    min-width: 230px;
  }

  .round-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 0 0.5rem 0.5rem;
    text-align: center;
  }

  .round-matches {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    height: calc(100% - 1.5rem);
  }

  .bracket-match-wrap {
    padding: 0 0.5rem;
    position: relative;
  }

  .bracket-match {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  a.bracket-match.has-link:hover {
    border-color: var(--accent-primary);
  }

  .bracket-slot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    font-size: 0.8rem;
  }

  .bracket-slot + .bracket-slot {
    border-top: 1px solid var(--border-default);
  }

  .bracket-slot.winner {
    background: rgba(168, 217, 165, 0.08);
  }

  .bracket-seed-num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-muted);
    min-width: 1.5rem;
  }

  .bracket-slot.winner .bracket-seed-num {
    color: var(--color-success);
  }

  .bracket-player-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .bracket-player-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bracket-deck {
    font-size: 0.6rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.2;
  }

  .bracket-match.tbd {
    opacity: 0.5;
  }

  .tbd-text {
    color: var(--text-muted);
    font-style: italic;
  }

  .bracket-wins {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-left: auto;
    flex-shrink: 0;
    min-width: 0.8rem;
    text-align: center;
  }

  .bracket-slot.winner .bracket-wins {
    color: var(--color-success);
  }

  .bracket-win-mark {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--bg-base);
    background: var(--color-success);
    padding: 0.05rem 0.25rem;
    border-radius: 2px;
    margin-left: 0.25rem;
    flex-shrink: 0;
    visibility: hidden;
  }

  .bracket-win-mark.visible {
    visibility: visible;
  }

  /* --- Bracket Connectors --- */
  .bracket-conn-col {
    display: flex;
    flex-direction: column;
    width: 2rem;
    flex-shrink: 0;
    padding-top: 1.5rem;
  }

  .bracket-conn-item {
    flex: 1;
    position: relative;
  }

  /* Top arm: border-top + border-right forming top bracket */
  .bracket-conn-item::before {
    content: '';
    position: absolute;
