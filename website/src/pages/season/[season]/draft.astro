---
import Base from '../../../layouts/Base.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import {
  hasDraft as seasonHasDraft,
  loadAvailableSeasons,
  loadTournament,
} from '../../../utils/season-data';

export function getStaticPaths() {
  return loadAvailableSeasons()
    .filter(s => seasonHasDraft(s))
    .map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

const tournament = loadTournament(seasonNum);
if (!tournament.draft) {
  throw new Error(`Tournament ${seasonNum} has no draft data`);
}
const draft = tournament.draft;
if (draft.history_version !== 2) {
  throw new Error(
    `Tournament ${seasonNum} has draft history v${draft.history_version ?? 1}; expected v2`
  );
}

const entrantsBySeed: Record<number, any> = {};
for (const e of tournament.entrants) {
  entrantsBySeed[e.seed] = e;
}

function cleanThemeName(name: string): string {
  return name.replace(/^J22 /, '');
}

function getAttempts(pick: any): any[] {
  if (!Array.isArray(pick.attempts) || pick.attempts.length === 0) {
    throw new Error(`Draft pick for seed ${pick.seed} is missing attempts`);
  }
  return pick.attempts;
}

function getAcceptedAttempt(pick: any): any {
  const accepted = getAttempts(pick).find((attempt: any) => attempt.accepted);
  if (!accepted) {
    throw new Error(`Draft pick for seed ${pick.seed} has no accepted attempt`);
  }
  return accepted;
}

function getPreviewSource(pick: any): string | null {
  const attempts = getAttempts(pick);
  const first = attempts[0];
  return first.thinking || first.response || getAcceptedAttempt(pick).response || null;
}

function renderAttemptResponse(attempt: any): string {
  return attempt.response ?? '(empty response)';
}
---

<Base title={`Season ${seasonNum} Championship Draft`} wide>
  <SeasonNav season={seasonNum} active="draft" hasTournament={true} hasDraft={true} />

  <div class="draft-page">
    <h2>Draft</h2>
    <div class="draft-stats-bar">
      <span>{draft.picks.length} picks</span>
      <span class="draft-stat-sep">&middot;</span>
      <span>{draft.pool.length} packs in pool</span>
      <span class="draft-stat-sep">&middot;</span>
      <span>${draft.total_cost_usd.toFixed(2)} total cost</span>
    </div>
    {[1, 2].map((roundNum: number) => {
      const roundPicks = draft.picks
        .map((p: any, idx: number) => ({ ...p, _idx: idx }))
        .filter((p: any) => p.round === roundNum);
      return (
        <div class={`draft-round draft-round-${roundNum}`}>
          <div class="draft-round-header">
            <span class="draft-round-label">Round {roundNum}</span>
            <span class="draft-round-count">{roundPicks.length} picks</span>
          </div>
          <div class="draft-round-picks">
            {roundPicks.map((pick: any) => {
              const ent = entrantsBySeed[pick.seed];
              const attempts = getAttempts(pick);
              const previewSrc = getPreviewSource(pick);
              const preview = previewSrc ? previewSrc.slice(0, 300).replace(/\*+/g, '') : null;
              const acceptedAttempt = getAcceptedAttempt(pick);
              return (
                <div class="dpick">
                  <button class="dpick-row" type="button" aria-expanded="false">
                    <span class="dpick-num">{pick._idx + 1}</span>
                    <span class="dpick-player">
                      <span class="dpick-seed">#{pick.seed}</span>
                      <span class="dpick-name">{ent?.display_name || `Seed ${pick.seed}`}</span>
                    </span>
                    <span class="dpick-chose">{cleanThemeName(pick.picked)}</span>
                    <span class="dpick-cost">${pick.cost_usd.toFixed(2)}</span>
                    <span class="dpick-chevron">&#9656;</span>
                  </button>
                  {preview && (
                    <div class="dpick-preview">{preview}</div>
                  )}
                  <div class="dpick-detail" hidden>
                    <div class="dpick-decision">
                      <div class="dpick-detail-label">Final Decision</div>
                      <div class="dpick-decision-text">{acceptedAttempt.response}</div>
                    </div>
                    <div class="dpick-attempts">
                      <div class="dpick-detail-label">Attempt History ({attempts.length})</div>
                      {attempts.map((attempt: any) => (
                        <details class="dpick-attempt" open={attempt.accepted}>
                          <summary class="dpick-attempt-summary">
                            Attempt {attempt.attempt} {attempt.accepted ? '· accepted' : '· retry'}
                          </summary>
                          {attempt.thinking && (
                            <div class="dpick-attempt-block">
                              <div class="dpick-detail-label">Logic</div>
                              <div class="dpick-logic-text">{attempt.thinking}</div>
                            </div>
                          )}
                          <div class="dpick-attempt-block">
                            <div class="dpick-detail-label">Decision</div>
                            <div class="dpick-decision-text">{renderAttemptResponse(attempt)}</div>
                          </div>
                          {!attempt.accepted && attempt.rejection_reason && (
                            <div class="dpick-attempt-block">
                              <div class="dpick-detail-label">Retry Prompt</div>
                              <div class="dpick-retry-text">{attempt.rejection_reason}</div>
                            </div>
                          )}
                        </details>
                      ))}
                    </div>
                    <div class="dpick-pool">
                      <div class="dpick-detail-label">Available ({pick.options.length} packs)</div>
                      <div class="dpick-pool-tags">
                        {pick.options.map((opt: string) => (
                          <span class:list={['dpick-tag', { 'dpick-tag-picked': opt === pick.picked }]}>
                            {cleanThemeName(opt)}
                          </span>
                        ))}
                      </div>
                    </div>
                    <div class="dpick-meta">
                      {attempts.length} attempts &middot;{' '}
                      {pick.usage.prompt_tokens.toLocaleString()} prompt &middot; {pick.usage.completion_tokens.toLocaleString()} completion tokens
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</Base>

<style>
  h2 {
    font-family: var(--font-heading);
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .draft-page {
    max-width: 1000px;
  }

  .draft-stats-bar {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .draft-stat-sep {
    color: var(--text-muted);
  }

  .draft-round {
    margin-bottom: 1.5rem;
  }

  .draft-round-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--border-default);
  }

  .draft-round-label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-secondary);
  }

  .draft-round-2 .draft-round-label {
    color: var(--accent-primary);
  }

  .draft-round-count {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .draft-round-picks {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dpick {
    border-left: 3px solid var(--accent-secondary);
    background: var(--bg-surface);
    border-radius: 0 4px 4px 0;
    overflow: hidden;
  }

  .draft-round-2 .dpick {
    border-left-color: var(--accent-primary);
  }

  .dpick-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.4rem 0.75rem;
    background: none;
    border: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s;
  }

  .dpick-row:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .dpick-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    min-width: 1.8rem;
    text-align: right;
    flex-shrink: 0;
  }

  .dpick-player {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    flex: 1;
  }

  .dpick-seed {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .dpick-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.85rem;
  }

  .dpick-chose {
    color: var(--accent-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .draft-round-2 .dpick-chose {
    color: var(--accent-primary);
  }

  .dpick-cost {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .dpick-chevron {
    color: var(--text-muted);
    font-size: 0.7rem;
    transition: transform 0.15s;
    flex-shrink: 0;
  }

  .dpick.open .dpick-chevron {
    transform: rotate(90deg);
  }

  .dpick-detail {
    padding: 0.5rem 0.75rem 0.75rem 2.8rem;
    border-top: 1px solid var(--border-subtle);
  }

  .dpick-detail-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .dpick-detail-label.clickable {
    cursor: pointer;
    user-select: none;
  }

  .dpick-preview {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
    padding: 0 0.75rem 0.4rem 2.8rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
  }

  .dpick-preview:hover {
    color: var(--text-secondary);
  }

  .dpick.open .dpick-preview {
    display: none;
  }

  .dpick-attempts,
  .dpick-decision {
    margin-bottom: 0.75rem;
  }

  .dpick-attempt {
    background: var(--bg-elevated);
    border-radius: 4px;
    padding: 0.5rem 0.6rem;
    margin-top: 0.4rem;
  }

  .dpick-attempt-summary {
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .dpick-attempt-block + .dpick-attempt-block {
    margin-top: 0.65rem;
  }

  .dpick-logic-text,
  .dpick-decision-text {
    font-size: 0.8rem;
    color: var(--text-primary);
    line-height: 1.4;
    white-space: pre-wrap;
  }

  .dpick-logic-text {
    margin-top: 0.25rem;
  }

  .dpick-retry-text {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
    white-space: pre-wrap;
  }

  .dpick-pool {
    margin-bottom: 0.5rem;
  }

  .dpick-pool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .dpick-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    background: var(--bg-elevated);
    color: var(--text-secondary);
  }

  .dpick-tag-picked {
    background: rgba(20, 184, 166, 0.15);
    color: var(--accent-secondary);
    font-weight: 600;
  }

  .draft-round-2 .dpick-tag-picked {
    background: rgba(var(--accent-primary-rgb), 0.15);
    color: var(--accent-primary);
  }

  .dpick-meta {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .dpick-player {
      min-width: 0;
      flex: 0 1 auto;
    }

    .dpick-cost {
      display: none;
    }

    .dpick-detail {
      padding-left: 1rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.dpick-row, .dpick-preview');
    if (!btn) return;
    var card = btn.closest('.dpick');
    var detail = card.querySelector('.dpick-detail');
    if (!detail) return;
    var isOpen = !detail.hidden;
    detail.hidden = isOpen;
    card.classList.toggle('open', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
