    {
      "severity": "moderate",
      "description": "Failed to attack with a 5/5 Ravenous Giant when the opponent had zero available blockers (all creatures were either summoning sick or tapped). This wastes 5 free damage and is especially costly since the Giant deals 1 damage to its controller every upkeep — not attacking means taking the damage without getting any offensive value.",
      "action_taken": "Timed out and did not declare any attackers, passing the combat phase.",
      "better_line": "Attack with Ravenous Giant for 5 unblockable damage, taking the opponent from 20 to 15.",
      "type": "blunder",
