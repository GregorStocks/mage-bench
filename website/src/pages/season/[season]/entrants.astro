---
import Base from '../../../layouts/Base.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import {
  hasTournament as seasonHasTournament,
  loadAvailableSeasons,
  loadPersonalities,
  parseDecklistCardEntry,
  loadTournament,
} from '../../../utils/season-data';
import '../../../styles/shared.css';

export function getStaticPaths() {
  return loadAvailableSeasons()
    .filter(s => seasonHasTournament(s))
    .map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

const tournament = loadTournament(seasonNum);
const personalities = loadPersonalities();

function cleanThemeName(name: string): string {
  return name.replace(/^J22 /, '');
}

const hasDraft = !!tournament.draft;
---

<Base title={`Season ${seasonNum} Championship Entrants`} wide>
  <SeasonNav season={seasonNum} active="entrants" hasTournament={true} hasDraft={hasDraft} />

  <div class="entrants-page">
    <h2>Entrants & Decklists</h2>
    <div class="tournament-meta">
      <span class="meta-chip">best of {tournament.best_of}</span>
      <span class="meta-chip">{tournament.elimination} elimination</span>
      <span class="meta-chip">{tournament.size} players</span>
      <span class="meta-chip">Jumpstart draft</span>
    </div>

    <div class="entrants-grid">
      {tournament.entrants.map((entrant) => {
        const p = personalities[entrant.personality];
        const deckInfo = tournament.draft?.decklists[String(entrant.seed)];
        const cardCount = deckInfo?.cards.reduce((sum, cardLine) => sum + parseDecklistCardEntry(cardLine).count, 0) ?? 0;
        return (
          <a href={`/season/${seasonNum}/player/${entrant.seed}`} class="entrant-card">
            <div class="entrant-seed">#{entrant.seed}</div>
            <div class="entrant-info">
              <div class="entrant-name">
                {entrant.display_name}
              </div>
              <div class="entrant-personality">
                <span class="personality-name">{entrant.personality}</span>
                {p?.prompt_suffix && (
                  <span class="personality-desc" title={p.prompt_suffix}>
                    {p.prompt_suffix.length > 60 ? p.prompt_suffix.slice(0, 60) + '...' : p.prompt_suffix}
                  </span>
                )}
              </div>
              <div class="entrant-stats">
                <span class="entrant-elo">Elo {entrant.combined_elo}</span>
                <span class="entrant-games">{entrant.games_played} games</span>
              </div>
              {deckInfo && (
                <div class="entrant-deck-summary">
                  {deckInfo.half_decks.map(cleanThemeName).join(' + ')}
                  <span class="deck-card-count">{cardCount} cards</span>
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .entrants-page {
    max-width: 52rem;
  }

  h2 {
    font-family: var(--font-heading);
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .tournament-meta {
    margin-bottom: 2rem;
  }

  .entrants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
  }

  .entrant-card {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    transition: border-color 0.2s;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .entrant-card:hover {
    border-color: var(--accent-secondary);
  }

  .entrant-seed {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent-secondary);
    min-width: 2rem;
    text-align: center;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }

  .entrant-info {
    min-width: 0;
  }

  .entrant-name {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entrant-personality {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 0.3rem;
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
  }

  .personality-name {
    color: var(--accent-primary);
    font-weight: 600;
    text-transform: capitalize;
    flex-shrink: 0;
  }

  .personality-desc {
    color: var(--text-muted);
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entrant-stats {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 0.2rem;
  }

  .entrant-elo {
    font-variant-numeric: tabular-nums;
  }

  .entrant-deck-summary {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-secondary);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.3rem;
  }

  .deck-card-count {
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .entrants-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .entrants-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
