---
import Base from '../../../layouts/Base.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import benchmarkData from '../../../data/benchmark-results.json';
import { loadAllGames } from '../../../utils/load-games';
import {
  hasDraft as seasonHasDraft,
  hasTournament as seasonHasTournament,
  loadAvailableSeasons,
} from '../../../utils/season-data';

const minBlunderVersion = (benchmarkData as any).minBlunderVersion ?? 11;

export function getStaticPaths() {
  return loadAvailableSeasons().map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

// Regular-season games for this season
const games = loadAllGames().filter(g => (g.season ?? 0) === seasonNum && !g.tournament);

// Check for tournament existence for SeasonNav props
const hasTournament = seasonHasTournament(seasonNum);
const hasDraft = seasonHasDraft(seasonNum);
---

<Base title={`Season ${seasonNum} - Regular Season Games`} wide>
  <SeasonNav season={seasonNum} active="games" hasTournament={hasTournament} hasDraft={hasDraft} />
  <div class="games-content">
    <div id="format-tabs" class="format-tabs"></div>
    <div id="model-tabs" class="model-tabs"></div>
    <div id="filter-bar" style="display:none"></div>
    <div id="games-list">
      {games.length > 0 && <p class="loading">Loading games...</p>}
    </div>
  </div>
</Base>

<link rel="stylesheet" href="/game-list.css" />

<style>
  .games-content {
    max-width: 52rem;
  }

  .loading {
    color: var(--text-secondary);
  }
</style>

<style is:global>
  .tournament-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.03em;
    background: rgba(20, 184, 166, 0.15);
    color: var(--accent-secondary);
  }
</style>

<script is:inline src="/game-list.js"></script>
<script is:inline define:vars={{ games, minBlunderVersion }}>
  GameList.init({
    games: games,
    minBlunderVersion: minBlunderVersion,
    showSeasonFilter: false,
    showSeasonBadge: false,
  });
</script>
