---
import InternalsDashboard from '../components/internals/InternalsDashboard.astro';
import Base from '../layouts/Base.astro';
import { loadGoldenTestScenarios } from '../utils/load-internals-dashboard-data';

const goldenScenarios = loadGoldenTestScenarios();
---

<Base title="Internals" wide>
  <InternalsDashboard
    blunderDataUrl="/internals/data/blunder.json"
    goldenScenarios={goldenScenarios}
    modelStatsDataUrl="/internals/data/model-stats.json"
    trendsDataUrl="/internals/data/trends.json"
  />
</Base>
