  "annotations": [
    {
      "decision_index": 30,
      "player": "Qwen3L Memoir",
      "type": "blunder",
      "severity": "moderate",
      "description": "Casting Rousing Read with no creatures on own battlefield means enchanting the opponent's Benevolent Hydra, giving it +1/+1 and flying while only getting draw 2 discard 1. This buffs the opponent's creature and gives it evasion for no good reason when there's a perfectly good creature to cast instead.",
      "action_taken": "Cast Rousing Read, which must target the opponent's Benevolent Hydra since there are no friendly creatures",
      "better_line": "Cast Sylvan Brushstrider to develop the board with a 3/2 body and gain 2 life, then enchant it with Rousing Read next turn when you have 4 mana available",
      "snapshot_index": 41,
    },
    {
      "decision_index": 63,
      "player": "Qwen3L Memoir",
      "type": "blunder",
      "severity": "minor",
      "description": "Passed on casting Irresistible Prey, a 1-mana cantrip, with an untapped Forest available and nothing else to spend mana on. The card draw would help find the land drops needed to cast Somberwald Stag (5 mana), Tome Anima (4 mana), or Trufflesnout (3 mana). While the 'must be blocked' text is mostly irrelevant with only a sick creature, the card draw is pure upside.",
      "action_taken": "Passed priority, wasting 1 green mana and missing a card draw.",
      "better_line": "Cast Irresistible Prey targeting Sylvan Brushstrider (or any legal target) to draw a card and dig toward land drops and playable spells.",
      "snapshot_index": 83,
    },
    {
      "decision_index": 65,
      "player": "Qwen3L Memoir",
      "type": "blunder",
      "severity": "minor",
      "description": "Passed on casting Irresistible Prey in postcombat main when it would draw a card for free. While the 'must be blocked' clause is wasted postcombat, the card draw is pure value. There's no other use for the one untapped Forest - no instants or activated abilities in hand that could use the mana during the opponent's turn.",
      "action_taken": "Passed priority, ending the turn with one unused green mana and no way to use it.",
      "better_line": "Cast Irresistible Prey targeting Sylvan Brushstrider to draw a card. The 'must be blocked' text is irrelevant postcombat, but the cantrip effect is free value with no opportunity cost.",
      "snapshot_index": 91,
    },
    {
      "decision_index": 70,
      "player": "MstMed Rivals",
      "type": "blunder",
      "severity": "questionable",
      "description": "Casting Impending Doom instead of Goblin Psychopath. Impending Doom on a creature creates 2-for-1 vulnerability - if the enchanted creature is removed, you lose both the aura and take 3 damage to yourself. The opponent has 5 cards in hand and could easily have removal. Goblin Psychopath provides an independent 5/5 body that doesn't risk card disadvantage.",
      "action_taken": "Cast Impending Doom for 3 mana, likely targeting Benevolent Hydra to make it a 6/6 forced attacker",
