  "annotations": [
    {
      "severity": "minor",
      "description": "Single-blocking Cathar's Companion 4/2 with a 1/4 Eidolon of Rhetoric results in the Eidolon dying. By double-blocking the 4/2 with both Amoeboid Changeling and the sick Eidolon, the opponent would be forced to assign at least 1 damage to each blocker, meaning the Eidolon (4 toughness) would survive taking only 3 damage. This preserves both Eidolons, which is especially valuable since Eidolon of Rhetoric restricts the opponent to one spell per turn when they have 4 cards in hand.",
      "action_taken": "Blocked Cathar's Companion with one Eidolon (which dies) and Mesa Unicorn with the other Eidolon (which survives), leaving Amoeboid Changeling unassigned.",
      "better_line": "Double-block Cathar's Companion 4/2 with Amoeboid Changeling and the sick Eidolon of Rhetoric, and block Mesa Unicorn with the other Eidolon. Amoeboid dies but both Eidolons survive, preserving the one-spell-per-turn lock.",
      "type": "blunder",
      "snapshot_index": 253,
      "player": "G31FL Folksy",
      "decision_index": 234,
    }
  ],
  "blunder_script_version": 32,
}