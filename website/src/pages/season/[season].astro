    color: var(--text-primary);
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .tournament-games-section {
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .entrants-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .entrants-grid {
      grid-template-columns: 1fr;
    }

