  "harness_epoch": 4,
  "youtube_url": "https://youtu.be/zMnlIa2HoVg",
  "annotations": [
    {
      "severity": "moderate",
      "description": "With a hand containing Chalice of the Void, Eldrazi Temples, Eye of Ugin, and Thought-Knot Seer, GLM47 chose to be on the draw. This hand is extremely powerful on the play — Turn 1 Chalice of the Void for 1 (off Eldrazi Temple or Eye of Ugin + Temple) shuts down many Legacy decks before they can act. Being on the play allows deploying Chalice before the opponent can cast their Brainstorms, Ponders, Swords to Plowshares, Dark Rituals, etc. Eldrazi Stompy is a deck that heavily leverages being on the play to land lock pieces before opponents can respond.",
      "action_taken": "Chose Gem3P Stoic to go first (putting themselves on the draw)",
      "better_line": "Choose to go first (GLM47 Timmy) to deploy Turn 1 Chalice of the Void on 1 before the opponent can play any spells, which is the primary game plan of Eldrazi Stompy in Legacy.",
      "type": "blunder",
      "snapshot_index": 1,
      "player": "GLM47 Timmy",
      "decision_index": 0,
    }
  ],
