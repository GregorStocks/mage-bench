---
import Base from '../../layouts/Base.astro';
import GameListView from '../../components/GameListView.astro';
import benchmarkData from '../../data/benchmark-results.json';
import { loadAllGames } from '../../utils/load-games';
const minBlunderVersion = (benchmarkData as any).minBlunderVersion ?? 11;

const games = loadAllGames().filter(g => !g.tournament);
---

<Base title="Games">
  <h1>Games</h1>
  <p class="subtitle">Replay past mage-bench games.</p>
  <GameListView
    games={games}
    minBlunderVersion={minBlunderVersion}
    showSeasonFilter={true}
    showSeasonBadge={true}
  />
</Base>

<style>
  h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
</style>
