<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.0.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.0.0 https://maven.apache.org/xsd/build-cache-config-1.0.0.xsd">
    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <validateXml>false</validateXml>
        <attachedOutputs>
            <dirNames>
                <dirName>classes</dirName>
            </dirNames>
        </attachedOutputs>
    </configuration>
    <input>
        <global>
            <glob>{*.java,pom.xml}</glob>
            <includes>
                <include>src/</include>
            </includes>
            <excludes>
                <exclude>target/</exclude>
            </excludes>
        </global>
    </input>
    <executionControl>
        <!-- On a cache hit the install goal is normally skipped, leaving
             whatever jar was already in the local repository. Tests invoked
             with `mvn test -pl <modules>` (no -am) resolve dependencies from
             the local repository, so a stale jar there (e.g. restored from
             CI's ~/.m2 cache saved before a signature change) breaks
             compilation against current sources. Always install the
             (restored) artifacts to keep the local repository fresh. -->
        <runAlways>
            <goalsLists>
                <goalsList artifactId="maven-install-plugin">
                    <goals>
                        <goal>install</goal>
                    </goals>
                </goalsList>
            </goalsLists>
        </runAlways>
    </executionControl>
</cache>
