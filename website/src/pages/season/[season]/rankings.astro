---
import Base from '../../../layouts/Base.astro';
import SeasonNav from '../../../components/SeasonNav.astro';
import {
  hasTournament as seasonHasTournament,
  loadAvailableSeasons,
  loadSeasonBenchmark,
  loadTournament,
} from '../../../utils/season-data';

export function getStaticPaths() {
  return loadAvailableSeasons().map(s => ({ params: { season: String(s) } }));
}

const { season } = Astro.params;
const seasonNum = parseInt(season!, 10);

// Load season-specific benchmark data
const seasonBenchmark = loadSeasonBenchmark(seasonNum);

const FORMAT_LABELS: Record<string, string> = {
  jumpstart: 'Jumpstart',
  standard: 'Standard',
  modern: 'Modern',
  legacy: 'Legacy',
  commander: 'Commander (Exhibition)',
  combined: 'Combined',
};

const FORMAT_ORDER = ['combined', 'jumpstart', 'standard', 'modern', 'legacy', 'commander'];

// Build per-format data from the formats key (or fall back to single leaderboard)
const formats: Record<string, any> = seasonBenchmark.formats ?? {
  combined: { totalGames: seasonBenchmark.totalGames, models: seasonBenchmark.models },
};

// Only show tabs for formats that have games (always show combined)
const activeFormats = FORMAT_ORDER.filter(
  (f) => f === 'combined' || (formats[f] && formats[f].totalGames > 0)
);

const hasData = (seasonBenchmark.models?.length ?? 0) > 0 || Object.keys(formats).length > 1;

// Check if this season has tournament data
const tournament = seasonHasTournament(seasonNum) ? loadTournament(seasonNum) : null;
const hasTournament = tournament != null;
const hasDraft = !!tournament?.draft;
const tournamentSize = tournament?.size ?? 0;
---

<Base title={`Season ${seasonNum} Regular Season Rankings`} wide>
  <SeasonNav season={seasonNum} active="rankings" hasTournament={hasTournament} hasDraft={hasDraft} />

  {hasData ? (
    <p class="subtitle" id="subtitle">
      Model ratings based on {seasonBenchmark.totalGames.toLocaleString()} rated games.
      Last updated: <time>{new Date(seasonBenchmark.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>.
    </p>

    <div class="format-tabs" id="format-tabs" style={activeFormats.length <= 1 ? 'display:none' : ''}>
      {activeFormats.map((fmt: string) => (
        <button class:list={['format-tab', { active: fmt === 'combined' }]} data-format={fmt}>
          {FORMAT_LABELS[fmt] || fmt}
          <span class="tab-count">({(formats[fmt]?.totalGames ?? 0)})</span>
        </button>
      ))}
      <label class="inactive-toggle" title="Inactive models are no longer in the active evaluation pool. Reasons: retired (superseded or bottom-tier), buggy (tool-use issues), or expensive (too costly for regular rotation). Historical ratings are preserved.">
        <input type="checkbox" id="show-inactive" />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        Show inactive models
      </label>
    </div>

    <p class="scoring-link"><a href="/scoring">How scoring works</a></p>

    <div class="table-wrap">
      <table id="leaderboard-table" class="format-combined">
        <thead>
          <tr>
            <th class="rank-col">#</th>
            <th data-sort="modelName" data-type="string">Model Name</th>
            <th data-sort="provider" data-type="string">Provider</th>
            <th data-sort="rating" data-type="number" data-col="rating" class="sorted desc">Rating <span class="sort-arrow">&#9660;</span></th>
            <th data-sort="blunderScore" data-type="number">Blunder Index</th>
            <th data-sort="gamesPlayed" data-type="number">Games Played</th>
            <th data-sort="winRate" data-type="number" class="col-winrate">Win Rate</th>
            <th data-sort="avgApiCost" data-type="number">Avg Cost</th>
          </tr>
        </thead>
        {activeFormats.map((fmt: string) => {
          const isExhibition = !!formats[fmt]?.exhibition;
          return (
          <tbody data-format={fmt} data-exhibition={isExhibition ? 'true' : undefined} style={fmt !== 'combined' ? 'display: none;' : ''}>
            {(formats[fmt]?.models || []).map((m: any, i: number) => (
              <tr
                data-model-id={m.modelId}
                data-reasoning-effort={m.reasoningEffort || ''}
                data-provider={m.provider}
                data-rating={m.rating ?? ''}
                data-games-played={m.gamesPlayed}
                data-win-rate={m.winRate}
                data-blunder-score={m.blunderScore}
                data-avg-api-cost={m.avgApiCost}
                data-inactive={m.inactive || ''}
                class:list={[{ inactive: m.inactive }]}
              >
                <td class="rank-cell">{i + 1}</td>
                <td class="model-name">{m.modelName}{m.inactive && <span class="inactive-label"> ({m.inactive})</span>}</td>
                <td>{m.provider}</td>
                <td class="num" data-col="rating">{m.rating != null ? m.rating : '\u2014'}</td>
                <td class="num"><span class={`blunder-val ${m.blunderScore < 0.3 ? 'blunder-good' : m.blunderScore < 0.8 ? 'blunder-ok' : 'blunder-bad'}`}>{m.blunderScore.toFixed(2)}</span></td>
                <td class="num"><a class="games-link" href={`/season/${seasonNum}/games?model=${encodeURIComponent(m.modelId)}${m.reasoningEffort ? '&effort=' + encodeURIComponent(m.reasoningEffort) : ''}`}>{m.gamesPlayed}</a></td>
                <td class="num col-winrate">{(m.winRate * 100).toFixed(1)}%</td>
                <td class="num">${m.avgApiCost.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
          );
        })}
      </table>
    </div>

    <p class="no-results" id="no-results" style="display: none;">
      No models match your filters.
    </p>
  ) : (
    <p class="empty-state">No games have been played yet. Check back soon!</p>
  )}
</Base>

<script define:vars={{ seasonNum, tournamentSize }}>
  window.__seasonNum = seasonNum;
  window.__tournamentSize = tournamentSize;
</script>

<script>
  const seasonNum = (window as any).__seasonNum;
  const tournamentSize: number = (window as any).__tournamentSize || 0;
  const table = document.getElementById('leaderboard-table') as HTMLTableElement | null;
  if (!table) {
    // No data yet, nothing to make interactive
  } else {
  const headers = table.querySelectorAll('th[data-sort]');
  const showInactiveCheckbox = document.getElementById('show-inactive') as HTMLInputElement;
  const noResults = document.getElementById('no-results')!;
  const formatTabs = document.getElementById('format-tabs');

  let activeFormat = 'combined';

  function getActiveTbody(): HTMLTableSectionElement {
    return table!.querySelector(`tbody[data-format="${activeFormat}"]`) as HTMLTableSectionElement;
  }

  function updateGamesLinks() {
    table!.querySelectorAll('tr[data-model-id]').forEach((row) => {
      const el = row as HTMLElement;
      const modelId = el.dataset.modelId!;
      const effort = el.dataset.reasoningEffort;
      const link = el.querySelector('a.games-link') as HTMLAnchorElement | null;
      if (!link) return;
      const params = new URLSearchParams({ model: modelId });
      if (effort) params.set('effort', effort);
      if (activeFormat !== 'combined') params.set('format', activeFormat);
      link.href = `/season/${seasonNum}/games?` + params.toString();
    });
  }

  function syncFiltersToUrl() {
    const url = new URL(window.location.href);
    if (activeFormat !== 'combined') url.searchParams.set('format', activeFormat);
    else url.searchParams.delete('format');
    if (showInactiveCheckbox.checked) url.searchParams.set('inactive', '1');
    else url.searchParams.delete('inactive');
    history.replaceState(null, '', url.toString());
  }

  function switchFormat(fmt: string) {
    if (fmt === activeFormat) return;

    // Hide all tbodies, show selected
    table!.querySelectorAll('tbody[data-format]').forEach((tb) => {
      (tb as HTMLElement).style.display = 'none';
    });
    const newTbody = table!.querySelector(`tbody[data-format="${fmt}"]`) as HTMLElement;
    if (newTbody) newTbody.style.display = '';

    // Update active tab styling
    if (formatTabs) {
      formatTabs.querySelectorAll('.format-tab').forEach((t) => t.classList.remove('active'));
      const btn = formatTabs.querySelector(`.format-tab[data-format="${fmt}"]`);
      if (btn) btn.classList.add('active');
    }

    activeFormat = fmt;
    table!.classList.toggle('format-combined', fmt === 'combined');

    // Hide rating column for exhibition formats
    const isExhibition = newTbody?.dataset.exhibition === 'true';
    table!.classList.toggle('hide-rating-col', isExhibition);

    // If sorted by rating and switching to exhibition, switch to winRate
    if (isExhibition) {
      const ratingTh = table!.querySelector('th[data-sort="rating"]');
      if (ratingTh?.classList.contains('sorted')) {
        const winRateTh = table!.querySelector('th[data-sort="winRate"]') as HTMLElement;
        if (winRateTh) winRateTh.click();
      }
    }

    updateGamesLinks();
    applyFilters();
    syncFiltersToUrl();
  }

  // Format tab switching
  if (formatTabs) {
    formatTabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.format-tab') as HTMLElement | null;
      if (!btn) return;
      switchFormat(btn.dataset.format!);
    });
  }

  function sortTable(column: string, type: string, ascending: boolean) {
    const tbody = getActiveTbody();
    if (!tbody) return;
    const rows = Array.from(tbody.querySelectorAll('tr:not(.cutoff-row)'));

    rows.sort((a, b) => {
      const elA = a as HTMLElement;
      const elB = b as HTMLElement;
      let valA: string | number;
      let valB: string | number;

      if (type === 'number') {
        valA = parseFloat(elA.dataset[column] ?? '0');
        valB = parseFloat(elB.dataset[column] ?? '0');
      } else {
        valA = (elA.dataset[column] ?? '').toLowerCase();
        valB = (elB.dataset[column] ?? '').toLowerCase();
      }

      if (valA < valB) return ascending ? -1 : 1;
      if (valA > valB) return ascending ? 1 : -1;
      return 0;
    });

    rows.forEach(row => tbody.appendChild(row));
  }

  headers.forEach(th => {
    th.addEventListener('click', () => {
      const el = th as HTMLElement;
      const column = el.dataset.sort!;
      const type = el.dataset.type!;

      const wasSorted = th.classList.contains('sorted');
      const wasAsc = th.classList.contains('asc');
      const ascending = wasSorted ? !wasAsc : (type === 'string');

      headers.forEach(h => {
        h.classList.remove('sorted', 'asc', 'desc');
        const arrow = h.querySelector('.sort-arrow');
        if (arrow) arrow.textContent = '';
      });

      th.classList.add('sorted', ascending ? 'asc' : 'desc');
      let arrow = th.querySelector('.sort-arrow');
      if (!arrow) {
        arrow = document.createElement('span');
        arrow.className = 'sort-arrow';
        th.appendChild(arrow);
      }
      arrow.textContent = ascending ? '\u25B2' : '\u25BC';

      sortTable(column, type, ascending);
      updateRanks();
    });
  });

  function applyFilters() {
    const showInactive = showInactiveCheckbox.checked;
    const tbody = getActiveTbody();
    if (!tbody) return;
    const rows = tbody.querySelectorAll('tr:not(.cutoff-row)');
    let visibleCount = 0;

    rows.forEach(row => {
      const el = row as HTMLElement;
      const visible = showInactive || !el.dataset.inactive;

      el.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    noResults.style.display = visibleCount === 0 ? '' : 'none';
    updateRanks();
  }

  function updateRanks() {
    const tbody = getActiveTbody();
    if (!tbody) return;
    let rank = 1;
    const showCutoff = tournamentSize > 0 && activeFormat === 'combined';

    // Remove any existing cutoff row
    tbody.querySelector('.cutoff-row')?.remove();

    let cutoffAfter: HTMLElement | null = null;
    tbody.querySelectorAll('tr').forEach(row => {
      const el = row as HTMLElement;
      const rankCell = el.querySelector('.rank-cell');
      if (!rankCell) return;
      if (el.style.display === 'none') {
        rankCell.textContent = '';
        delete el.dataset.rank;
        el.classList.remove('stripe');
      } else {
        const r = rank++;
        rankCell.textContent = String(r);
        el.dataset.rank = String(r);
        el.classList.toggle('stripe', r % 2 === 0);
        if (showCutoff && r === tournamentSize) {
          cutoffAfter = el;
        }
      }
    });

    if (cutoffAfter) {
      const cutoffRow = document.createElement('tr');
      cutoffRow.className = 'cutoff-row';
      cutoffRow.innerHTML = '<td colspan="8"><div class="cutoff-inner"><span class="cutoff-line"></span><span class="cutoff-label">Top 16 — Championship Qualified</span><span class="cutoff-line"></span></div></td>';
      (cutoffAfter as HTMLElement).after(cutoffRow);
    }
  }

  showInactiveCheckbox.addEventListener('change', () => {
    applyFilters();
    syncFiltersToUrl();
  });
  updateGamesLinks();
  applyFilters();

  // On page load, apply format and inactive params
  {
    const params = new URLSearchParams(window.location.search);
    const formatParam = params.get('format');
    if (formatParam && table!.querySelector(`tbody[data-format="${formatParam}"]`)) {
      switchFormat(formatParam);
    }
    if (params.get('inactive') === '1') {
      showInactiveCheckbox.checked = true;
      applyFilters();
    }
  }

  }
</script>

<style is:global>
  .subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .subtitle time {
    color: var(--text-primary);
  }

  .format-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .format-tab {
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 20px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .format-tab:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .format-tab.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #fff;
    font-weight: 700;
  }

  .format-tab.active[data-format="standard"] {
    background: var(--format-standard);
    border-color: var(--format-standard);
  }

  .format-tab.active[data-format="modern"] {
    background: var(--format-modern);
    border-color: var(--format-modern);
  }

  .format-tab.active[data-format="legacy"] {
    background: var(--format-legacy);
    border-color: var(--format-legacy);
  }

  .format-tab.active[data-format="commander"] {
    background: var(--format-commander);
    border-color: var(--format-commander);
  }

  .format-tab.active[data-format="combined"] {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  .tab-count {
    font-size: 0.75rem;
    opacity: 0.7;
    margin-left: 0.2rem;
  }

  .scoring-link {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .scoring-link a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .scoring-link a:hover {
    color: var(--accent-primary);
  }

  .inactive-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    margin-left: auto;
    border-bottom: 1px dotted var(--text-secondary);
    padding-bottom: 1px;
  }

  .inactive-toggle input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-track {
    position: relative;
    display: inline-block;
    width: 32px;
    height: 18px;
    background: var(--border-default);
    border-radius: 9px;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background: var(--text-secondary);
    border-radius: 50%;
    transition: transform 0.2s, background 0.2s;
  }

  .inactive-toggle input:checked + .toggle-track {
    background: var(--accent-primary);
  }

  .inactive-toggle input:checked + .toggle-track .toggle-thumb {
    transform: translateX(14px);
    background: #fff;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid var(--border-default);
    color: var(--text-secondary);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  th:hover {
    color: var(--accent-primary);
  }

  th.sorted {
    color: var(--accent-primary);
  }

  .sort-arrow {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.7rem;
    vertical-align: middle;
  }

  td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .rank-col {
    cursor: default;
    width: 2rem;
    text-align: center;
  }

  .rank-cell {
    text-align: center;
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .model-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .games-link {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .games-link:hover {
    text-decoration: underline;
  }

  .blunder-good {
    color: var(--color-success);
  }

  .blunder-ok {
    color: var(--color-warning);
  }

  .blunder-bad {
    color: var(--accent-primary);
  }

  th[data-sort="rating"],
  th[data-sort="gamesPlayed"],
  th[data-sort="winRate"],
  th[data-sort="blunderScore"],
  th[data-sort="avgApiCost"] {
    text-align: right;
  }

  table.hide-rating-col [data-col="rating"] {
    display: none;
  }

  /* Medal treatment for top 3 */
  tbody tr[data-rank="1"] {
    background: linear-gradient(to right, rgba(255, 215, 0, 0.08), transparent 50%);
    box-shadow: inset 3px 0 0 #ffd700;
  }

  tbody tr[data-rank="1"] .rank-cell { color: #ffd700; }

  tbody tr[data-rank="2"] {
    background: linear-gradient(to right, rgba(192, 192, 192, 0.06), transparent 50%);
    box-shadow: inset 3px 0 0 #c0c0c0;
  }

  tbody tr[data-rank="2"] .rank-cell { color: #c0c0c0; }

  tbody tr[data-rank="3"] {
    background: linear-gradient(to right, rgba(205, 127, 50, 0.06), transparent 50%);
    box-shadow: inset 3px 0 0 #cd7f32;
  }

  tbody tr[data-rank="3"] .rank-cell { color: #cd7f32; }

  /* Championship cutoff divider */
  .cutoff-row td {
    padding: 0 !important;
    border-bottom: none !important;
    background: none !important;
  }

  .cutoff-row:hover {
    background: none !important;
    box-shadow: none !important;
  }

  .cutoff-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  .cutoff-line {
    flex: 1;
    height: 1px;
    background: var(--accent-primary);
    opacity: 0.4;
  }

  .cutoff-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  tbody tr {
    transition: background 0.15s, box-shadow 0.15s;
  }

  tbody tr.stripe:not([data-rank="1"]):not([data-rank="2"]):not([data-rank="3"]) {
    background: rgba(22, 33, 62, 0.3);
  }

  tbody tr:hover {
    background: rgba(var(--accent-primary-rgb), 0.12);
    box-shadow: inset 3px 0 0 var(--accent-primary);
  }

  tbody tr.inactive {
    font-style: italic;
  }

  .inactive-label {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .no-results {
    color: var(--text-secondary);
    font-style: italic;
    text-align: center;
    padding: 2rem 0;
  }

  .empty-state {
    color: var(--text-secondary);
    text-align: center;
    padding: 4rem 0;
    font-size: 1.1rem;
  }

  @media (max-width: 600px) {
    th, td {
      padding: 0.5rem;
      font-size: 0.8rem;
    }

    .format-tabs {
      gap: 0.3rem;
    }

    .format-tab {
      font-size: 0.75rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>
