  "card_data": {
    "Abhorrent Oculus": {
      "mana_cost": "{2}{U}",
      "type_line": "Creature — Eye",
      "oracle_text": "As an additional cost to cast this spell, exile six cards from your graveyard.\n\
Flying\n\
