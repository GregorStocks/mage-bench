---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugifyTag } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={post.data.title}>
  <article class="blog-post">
    <header>
      <a href="/blog" class="back-link">&larr; All posts</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span class="author">by {post.data.author}</span>
        {post.data.updatedDate && (
          <span class="updated">
            (updated {formatDate(post.data.updatedDate)})
          </span>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map(tag => (
            <a href={`/blog/tags/${slugifyTag(tag)}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
</Base>

<style>
  .blog-post {
    max-width: 40rem;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-body);
    margin-bottom: 2.5rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  h1 {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-family: var(--font-body);
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .updated {
    font-style: italic;
    color: var(--text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-default);
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-body);
    padding: 0.2rem 0.6rem;
    background: rgba(233, 69, 96, 0.08);
    border: 1px solid rgba(233, 69, 96, 0.2);
    border-radius: 3px;
    color: var(--accent-primary);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.2s, border-color 0.2s;
  }

  .tag:hover {
    background: rgba(233, 69, 96, 0.15);
    border-color: rgba(233, 69, 96, 0.4);
  }

  /* ── Prose content ── */

  .content {
    font-family: var(--font-prose);
    font-size: 1.2rem;
    line-height: 1.85;
    color: #d0d0d6;
  }

  .content :global(h2) {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-default);
  }

  .content :global(h3) {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .content :global(p) {
    margin-bottom: 1.35rem;
    color: #d0d0d6;
  }

  .content :global(a) {
    color: var(--accent-primary);
    text-decoration-color: rgba(233, 69, 96, 0.3);
    text-underline-offset: 0.15em;
    transition: text-decoration-color 0.2s;
  }

  .content :global(a:hover) {
    text-decoration-color: var(--accent-primary);
  }

  .content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .content :global(em) {
    font-style: italic;
  }

  .content :global(code) {
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    font-size: 0.78em;
    color: #e8c4a0;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .content :global(pre) {
    background: var(--bg-deep);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent-primary);
    border-radius: 0 6px 6px 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    border: none;
    color: #c8c8d0;
    font-size: 1em;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--accent-primary);
    padding: 0.75rem 1.25rem;
    margin: 1.75rem 0;
    background: rgba(233, 69, 96, 0.04);
    border-radius: 0 6px 6px 0;
    color: #b8b8c0;
    font-style: italic;
  }

  .content :global(blockquote p) {
    color: #b8b8c0;
    margin-bottom: 0.5rem;
  }

  .content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
    color: #d0d0d6;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(li::marker) {
    color: var(--accent-primary);
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 6px;
    margin: 1.5rem 0;
  }

  .content :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border-default) 20%, var(--border-default) 80%, transparent);
    margin: 3rem 0;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 1.75rem;
    }

    .content {
      font-size: 1.1rem;
    }
  }
</style>
