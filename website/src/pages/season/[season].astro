  .tbd-text {
    color: var(--text-muted);
    font-style: italic;
  }

  .bracket-win-mark {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--bg-base);
    background: var(--color-success);
    padding: 0.05rem 0.25rem;
    border-radius: 2px;
    margin-left: auto;
    flex-shrink: 0;
  }

  /* --- Bracket Connectors --- */
  .bracket-conn-col {
    display: flex;
    flex-direction: column;
    width: 2rem;
    flex-shrink: 0;
    padding-top: 1.5rem;
  }

  .bracket-conn-item {
    flex: 1;
    position: relative;
  }

  /* Top arm: border-top + border-right forming top bracket */
  .bracket-conn-item::before {
    content: '';
    position: absolute;
    top: 25%;
    bottom: 50%;
    left: 0;
    right: 50%;
    border-top: 2px solid var(--border-default);
    border-right: 2px solid var(--border-default);
    border-top-right-radius: 3px;
  }

  /* Bottom arm: border-bottom + border-right forming bottom bracket */
  .bracket-conn-item::after {
    content: '';
    position: absolute;
    top: 50%;
    bottom: 25%;
    left: 0;
    right: 50%;
    border-bottom: 2px solid var(--border-default);
    border-right: 2px solid var(--border-default);
    border-bottom-right-radius: 3px;
  }

  /* Horizontal line going right from junction */
  .bracket-conn-item {
    background: linear-gradient(var(--border-default), var(--border-default)) right center / 50% 2px no-repeat;
  }

  /* Mirrored connectors for right side */
  .bracket-conn-col-right .bracket-conn-item::before {
    left: 50%;
    right: 0;
    border-top: 2px solid var(--border-default);
    border-left: 2px solid var(--border-default);
    border-right: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 0;
  }

  .bracket-conn-col-right .bracket-conn-item::after {
    left: 50%;
    right: 0;
    border-bottom: 2px solid var(--border-default);
    border-left: 2px solid var(--border-default);
    border-right: none;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 0;
  }

  .bracket-conn-col-right .bracket-conn-item {
    background: linear-gradient(var(--border-default), var(--border-default)) left center / 50% 2px no-repeat;
  }

  .bracket-champion .round-matches {
    justify-content: center;
  }

